#!/usr/bin/env python3
"""
aim — agent instant messaging.

File-first, cross-vendor, cross-session. The transport is the filesystem;
the protocol is this CLI. Nothing here depends on any vendor's internals.

The defining property: the barrier is ENFORCED BY THE TOOL, not by etiquette.
An agent that wants to peek during SEALED_DIVERGENT is refused by `aim`, and the
refusal is written to the ledger. Good behaviour should not be a matter of good
faith — and a refusal is the one event that shows an agent *wanted* something it
was not allowed, which is why it is the event worth keeping.

Storage layout
--------------
  <root>/registry.json                 agents known to the fabric
  <root>/channels/<id>/manifest.json   topic, participants, barrier state
  <root>/channels/<id>/log.jsonl       hash-chained public channel log
  <root>/channels/<id>/private/<a>.jsonl   sealed divergent reasoning (owner-only)
  <root>/channels/<id>/seals/<a>.json      committed digest of position
  <root>/channels/<id>/ledger.jsonl    positions, concessions, drift events
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("AIM_ROOT", "/root/tmp/agent-im"))

PHASES = [
    "SEALED_DIVERGENT",
    "COMMIT",
    "SYNTHESIS",
    "CROSS_EXAMINE",
    "RESOLVE",
    "CLOSED",
]

TRANSITIONS = {
    "SEALED_DIVERGENT": ["COMMIT"],
    "COMMIT": ["SYNTHESIS"],
    "SYNTHESIS": ["CROSS_EXAMINE"],
    "CROSS_EXAMINE": ["SYNTHESIS", "RESOLVE"],
    "RESOLVE": ["CLOSED", "CROSS_EXAMINE"],
    "CLOSED": [],
}

# What each phase lets you do.
PHASE_RULES = {
    "SEALED_DIVERGENT": dict(read_others=False, channel_say=False, private_say=True),
    "COMMIT": dict(read_others=False, channel_say=False, private_say=True),
    "SYNTHESIS": dict(read_others=False, channel_say=False, private_say=True),
    "CROSS_EXAMINE": dict(read_others=True, channel_say=True, private_say=True),
    "RESOLVE": dict(read_others=True, channel_say=False, private_say=False),
    "CLOSED": dict(read_others=True, channel_say=False, private_say=False),
}

# Argument kinds accepted on the public channel during CROSS_EXAMINE.
CROSS_EXAMINE_KINDS = {
    "evidence",
    "objection",
    "rebuttal",
    "question",
    "concession",
    "proposal",
    "note",
}

# The kinds that *are* a position rather than a remark about one. Hoisted out of
# `cmd_say`, where this set was a bare literal, so that `push` can ask the same
# question of its own body (T-0147): a doorbell carrying a `position` is a
# position whether or not it arrived through the channel, and a second copy of
# the list here is exactly the second reader this repo keeps measuring. The
# words are the sealed-position vocabulary design/05 gives `seal`/`say`;
# `evidence` and `objection` are deliberately absent because they are moves
# *about* someone else's sealed claim and have no meaning outside
# CROSS_EXAMINE, which `cmd_say` already enforces.
COMMITMENT_KINDS = {"note", "claim", "evidence", "position", "question"}

# The kinds that have no public route at all — the vocabulary a *private* write
# may carry without asking for one, because there is nowhere else for it to go.
# Derived from the two tables that define the routes rather than listed a third
# time, which is the rule this file states at :135-139: `CROSS_EXAMINE_KINDS` is
# the set of moves the public channel accepts, so a kind it cannot carry
# (`claim`, `position`) has exactly one destination, and a kind it can carry
# (`note`, `evidence`, `question`) is a public speech act that must be refused by
# name — not quietly downgraded — when the channel is closed. Writing that list
# out a second time is how `cmd_say`'s `to_public` came to disagree with the
# phase table it was a copy of (T-0230).
SAY_PRIVATE_KINDS = frozenset(COMMITMENT_KINDS) - CROSS_EXAMINE_KINDS

MAX_MSGS_PER_ROUND = 2       # per participant, per cross-examination round
ECHO_RATIO_LIMIT = 0.50      # share of 8-grams that may echo a peer verbatim

# --------------------------------------------------------------------------
# work items (design/05 §3, §4, §5 — frozen interface)
# --------------------------------------------------------------------------
# A board is a shared, always-on, anyone-can-write surface, and the barrier's
# whole mechanism is denying access to a shared surface until positions are
# formed. So a work item is channel state and obeys the phase gate: it is born
# `draft`, and `publish` is the deliberate act that exposes it.
#
# The leak this closes is not an attack, it is a convenience:
#
#     task: "attack codex's c5 claim, the temp-path one"
#
# That title is a complete statement of the author's framing, written in the
# least suspicious form the fabric contains — an ordinary planning note.
TASK_STATUSES = ["backlog", "ready", "doing", "review", "done", "blocked", "dropped"]
TASK_FLOW = {                       # the state machine, not free text
    "backlog": ["ready", "blocked", "dropped"],
    "ready": ["doing", "blocked", "dropped"],
    "doing": ["review", "blocked", "dropped"],
    "review": ["done", "doing", "blocked", "dropped"],   # back to doing = changes requested
    "done": [],
    "blocked": ["ready", "doing", "dropped"],
    "dropped": [],
}
TASK_PRIORITIES = ["low", "normal", "high"]
# Every event name a **card** may carry. Until T-0251 this list was declared and
# **read by nothing** (`grep TASK_EVENTS` found the declaration and no reader),
# so a writer outside it dropped silently: `cmd_task_edit` emitted `edited` into
# `tasks.jsonl` for a whole day while the board's fold had no branch for it, and
# the store's own stray-name counter could not fire because `edited` arrives
# after a `created` the fold did read. A vocabulary nothing reads is prose. It is
# read now: `_refuse_stray_task_event` is called from `_append_task_event` and
# `_append_task_event_guarded`, the only two functions any card event is
# appended through, and it refuses a name outside this list -- so the list is
# the gate rather than a description of one. The call sites are named and not
# numbered on purpose: this comment lives inside the file its numbers would
# point into, and the first draft of it did cite them, which pushed them down
# by two the moment it was written. `grep -n _refuse_stray_task_event bin/aim`
# is the number, and it cannot go stale.
#
# The scope is a *card*, and the doorbell is the boundary case that decides it:
# `aim task doorbell` writes `doorbell_created`/`doorbell_rotated` to
# `push.jsonl` and carries a task id, so a check keyed on "is it a task event"
# would refuse a real event of another store. A card is a row in
# `channels/<ch>/tasks.jsonl`, which is what this list names.
TASK_EVENTS = ["created", "moved", "assigned", "published", "linked", "commented",
               "dropped", "retracted", "edited"]
# Phases in which a participant may only see their own drafts.
DIVERGENCE_PHASES = ("SEALED_DIVERGENT", "COMMIT", "SYNTHESIS")


def _next_opener(capability, after):
    """The first phase *after* `after`, in PHASES order, whose rule is True.

    `after` is exclusive because a phase trivially "opens" whatever it already
    has: the question `advance` has to answer is what a *later* transition
    would open, which is the question the leader asked when they advanced to
    COMMIT expecting cross-examination and nothing happened (T-0213).
    """
    for phase in PHASES[PHASES.index(after) + 1:]:
        if PHASE_RULES[phase][capability]:
            return phase
    return ""


# Derived from `PHASE_RULES` rather than written a second time. The sentence
# `advance` prints about which phase next opens a capability has to be the same
# fact the gate enforces, or the tool has two opinions about one rule and the
# printed one is the one nobody gates on -- which is the drift this deriver
# exists to make impossible.
PHASE_OPENERS = {phase: {cap: _next_opener(cap, phase) for cap in PHASE_RULES[phase]}
                 for phase in PHASES}

# The fields `aim task edit` may correct on an existing card, and the reason the
# list is short and closed. `status` is deliberately absent -- `move` is the verb
# with the state machine and the evidence rules behind it -- and so is anything
# a different verb already owns (`owner`: `assign`; `blocked_by`: `link`;
# `visibility`: `publish`). What is left is the metadata a planner gets wrong.
#
# The list was measured from the one case that needs it: T-0235's own card sits
# in milestone M2, whose accept line is "N agents in one room, ordered, no lost
# message under 12 concurrent writers", while T-0235 is a `bin/aim` verb about
# milestones -- so `reports.milestones.M2.total` counts a card that cannot move
# M2's own sentence, and there was no verb that could correct it.
TASK_EDIT_FIELDS = ("milestone", "priority", "start", "due", "estimate_pts",
                    "tags", "title", "accept")



# --------------------------------------------------------------------------
# primitives
# --------------------------------------------------------------------------
def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def sha256_hex(data):
    if isinstance(data, str):
        data = data.encode("utf-8")
    return hashlib.sha256(data).hexdigest()


# The refusal ledger needs to know who tried what, and `die()` is the single
# choke point every refusal passes through — but it is called from ~40 places
# that each know something different. So the command records its context first
# and `die()` reads it. One process = one command = one context.
#
# The ledger's `class` field is decided the same way, and it is decided *at the
# refusal site* rather than derived, because deriving it was measured wrong.
# It used to be `"barrier" if msg.startswith("REFUSED") else "form"` — a rule
# about spelling, where design/05 §1 promises a rule about substance ("whether
# it was a phase refusal or a malformed request"). The two disagreed on the very
# first live fabric I asked, and the disagreement was not a corner case: every
# phase rule that did not happen to be spelled with a `REFUSED:` prefix was
# filed as a malformed request, and three of them were not filed at all.
#
#   [measured, temp AIM_ROOT, 2026-09-21; the same refusals tests/selftest.sh
#    asserts on. `no record` means `die()` ran and the ledger kept nothing at
#    all, which is the worse failure of the two. Middle column = the class the
#    old inference wrote; right column = the class this file writes now.]
#
#     inbox during SEALED_DIVERGENT        the barrier refusing   no record  -> barrier
#     say on the public channel            the barrier refusing   no record  -> barrier
#     reveal before CROSS_EXAMINE          the barrier refusing   no record  -> barrier
#     `sealing is closed in SYNTHESIS`     the barrier refusing   form       -> barrier
#     `may not advance the barrier`        the barrier refusing   form       -> barrier
#     `synthesis may only be published …`  the barrier refusing   form       -> barrier
#     `moving to 'blocked' requires --reason`  a workflow rule    barrier    -> form
#     `owner 'nobody' is not a registered agent`  malformed input barrier   -> form
#
# Not one of those rows is contrived; each is the refusal its own test names.
# So: `cls="barrier"` at the sites that enforce the barrier, default `form`
# everywhere else, and a test that reads the ledger the tool actually wrote.
# Only a reader who can tell a phase refusal from a malformed request can use
# the ledger to answer "did anyone lean on the barrier" — which is the whole
# reason the field exists, and the sentence README §3 makes to the leader.
#
# T-0222 corrected the "default `form` everywhere else" half of that sentence,
# because measuring it showed the default was not a fallback, it was a claim,
# and the claim was false at every site that inherited it: 15 of the 89 below
# said nothing, and the 15 were not a random 15 -- they were the membership
# gates and the "we do not know who you are" checks, which is to say the
# identity refusals. `_record_refusal` defaults to
# `cls="unrecorded"` now. The two rules that make that the honest default:
#
#   * A default is only safe if it is wrong *visibly*. `form` is a positive
#     claim — "the request itself was malformed" — and the barrier page offers
#     it as a filter, so a site that forgot its class did not merely lose
#     information, it made a false statement about a well-formed request. On
#     the live `hello` ledger, every identity refusal was filed that way: 6 x
#     `'stranger' is not a participant` and 1 x `unknown agent` under
#     `class="form"` (measured 2026-09-22, `channels/hello/ledger.jsonl` at
#     commit dbdd04e, before this change). `unrecorded` is the one sentence
#     that is true whenever nobody said otherwise, and it is deliberately *not*
#     an option in BarrierPane.vue's filter: a reader who filters by `barrier`
#     or `form` gets exactly the rows someone decided about, so an omission
#     shows up as a count that does not add up.
#   * A site that omits the class now records `unrecorded`, and after this
#     change there is no such site: `die` in this file carries a literal class
#     at all 89 of its call sites (counted with `ast.walk` over `bin/aim`, not
#     by grep), 54 x `form` and 35 x `barrier` -- a split that would have been
#     89 x `form` under the old default. The default now exists for a caller
#     that has not been written yet, not for the ones that have.
#
# Cost, stated rather than implied: a future site that is genuinely `form` and
# says nothing now records `unrecorded`, which is a weaker claim than the
# ledger could make. That is a loss of precision for a reader; recording a
# phase refusal as a malformed request was a loss of *truth*, and those are not
# the same size. An explicit `cls="form"` at every `form` site would recover
# the precision and cost ~54 edits to lines no test can check; this is the
# smaller surface, and `tests/test_refusal_class.py` pins both directions.
#
# Forward only: nothing below rewrites a ledger row that already exists. The
# rows recorded before this change keep the class they were written with, and
# the chain is untouched, because `class` is the answer the tool gave at the
# time and re-deriving it would be editing the record rather than correcting
# the writer.
_CTX = {"channel": None, "actor": None, "action": None}


def note_context(channel=None, actor=None, action=None):
    for key, val in (("channel", channel), ("actor", actor), ("action", action)):
        if val is not None:
            _CTX[key] = val


def _record_refusal(msg, cls="unrecorded"):
    """Write the refusal to the ledger. Never raises.

    A refusal is the most legible event this system produces: it is the only
    trace that an agent was *tempted*. Without it the record cannot distinguish
    "nobody tried" from "everybody tried and was stopped", and the design's
    claim that the barrier can be audited is unfalsifiable from the artifact.
    """
    ch = _CTX.get("channel")
    if not ch:
        return
    try:
        d = channel_dir(ch)
        manifest = read_json(d / "manifest.json")
        if manifest is None:
            return
        with Lock(d / ".ledger.lock"):
            append_chained(d / "ledger.jsonl", {
                "ts": now_iso(),
                "event": "refusal",
                "agent": _CTX.get("actor") or "",
                # Which session was refused (T-0242). The ledger is read as the
                # answer to "did anyone try", and `agent` alone answers it for
                # the wrong unit: when two live sessions hold one id, the record
                # has to name the one that was stopped. One insertion here
                # covers every refusal, because every refusal passes through
                # this function.
                "session": session_of(),
                "action": _CTX.get("action") or "",
                "phase": manifest.get("barrier", {}).get("phase", ""),
                "class": cls,
                "reason": msg.split("\n")[0][:400],
            })
    except Exception as exc:                                # never mask the refusal
        print(f"aim: warning: refusal not recorded: {exc}", file=sys.stderr)


def die(msg, code=2, cls="unrecorded"):
    """Refuse, record it, and exit non-zero.

    `cls` defaults to the class that means "the caller did not decide", not to a
    claim about the request. A default is a statement about every call site that
    forgets, and `form` was a *false* statement at those sites (T-0222): the
    request was well-formed and the tool refused it for who was asking. See the
    block above `_CTX` for the measurement and for why `unrecorded` is the
    honest default rather than a third filter option.
    """
    _record_refusal(msg, cls)
    print(f"aim: {msg}", file=sys.stderr)
    sys.exit(code)


class Lock:
    """Advisory exclusive lock so concurrent agents can share one log safely."""

    def __init__(self, path):
        self.path = path
        self.fh = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.fh = open(self.path, "a+")
        fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
        self.fh.close()


def read_jsonl(path):
    """Read a JSONL file, refusing to guess about a malformed line.

    A truncated last line is exactly what a writer killed mid-append leaves
    behind, and the previous version of this function raised a bare
    json.JSONDecodeError from inside whatever command happened to be running —
    a traceback, not a finding. `verify` would crash instead of reporting
    TAMPER, which is a reader failing at the one job it has.

    Skipping bad lines silently would be worse: a chain that is quietly one
    record short is the "well-formed file missing a fact" failure this project
    has already measured once. So the caller gets an error it must handle.
    """
    if not path.exists():
        return []
    out = []
    with open(path, "r", encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise MalformedLog(path, n, str(exc)) from exc
    return out


class MalformedLog(Exception):
    """A JSONL file has a line that is not a JSON object."""

    def __init__(self, path, lineno, detail):
        self.path, self.lineno, self.detail = path, lineno, detail
        super().__init__(f"{path.name}:{lineno} is not valid JSON ({detail})")


def read_jsonl_lenient(path):
    """Best-effort read for display paths. Returns (records, bad_line_numbers)."""
    if not path.exists():
        return [], []
    recs, bad = [], []
    with open(path, "r", encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line:
                continue
            try:
                recs.append(json.loads(line))
            except json.JSONDecodeError:
                bad.append(n)
    return recs, bad


def read_json(path, default=None):
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path, obj):
    """Replace a JSON file atomically.

    The temp name carries the pid, so two processes writing different targets in
    the same directory can never collide, and two writers of the *same* target
    cannot clobber each other's half-written temp file. That still leaves the
    read-modify-write *around* this call racy — os.replace is atomic, but
    "load, change, save" is not. Use update_json() for anything that mutates
    shared state.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(path)


def update_json(path, mutate, default=None, lock=None):
    """Read-modify-write under an exclusive lock.

    `write_json` is atomic per write, which is not the same as safe for
    read-modify-write: two agents that both load the registry, both add
    themselves, and both save will lose one of the two. That is the lost-update
    race, and it is invisible afterwards — the file is well-formed and simply
    missing a registration, which is precisely the kind of failure that reads as
    "an agent was never here".

    So the lock is held across the whole transaction, not just the write. Returns
    the object that was written.
    """
    with Lock(lock or path.with_name(path.name + ".lock")):
        obj = read_json(path, default)
        obj = mutate(obj)
        write_json(path, obj)
        return obj


def append_chained(path, rec):
    """Append a record whose `prev` field hashes the previous record.

    Tamper-evidence, not tamper-proofing: anyone may rewrite the file, but
    `aim verify` will then show the chain break.

    An unchained tail is tolerated, loudly. A record whose `hash` is missing is
    still a record someone wrote, and refusing to append after it would turn a
    corrupt ledger into a *silently* corrupt one: every later refusal would fail
    to record and the failure would live on stderr, where nobody auditing the
    ledger would ever see it. That is strictly worse than the corruption, because
    "nobody was tempted" and "the recorder was broken" look identical from the
    ledger — which is the one distinction the ledger exists to make.

    The `prev` link says `genesis` and `chain_broken` says why, so `aim verify`
    reports it instead of the two records simply being unchained. Codex's renderer
    test fixture writes its ledger without hashes, which is how this was found:
    three of its checks assert a refusal was recorded, and every one of them was
    failing for a reason that had nothing to do with the refusal.
    """
    recs = read_jsonl(path)
    if recs and not recs[-1].get("hash"):
        rec["prev"] = "genesis"
        rec["chain_broken"] = (
            "the previous record in this file carries no hash, so this one cannot "
            "chain onto it; it was appended rather than dropped so that the "
            "refusal is on the record")
    else:
        rec["prev"] = recs[-1]["hash"] if recs else "genesis"
    rec["hash"] = sha256_hex(canonical({k: v for k, v in rec.items() if k != "hash"}))
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    return rec


# --------------------------------------------------------------------------
# state
# --------------------------------------------------------------------------
def registry_path():
    return ROOT / "registry.json"


def load_registry():
    return read_json(registry_path(), {"agents": {}})


def save_registry(reg):
    write_json(registry_path(), reg)


def agent_kind(agent_id):
    reg = load_registry()
    a = reg["agents"].get(agent_id)
    return a["kind"] if a else None


def _departed_at(agent_id):
    """When this id last declared its session finished, or "" if it never did.

    T-0253. Read off the registry on every call rather than cached: the record
    this reads is the one `depart` and `register --force` write, so a cache here
    is a refusal aimed at a seat that has already come back. `resolve_actor`
    already reads the same file once inside `agent_kind`; the second read is one
    small file per process, and folding the two would mean changing an identity
    function that ten call sites share for the sake of a buffer.
    """
    rec = load_registry()["agents"].get(agent_id) or {}
    return rec.get("departed_at") or ""


def channel_dir(ch):
    return ROOT / "channels" / ch


def load_manifest(ch):
    m = read_json(channel_dir(ch) / "manifest.json")
    if m is None:
        # A channel id that names nothing is the request, not the caller: the
        # same command with a live channel succeeds.
        die(f"no such channel: {ch}", cls="form")
    return m


def save_manifest(ch, m):
    write_json(channel_dir(ch) / "manifest.json", m)


def _workspace_conflicts(manifest):
    """Which declared workspaces two participants share and could write to.

    This exists because the fabric was lying about itself, and the lie was the
    least visible kind: **true by accident**. `hello` is SEALED_DIVERGENT while
    both participants work in the same checkout — one of them has been running
    this repo's test suite, the other has been editing the same files — and the
    fabric notices nothing. From the ledger the channel looks exactly like a
    barrier that is holding.

    A participant cannot be trusted to report its own independence; that is the
    premise the whole design rests on, and an agent reading `bin/aim` is not
    sealed from anything. What *can* be checked is the one fact that settles it:
    does the channel name a place its participants both write to? If it does,
    divergence there is a claim the tool cannot keep, because the second agent
    to edit a file has read the first one's work — at second hand, in the same
    repository, on the same disk, before either has sealed.

    Returns a list of (path, participants) so the refusal can name the manifest
    the way design/07 §7 asks. Two shapes of declaration count, because they are
    the same fact stated two ways: a per-participant mapping (this agent works
    here) and a shared list (these agents work here together).
    """
    declared = manifest.get("workspace") or {}
    if not isinstance(declared, dict):
        return []
    owners = {}          # workspace path -> set of participants who named it
    if "participants" in declared and isinstance(declared["participants"], (list, dict)):
        entries = declared["participants"]
    else:
        entries = {p: declared.get(p) for p in manifest.get("participants", [])}
    for who, ws in entries.items():
        if not ws:
            continue
        if isinstance(ws, str):
            owners.setdefault(ws, set()).add(who)
        elif isinstance(ws, dict):
            path = ws.get("path")
            if path and ws.get("writable", True):
                owners.setdefault(path, set()).add(who)
    return sorted((path, sorted(members)) for path, members in owners.items()
                  if len(members) > 1)


def assert_barrier_defensible(manifest, to_phase=None, refused_edge="", forced=False):
    """Refuse a transition into a divergence phase that the manifest falsifies.

    The precondition is a fact about the channel rather than a step in the state
    machine, so it is checked wherever a divergence phase is about to hold: when
    the channel is opened, and on every transition *into* one. A manifest can
    gain a workspace after the channel exists — `aim channel workspace` exists so
    that it can — and a channel in CROSS_EXAMINE can be carried back to
    SYNTHESIS, which is why checking only `new-channel` is a check the second
    command walks past.

    Whether the *current* phase may continue is checked by the caller, and only
    when the channel has not already been past the floor. `advance` has to decide
    that for itself: a channel that has physically been through CROSS_EXAMINE
    cannot claim its positions were committed before exposure no matter what the
    manifest says, so refusing to let it go home to SYNTHESIS would be a rule
    about paperwork rather than about exposure. A channel that declared a shared
    workspace before reaching the floor has no such history, and its current
    divergence phase is refused on the next transition — whatever that
    transition is, which is why `advance` checks this for every `to`.

    `refused_edge` and `forced` exist for `advance` alone, and they are here for
    the one measurement that made the generic sentence false. T-0248: a channel
    in COMMIT that declares a shared workspace finds its **only legal forward
    edge** — `COMMIT -> SYNTHESIS`, the single entry in `TRANSITIONS["COMMIT"]` —
    refused, bare *and* under `--force`, and the refusal was the same four
    sentences used everywhere. Those sentences name the bad state correctly and
    then offer the wrong remedy for this state: their first suggestion is a
    manifest edit, and the reader of this refusal is the leader *asking to leave
    COMMIT*, whose next move is to repeat the command rather than to go and edit
    a manifest they were never told was load-bearing. Nothing said what had
    actually happened, which is that the ordinary exit had just closed.

    So when the caller knows the edge it is standing on, the message names it,
    says what it closed (with the forced case named separately, because the two
    are different facts: `--force` does not reach the guard, and the comment at
    the `advance` call site says why), and gives the exit in the order the caller
    can use it — the way out first, then the next edge once they are out.
    """
    if to_phase not in DIVERGENCE_PHASES:
        return
    conflicts = _workspace_conflicts(manifest)
    if not conflicts:
        return
    where = "; ".join(f"'{path}' is named by {', '.join(members)}"
                      for path, members in conflicts)
    if refused_edge:
        # The specific half: which edge, which exit. `sole` is derived from the
        # same table `advance` read rather than asserted, because whether the
        # refusal strands the channel is a fact about that row of TRANSITIONS and
        # not about the guard: COMMIT has one forward edge and loses it, while
        # CROSS_EXAMINE -> SYNTHESIS is refused with RESOLVE still open, and a
        # message that called both of those "the ordinary exit just closed" would
        # be false in the second case. "under --force as well" is printed only
        # when the caller really forced, because a bare refusal that claimed
        # `--force` had failed too would be a sentence about a command nobody ran.
        cur = manifest["barrier"]["phase"]
        sole = TRANSITIONS.get(cur) == [to_phase]
        closed = (f"'{refused_edge}' is refused under --force as well"
                  if forced else f"'{refused_edge}' is refused")
        if sole:
            stranded = (f"It is the only legal forward edge out of {cur}, so this "
                        f"channel can no longer close by the ordinary route.")
        else:
            # The other half, derived the same way and for the same reason. The
            # edge being refused is not automatically the only one that phase
            # has, and this branch is what keeps the sentence true for
            # CROSS_EXAMINE -> SYNTHESIS, where RESOLVE stays open: the refusal
            # costs the channel an edge, not the channel's exit.
            fwd = [t for t in TRANSITIONS[cur] if t != to_phase]
            back = sorted(p for p, edges in TRANSITIONS.items() if cur in edges)
            keeps = f"{cur} keeps its other edges: {', '.join(fwd)}" if fwd else ""
            if back:
                reach = f"{cur} is reachable again from {', '.join(back)}"
                stranded = f"{keeps}; {reach}." if keeps else f"{reach}."
            else:
                stranded = f"{keeps}."
        die(
            f"REFUSED: {closed}: channel '{manifest['id']}' declares a shared "
            f"workspace, so its participants can read each other's work, and a "
            f"barrier here is a claim the tool cannot keep.\n"
            f"{where}\n"
            f"{stranded} --force does not reach this guard: --force answers the "
            f"state machine, and no amount of meaning it changes what is on disk.\n"
            f"Two ways out: clear the declaration (aim channel workspace --channel "
            f"{manifest['id']} --none), after which the ordinary advance works "
            f"again; or keep the declaration — it is a fact about the directory, "
            f"not about the manifest — and move by a forced edge that skips this "
            f"one (aim advance --channel {manifest['id']} --to <phase> --force), "
            f"which is a statement that this channel is not running a barrier.",
            cls="barrier",
        )
    die(
        f"REFUSED: channel '{manifest['id']}' declares a shared workspace, so its "
        f"participants can read each other's work, and a barrier here is a claim "
        f"the tool cannot keep.\n"
        f"{where}\n"
        f"A divergence phase asserts that no participant has seen another's "
        f"reasoning yet, and that assertion is falsifiable by the filesystem, not "
        f"by an agent's word: whoever edits that workspace second has read the "
        f"first one's work before sealing. Amend the manifest (aim channel "
        f"workspace --channel {manifest['id']} --none) or run this channel without "
        f"a barrier.",
        cls="barrier",
    )


def cmd_channel(args):
    """Dispatcher for channel-level declarations. Reached only if a subcommand
    forgot to set its own func, which the required subparser above prevents."""
    die(f"channel: which declaration? (got {getattr(args, 'channel_cmd', None)!r})",
        cls="form")


def cmd_channel_workspace(args):
    """Declare, or clear, the workspace a channel's participants share.

    The same care as `aim task publish` takes with a deliberate leak: clearing a
    declaration does not un-share the directory, so it is recorded in the ledger
    next to the phases, where a reader who never opens the manifest can see that
    the barrier's precondition changed under them.

    Deliberately leader-only: a participant clearing the very declaration that
    falsifies its own barrier is the move this command exists to make visible,
    and the leader is the one who can see both sides.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    require_leader(who, kind, m, what="change the channel's declaration")
    if args.none:
        cleared = m.pop("workspace", None)
        save_manifest(args.channel, m)
        with Lock(channel_dir(args.channel) / ".ledger.lock"):
            append_chained(channel_dir(args.channel) / "ledger.jsonl", {
                "ts": now_iso(), "event": "workspace_cleared", "agent": who,
                "action": "channel workspace", "phase": m["barrier"]["phase"],
                "class": "barrier", "cleared": cleared or {},
                "reason": "the barrier's precondition changed; this is the record of it",
            })
        print(f"{args.channel}: workspace declaration cleared — the phase gate no "
              f"longer knows whether these participants share a directory, and the "
              f"ledger now says so")
        return
    declared = dict(m.get("workspace") or {})
    for item in (args.set or []):
        if "=" not in item:
            die(f"--set wants <participant>=<path>, got '{item}'", cls="form")
        member, _, path = item.partition("=")
        member, path = member.strip(), path.strip()
        if member not in m["participants"]:
            # The caller has already passed `require_leader`; the unknown name is
            # in the request. An identifier the fabric has no participant for is
            # malformed input, the same judgement selftest.sh pins for
            # `task new --owner nobody`.
            die(f"'{member}' is not a participant in '{args.channel}'", cls="form")
        if path:
            declared[member] = path
        else:
            declared.pop(member, None)
    m["workspace"] = declared
    conflicts = _workspace_conflicts(m)
    # T-0248, first branch. The declaration that strands the channel is *this*
    # call, and until now it was the one act in the exchange that left no mark:
    # the manifest was written, nothing was printed about the consequence, and no
    # ledger row was appended -- while the *clearing* of the same declaration is
    # recorded (`workspace_cleared`). The record was asymmetric in the direction
    # that hides the act which closed the exit.
    #
    # Measured before this change, on a throwaway root: a channel in COMMIT,
    # `channel workspace --set a=<p> --set b=<p>` -> rc 0, manifest written,
    # phase still COMMIT, and then `advance --to SYNTHESIS` -> rc 2 `'COMMIT ->
    # SYNTHESIS' is refused`, on both the bare and the `--force` form, with
    # `TRANSITIONS["COMMIT"] == ["SYNTHESIS"]` as the whole of the exit. The
    # second call in the incremental case -- adding the second participant to a
    # path one already names -- is the stranding moment, and it printed only
    # "workspace recorded".
    #
    # This is narrower than `new-channel`'s refusal and it has to be, because the
    # two commands answer different questions. `new-channel` refuses *any* shared
    # workspace, since a channel that has never run has no history that could
    # justify one. A channel already past the barrier floor has earned the right
    # to share a directory -- that is what `assert_barrier_defensible`'s
    # "keep the declaration" branch says, and the reason a channel carried back
    # to SYNTHESIS is refused there rather than here. What is refused here is
    # only the case where the declaration would leave the channel with no legal
    # edge into a phase that can hold it: the edge that just closed is derived
    # from `TRANSITIONS` rather than asserted, so a phase with a surviving
    # forward edge keeps its declaration and only prints the warning.
    #
    # Like `new-channel`, nothing is written when it refuses. The alternative --
    # record the declaration and then refuse -- would leave the manifest naming a
    # shared path while telling the caller the command failed, which is the
    # disagreement between the file and the tool that the rest of this verb
    # exists to avoid. The caller who wants the declaration and not the barrier
    # has the forced edge, which is the honest way to say that.
    if conflicts:
        cur = m["barrier"]["phase"]
        closed_edges = [t for t in TRANSITIONS.get(cur, []) if t in DIVERGENCE_PHASES]
        if closed_edges and not [t for t in TRANSITIONS.get(cur, [])
                                 if t not in DIVERGENCE_PHASES]:
            die(
                f"REFUSED: {args.channel} is in {cur}, and this declaration would "
                f"leave it no way out of a divergence phase.\n"
                + "\n".join(f"  {path}  shared by {', '.join(members)}"
                            for path, members in conflicts) + "\n"
                f"A shared workspace makes the barrier indefensible, so every edge "
                f"out of {cur} into a divergence phase is refused on arrival "
                f"({', '.join(f'{cur} -> {t}' for t in closed_edges)}) -- and this "
                f"phase has no other edge. Nothing has been recorded: the "
                f"declaration is a fact about the directory and the manifest still "
                f"says what it said.\n"
                f"Two ways forward. Declare it in a phase that can hold it -- the "
                f"channel has to be past {cur}, and getting there is `aim advance "
                f"--channel {args.channel} --to <phase> --force`, the statement "
                f"that this channel is not running a barrier, which is also the "
                f"move that fits a shared directory; or, if the shared path was a "
                f"mis-typing, clear it (aim channel workspace --channel "
                f"{args.channel} --none).",
                cls="barrier",
            )
        # The save is here and not at the end of the function because this branch
        # prints "workspace recorded" and used to return without saving anything:
        # the manifest kept the old declaration while the command reported
        # success, which is the disagreement between the file and the tool that
        # the whole verb exists to avoid. Measured: `channel workspace --set
        # a=<p> --set b=<p>` on a channel in CROSS_EXAMINE printed "recorded" and
        # left `manifest["workspace"]` unchanged. The die above is the one path
        # that must not write, and it does not reach this line.
        save_manifest(args.channel, m)
        print(f"{args.channel}: workspace recorded. This channel can no longer "
              f"enter or remain in a divergence phase:")
        for path, members in conflicts:
            print(f"  {path}  shared by {', '.join(members)}")
        return
    save_manifest(args.channel, m)
    print(f"{args.channel}: workspace recorded for {len(declared)} participant(s); "
          f"no two of them share a writable path, so the barrier claim still holds")


def _record_member_event(channel, rec):
    """Append a membership change to the channel ledger, under the ledger lock."""
    with Lock(channel_dir(channel) / ".ledger.lock"):
        append_chained(channel_dir(channel) / "ledger.jsonl", rec)


def cmd_channel_add(args):
    """Join a registered agent to a channel that already exists.

    `aim new-channel` was the only place `participants` was ever written, so a
    registered agent that was not named at creation could never be joined to a
    channel: `say`, `task new`, `friction --add` and `push --channel` all refuse
    a non-participant, and not one of them can create the membership it tests
    for. A registered agent in no channel was therefore in no channel forever.
    This is the verb that performs the join.

    Leader-only, and recorded in the ledger rather than only in the manifest,
    for the same reason `channel workspace` is: membership is what "may speak
    for this channel" resolves to, and it is the barrier's participant list, so
    a change to it is a change to the barrier's precondition. A reader who never
    opens the manifest has to be able to see that it happened.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    require_leader(who, kind, m, what="add a member to the channel")
    if agent_kind(args.agent) is None:
        die(
            f"REFUSED: '{args.agent}' is not a registered agent, so there is nobody "
            f"to join to '{args.channel}'.\n"
            f"Register first: aim register --as {args.agent} "
            f"--kind claude|codex|human|orchestration|other",
            cls="form",
        )
    phase = m["barrier"]["phase"]
    if args.agent in m["participants"]:
        # Idempotent, and the no-op is recorded rather than silent. "Nobody
        # asked" and "somebody asked and it was already true" are different
        # facts about a team, and the ledger is the only artifact that can tell
        # them apart. Exiting 0 keeps it safe to re-run after a partial failure.
        _record_member_event(args.channel, {
            "ts": now_iso(), "event": "channel_member_noop", "agent": who,
            "action": "channel add", "phase": phase, "class": "barrier",
            "member": args.agent, "members": list(m["participants"]),
            "reason": args.reason or "",
        })
        print(f"{args.channel}: '{args.agent}' is already a participant — nothing "
              f"changed, and the request is on the record")
        return
    m["participants"] = list(m["participants"]) + [args.agent]
    save_manifest(args.channel, m)
    _record_member_event(args.channel, {
        "ts": now_iso(), "event": "channel_member_added", "agent": who,
        "action": "channel add", "phase": phase, "class": "barrier",
        "member": args.agent, "members": list(m["participants"]),
        "reason": args.reason or "",
    })
    print(f"{args.channel}: '{args.agent}' joined — {len(m['participants'])} "
          f"participant(s) now, and the change is in the ledger")
    if phase in DIVERGENCE_PHASES:
        # Not decoration. Sealing is per participant and per round, so a member
        # added mid-divergence is a member with no seal, and the next move into
        # SYNTHESIS will refuse until they seal. Saying so here is cheaper than
        # letting the leader discover it at the transition.
        print(f"  {args.channel} is in {phase}: '{args.agent}' has not sealed this "
              f"round, so the move into SYNTHESIS will wait for them")


def cmd_channel_remove(args):
    """Remove a participant from a channel. The inverse of `channel add`."""
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    require_leader(who, kind, m, what="remove a member from the channel")
    if args.agent == m["leader"]:
        die(
            f"REFUSED: '{args.agent}' leads '{args.channel}'. Removing the leader "
            f"would leave the channel with nobody who may move its phase or its "
            f"membership, which is not a state this file can express.",
            cls="form",
        )
    if args.agent not in m["participants"]:
        _record_member_event(args.channel, {
            "ts": now_iso(), "event": "channel_member_noop", "agent": who,
            "action": "channel remove", "phase": m["barrier"]["phase"],
            "class": "barrier", "member": args.agent,
            "members": list(m["participants"]), "reason": args.reason or "",
        })
        print(f"{args.channel}: '{args.agent}' is not a participant — nothing "
              f"changed, and the request is on the record")
        return
    m["participants"] = [p for p in m["participants"] if p != args.agent]
    # The workspace declaration goes with the membership. Leaving it behind
    # would keep blocking divergence phases for a participant who is no longer
    # here, and `channel workspace --set <them>=` could not clear it either,
    # because that verb refuses a non-participant.
    dropped = (m.get("workspace") or {}).pop(args.agent, None)
    if not m.get("workspace"):
        m.pop("workspace", None)
    save_manifest(args.channel, m)
    _record_member_event(args.channel, {
        "ts": now_iso(), "event": "channel_member_removed", "agent": who,
        "action": "channel remove", "phase": m["barrier"]["phase"],
        "class": "barrier", "member": args.agent,
        "members": list(m["participants"]),
        "workspace_dropped": dropped, "reason": args.reason or "",
    })
    print(f"{args.channel}: '{args.agent}' removed — {len(m['participants'])} "
          f"participant(s) now, and the change is in the ledger")
    if dropped:
        print(f"  its workspace declaration ({dropped}) was dropped with it")


# The moment this process started, captured at import. Half of a session token,
# and the half that survives pid recycling (T-0242).
_PROCESS_STARTED = now_iso()


def session_of():
    """The *session* behind the current call, as a token stable for its lifetime.

    T-0242: an agent id is not a session. Measured -- the seal for
    `claude-session1` records `pts/7 claude pid 1697672` while a different
    session in /root/tmp held the same id, and the outbox delivered to both --
    so a row carrying only `actor` cannot answer "which of the two moved this
    card", which is the first question a ledger exists to settle.

    Derived from the process rather than declared, because a declared session is
    exactly as forgeable as the id it is meant to disambiguate: whatever an
    agent can type in `--session` it can type as another agent's. The pid is the
    fact the caller cannot invent, and the start time separates a recycled pid
    from the session that had it first.
    """
    try:
        tty = os.ttyname(0)
    except OSError:
        # No controlling tty: piped, cron, or a harness that gave the child a
        # pipe. Named rather than left empty, because an empty field reads as
        # "this build does not record sessions" and the token is the evidence.
        tty = "notty"
    host = os.environ.get("HOSTNAME") or "host"
    return f"{host[:24]}:{tty}:pid{os.getpid()}@{_PROCESS_STARTED}"


def resolve_actor(args, manifest=None, allow_departed=False):
    """Validate --as and return (agent_id, kind).

    `allow_departed` is for `depart` alone. It is a keyword rather than a
    `--force` argument on purpose: the gate below refuses a finished session on
    every verb, and the one verb whose whole subject is a session's life has to
    be able to see past it or the refusal would name a command that cannot run.
    """
    who = args.__dict__.get("actor")
    if not who:
        # Both refusals here are about the caller rather than the request: a
        # missing `--as` and an id nobody registered are both "we do not know
        # who is asking", which is the identity failure `walled_off` calls being
        # a stranger (aimboard/gate.py:11) — the tool's first gate, taken before
        # any phase rule can be consulted. `form` was the old default and it read
        # as "your command line is malformed", which sent two readers of the
        # ledger (T-0222's finding) looking for a typo in an argv that was
        # correct.
        die("--as <agent-id> is required", cls="barrier")
    kind = agent_kind(who)
    if kind is None:
        die(
            f"unknown agent '{who}'. register first:\n"
            f"  aim register --as {who} --kind claude|codex|human|orchestration|other",
            cls="barrier",
        )
    # Named before the gate below, and after the one above, and the order is the
    # point: an id nobody registered has no actor to record (that empty field is
    # the documented finding T-0222 leaves behind), while an id that *did*
    # register is a real actor whose refusal should say so. A departure refusal
    # that recorded `agent: ""` would read, in the one artifact a reader audits,
    # exactly like the identity failure it is not.
    note_context(actor=who)
    if not allow_departed:
        _refuse_if_departed(who)
    return who, kind


def _refuse_if_departed(who):
    """Refuse a caller whose session has already declared itself finished.

    T-0253, and it is the second half of the same idea `resolve_actor` already
    holds: an unknown id and a finished id are both "nobody is asking" rather
    than "your command was malformed", so this is `cls="barrier"` for the same
    reason the `unknown agent` refusal beside it is.

    `--force` does **not** reach here, and that is deliberately not the shape the
    `register` refusal uses. `register --force` is a *takeover*, and a takeover
    is a statement about the id; this gate fires on every verb, so a `--force`
    term here would mean `aim say --as <someone who left> --force` — an ordinary
    speaking verb reading as an identity guard. The two ways to become live again
    are named in the message instead, and one of them is a verb whose whole
    subject is the caller.
    """
    at = _departed_at(who)
    if not at:
        return
    die(
        f"REFUSED: '{who}' departed at {at} — this session declared itself "
        f"finished, so it no longer speaks for this id.\n"
        f"If you are that agent coming back: aim depart --as {who} --return\n"
        f"If a new session is taking the id over: aim register --as {who} "
        f"--kind <kind> --force --session '<why>'",
        cls="barrier",
    )


def require_leader(who, kind, manifest, what="advance the barrier"):
    if kind != "human" or who != manifest["leader"]:
        # `cls="barrier"` because this is a rule *about the barrier*: only the
        # leader moves the phase. It is not a malformed request — the request is
        # well-formed and is refused for who sent it.
        #
        # `what` is a parameter because the message used to say "may not advance
        # the barrier" no matter which verb asked. That was true for `advance`
        # and false for everything else that now routes through here, and a
        # refusal that names the wrong action is a refusal a reader cannot
        # audit: the ledger's `action` field would say `channel workspace` while
        # the sentence beside it said `advance the barrier`.
        die(
            f"'{who}' may not {what}. only the human team leader "
            f"'{manifest['leader']}' controls phase transitions.\n"
            f"(agents may ask with: aim request-advance ...)",
            cls="barrier",
        )


def gate(manifest, who, action):
    """The barrier itself. Refuse, and say why.

    Every refusal here is `cls="barrier"` by construction: this function exists
    only to enforce a `PHASE_RULES` entry, so a refusal from it is the barrier
    doing its job. That is the definition design/05 §1 gives the field, and it
    is why the class is decided here rather than read off the message.
    """
    phase = manifest["barrier"]["phase"]
    rules = PHASE_RULES[phase]
    if action == "read_others" and not rules["read_others"]:
        die(
            f"REFUSED: channel is in {phase}; cross-reading is closed until "
            f"CROSS_EXAMINE.\nThis is the barrier doing its job: independent "
            f"positions must be committed before exposure.",
            cls="barrier",
        )
    if action == "channel_say" and not rules["channel_say"]:
        # T-0230. The refusal now names the rule that stopped it. `channel_say` is
        # the token the caller can already see — in `aim status --channel <ch>`'s
        # `rules` line and in the API's `rules` block — so a refusal that says
        # only "the channel is closed" leaves the reader unable to connect the
        # refusal to the field that caused it, and unable to grep for it. The
        # name is spelled exactly as `PHASE_RULES` spells it, so the message and
        # the table are one token rather than two.
        #
        # The second line changed with it. The old advice ("Write to your private
        # log instead (kinds: note/claim/evidence/position)") named the *private
        # log* as the destination, which is the sentence that made a silent
        # downgrade look like the intended route; `--private` is now how that
        # intent is declared, and the kinds that have no public route at all
        # (`SAY_PRIVATE_KINDS`) are named from the table rather than listed here.
        die(
            f"REFUSED: channel is in {phase}; channel_say is False — the public "
            f"channel is closed.\n"
            f"Write to your private log instead: `aim say --private`, or a kind "
            f"with no public route ({'/'.join(sorted(SAY_PRIVATE_KINDS))}).",
            cls="barrier",
        )
    if action == "private_say" and not rules["private_say"]:
        die(f"REFUSED: private log is closed in {phase}.", cls="barrier")
    return True


# --------------------------------------------------------------------------
def _is_existing_file(value):
    """Does this free-text argument name a file that is actually there?

    T-0224. A body is free-form UTF-8, so `/tmp/x.md` is a *legal* message body:
    it signs, it delivers, and it says a path where a sentence should be. The
    only honest way to tell the accident from the intention is to ask whether a
    file by that name exists and can be read, so that is the whole test. Values
    carrying a newline, or text with a path inside a sentence, are messages and
    are never touched.
    """
    if not value or "\n" in value:
        return False
    try:
        path = Path(value)
        return path.is_file() and os.access(path, os.R_OK)
    except (OSError, ValueError):
        return False


def free_text_body(args, body_attr="body", file_attr="body_file", literal_attr="body_literal"):
    """Resolve free text for one verb, refusing the `--body <path>` trap (T-0224).

    Precedence: an explicit literal (`--body-literal`) says "these exact bytes,
    even though they look like a path"; then `--body-file` reads the file; then
    `--body`, which is refused when it names an existing readable file, naming
    the flag the writer almost certainly meant.

    Callers resolve the body before any gate that consults the world -- before
    the phase rule, the membership test, or "does that task exist" -- because a
    `--body` holding a path is a statement about the command line, and that
    sentence should not change with the phase the channel happens to be in.

    The guard is deliberately narrow. Refusing every single-token value would
    make `--body /tmp/x.md` (meaning the text) and `--body yes` unsendable, and
    a safety check that eats legal messages is a worse bug than the silent path
    it was written to stop. Both escapes -- `--body-file` holding the one line,
    or `--body-literal` -- still put those bytes on the wire.
    """
    path = getattr(args, file_attr, None)
    if path:
        return Path(path).read_text(encoding="utf-8")
    if literal_attr:
        literal = getattr(args, literal_attr, None)
        if literal is not None:
            return literal
    text = getattr(args, body_attr, "") or ""
    if _is_existing_file(text):
        flag = "--" + body_attr.replace("_", "-")
        escape = f" (or {flag}-literal {text} to send that text literally)" if literal_attr else ""
        die(f"{flag} looks like a file; use --body-file {text}{escape}", cls="form")
    return text


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------
def cmd_init(args):
    ROOT.mkdir(parents=True, exist_ok=True)
    (ROOT / "channels").mkdir(exist_ok=True)
    if not registry_path().exists():
        save_registry({"agents": {}})
    print(f"aim root: {ROOT}")


def cmd_register(args):
    """Claim an agent id. Registration is the only identity the fabric has.

    Anything that can run `aim` can claim any unused id, so attribution is
    reliable only under a cooperative threat model — stated plainly rather than
    implied. What the fabric *can* refuse is silently replacing someone who is
    already here: without that, a second session can take over an id, keep its
    name, and inherit everything the ledger says about it, and no record would
    show the switch.
    """
    # Noted rather than fixed, and it is adjacent to the kind vocabulary above:
    # the only way to correct an existing entry's kind is `--force`, which is the
    # *takeover* argument, and the correction is recorded as a registration event
    # with `reason: "forced takeover"` (below). Correcting your own kind is not
    # taking over your own id -- the entry is still yours, and the session that
    # registered as `codex` only because no better word existed is naming itself
    # more honestly, not seizing somebody's identity. The ledger cannot tell the
    # two apart today: same event, same reason string, different acts. A
    # kind-diff would need its own registration event kind, which is a design
    # change rather than a line, so this stays a note.
    prior = load_registry()["agents"].get(args.actor)
    if prior and not args.force:
        # Registration is the first write every other verb depends on, so a
        # refusal here is refused before identity exists at all: there is no
        # stranger yet, and `--force` is the argument that makes it well-formed.
        die(
            f"REFUSED: '{args.actor}' is already registered "
            f"({prior['kind']}, first seen {prior['registered_at']}).\n"
            f"Registration overwrites the only identity the fabric has, so taking "
            f"an id over is recorded as a distinct event rather than done quietly.\n"
            f"If you are that agent coming back, keep using the id. If you are "
            f"replacing it, say so: aim register --as {args.actor} "
            f"--kind {args.kind} --force --session '<why>'",
            cls="form",
        )

    # The takeover check above races with another register; the one that matters
    # is re-made here, inside the lock, because this is the transaction that
    # decides who the id belongs to.
    taken_over = []

    def _claim(reg):
        prev = reg["agents"].get(args.actor)
        if prev and not args.force:
            die(f"REFUSED: '{args.actor}' was registered by someone else while this "
                f"command was running; nothing was written.", cls="form")
        rec = {
            "id": args.actor,
            "kind": args.kind,
            "model": args.model or "",
            "session": args.session or "",
            "registered_at": now_iso(),
        }
        if prev:
            rec["registration_events"] = (prev.get("registration_events") or [{
                "at": prev["registered_at"], "kind": prev["kind"],
                "session": prev.get("session", ""), "reason": "initial registration",
            }]) + [{"at": rec["registered_at"], "kind": args.kind,
                    "session": args.session or "", "reason": "forced takeover"}]
            taken_over.append(prev)
        reg["agents"][args.actor] = rec
        return reg

    update_json(registry_path(), _claim, {"agents": {}})
    if taken_over or prior:
        print(f"registered {args.actor} ({args.kind}) — TAKEOVER of an existing id, "
              f"recorded in the registry")
    else:
        print(f"registered {args.actor} ({args.kind})")


def cmd_depart(args):
    """Declare that this session has finished with an id.

    The gap first, or this reads as a feature rather than a repair. A registered
    id was permanent: `agent_kind` answers "does this id exist", never "is
    anybody still here", so a session that finished kept its name, its channel
    memberships and its voice, and nothing in the fabric could tell a session
    that was *finished* from one that was merely *idle*. Measured before this
    verb existed: `grep -c depart bin/aim` was 0, and none of the 26 verbs ended,
    left or unregistered anything.

    What this is, stated so it is not oversold: **self-declaration**. A session
    that crashes cannot call it, so `departed_at` covers orderly exits and
    nothing else. The case that prompted it -- sessions that died without saying
    so -- is exactly the one a flag cannot cover, and it needs a witness outside
    the session (a `last_seen` written by `resolve_actor`, or the outbox read as
    a heartbeat) rather than a verb. This does not add that witness.

    The threat model is the one `register` already states, and it does not get
    better here. Anything that can run `aim` can claim any unused id; so anything
    that can run `aim` can depart any registered id, or clear any departure. See
    **README.md §3, "An id is a name, not a credential"** for the one place this
    is stated as design rather than as a defect: `--as` is not authentication,
    `register --session` is a free-text note, and `session_of()` is derived from
    facts the caller can produce, so "refuse a departure for an id that is not
    yours" is not a check this fabric can make. What is refused is the *silent*
    switch: `departed_session` and `departed_reason` name the calling session's
    token and its reason, so a departure by a session other than the one that
    registered reads as exactly that to anyone auditing `registry.json`.

    So the escape from a departure is not `--force` on this verb -- a `--force`
    term here would make `aim say --as <someone who left> --force` a call that
    works, and the guard would read as advisory. The escapes are the two named in
    the refusal: `depart --return`, which is the id's own verb, and `register
    --force`, which is the takeover and clears the departure as part of replacing
    the record.
    """
    # `allow_departed=True`: this verb is the one whose whole subject is a
    # session's life, so the gate every other verb takes would make its own
    # message unrunnable.
    who, kind = resolve_actor(args, allow_departed=True)
    at = _departed_at(who)
    now = now_iso()
    session = session_of()
    reason = (args.reason or "").strip()

    if args.returning and not at:
        # Nothing to clear, and saying so is cheaper than writing a return event
        # for a departure that never happened -- a history whose first entry is
        # "return" is a history that reads as if something was lost.
        print(f"{who}: no departure on the record — nothing to clear.")
        return

    if not args.returning and at:
        # Re-departing is a no-op that would otherwise add a second departure
        # event and move `departed_at`, which is the field the refusal prints.
        print(f"{who}: already departed at {at} — nothing changed. "
              f"(To take the id over as a new session: aim register --as {who} "
              f"--kind {kind} --force --session '<why>')")
        return

    what = "return" if args.returning else "departure"

    def _mark(reg):
        rec = reg["agents"].get(who)
        if rec is None:
            # Unreachable: `resolve_actor` ran two lines up and `agent_kind`
            # answered from this same file. Refused rather than KeyError'd,
            # because the one way to get here is a registry replaced between the
            # two reads, and that is a race this file should report rather than
            # traceback on.
            die(f"REFUSED: '{who}' vanished from the registry between the identity "
                f"check and the write; nothing was recorded.", cls="form")
        # The same list `register --force` builds, seeded the same way, so a
        # reader of one id's history gets one shape whichever verb moved it.
        rec["registration_events"] = list(rec.get("registration_events") or [{
            "at": rec.get("registered_at"), "kind": rec.get("kind", ""),
            "session": rec.get("session", ""), "reason": "initial registration",
        }]) + [{"at": now, "kind": kind, "session": session, "reason": what}]
        if args.returning:
            for k in ("departed_at", "departed_session", "departed_reason"):
                rec.pop(k, None)
        else:
            # `session` is recorded beside the timestamp because T-0242 measured
            # two live sessions holding one id: "this id left" is not the same
            # claim as "the session that just left is gone", and only the second
            # is evidence about who is still here.
            rec["departed_at"] = now
            rec["departed_session"] = session
            rec["departed_reason"] = reason
        return reg

    update_json(registry_path(), _mark, {"agents": {}})

    if args.returning:
        print(f"{who} ({kind}): departure at {at} cleared — this session speaks for "
              f"the id again, and the return is in the registry")
        return
    print(f"{who} ({kind}): departed at {now}. The id keeps its name and its "
          f"history; every verb now refuses it with class=barrier until a session "
          f"calls `aim depart --as {who} --return` or takes the id over with "
          f"`aim register --force`.")
    if reason:
        print(f"  reason: {reason}")
    else:
        print("  (no --reason given. A departure with no reason is the one line of "
              "this record a reader cannot reconstruct; `register --force` asks for "
              "one for the same reason.)")


def cmd_new_channel(args):
    parts = [p.strip() for p in args.participants.split(",") if p.strip()]
    d = channel_dir(args.id)
    if (d / "manifest.json").exists():
        die(f"channel already exists: {args.id}", cls="form")
    for p in parts:
        if agent_kind(p) is None:
            # A declaration is a statement about other agents, and the value is
            # the caller's: no phase and no identity would make "p is a
            # participant" well-formed while `p` does not exist.
            die(f"participant '{p}' is not registered", cls="form")
    if agent_kind(args.leader) != "human":
        die(f"leader '{args.leader}' must be a registered human", cls="form")
    m = {
        "id": args.id,
        "topic": args.topic,
        "created_at": now_iso(),
        "leader": args.leader,
        "synthesizer": args.synthesizer or "",
        "participants": parts,
        "barrier": {
            "phase": "SEALED_DIVERGENT",
            "round": 0,
            "history": [
                {"phase": "SEALED_DIVERGENT", "at": now_iso(), "by": args.leader,
                 "note": "channel opened"}
            ],
        },
    }
    if getattr(args, "workspace", None):
        declared = {}
        for item in args.workspace:
            if "=" not in item:
                die(f"--workspace wants <participant>=<path>, got '{item}'", cls="form")
            member, _, path = item.partition("=")
            member = member.strip()
            if member not in parts:
                die(f"'{member}' is not a participant in '{args.id}'", cls="form")
            declared[member] = path.strip()
        m["workspace"] = declared
    # Before the channel exists, not after: a channel whose own manifest
    # falsifies the barrier must not be opened with a phase that claims it.
    # `to_phase` is spelled out rather than defaulted — a new channel is born in
    # SEALED_DIVERGENT, and a default here would be the same kind of silent
    # inference that made the ledger's `class` field wrong.
    assert_barrier_defensible(m, to_phase="SEALED_DIVERGENT")
    save_manifest(args.id, m)
    (d / "private").mkdir(parents=True, exist_ok=True)
    (d / "seals").mkdir(parents=True, exist_ok=True)
    print(f"channel '{args.id}' open in SEALED_DIVERGENT")
    print(f"  topic: {args.topic}")
    print(f"  participants: {', '.join(parts)}")
    print(f"  leader: {args.leader}   synthesizer: {args.synthesizer or '(unset)'}")
    if m.get("workspace"):
        print(f"  workspace: " + ", ".join(f"{k}={v}" for k, v in sorted(m["workspace"].items())))


def _evidence_list(args):
    ev = []
    for ref in args.evidence or []:
        p = Path(ref)
        item = {"ref": ref}
        if p.exists() and p.is_file():
            item["kind"] = "file"
            item["sha256"] = sha256_hex(p.read_bytes())
            item["bytes"] = p.stat().st_size
        else:
            item["kind"] = "reference"
        ev.append(item)
    return ev


def _shingles(text, n=8):
    words = re.findall(r"\w+", text.lower())
    if len(words) < n:
        return set()
    return {" ".join(words[i:i + n]) for i in range(len(words) - n + 1)}


def echo_ratio(body, peers):
    mine = _shingles(body)
    if not mine:
        return 0.0
    theirs = set()
    for t in peers:
        theirs |= _shingles(t)
    if not theirs:
        return 0.0
    return len(mine & theirs) / len(mine)


def cmd_say(args):
    who, kind = resolve_actor(args)
    body = free_text_body(args)
    if not body.strip():
        die("empty message; use --body or --body-file", cls="form")
    m = load_manifest(args.channel)
    phase = m["barrier"]["phase"]
    if who not in m["participants"] and who != m.get("synthesizer") and kind != "human":
        # The synthesizer is the exception the participant check has to carry:
        # the leader merges the record and may write it, and `who` is an agent
        # only because the earlier gate excluded the stranger. Refused for
        # identity, like every membership gate.
        die(f"'{who}' is not a participant in {args.channel}",
            cls="barrier")

    kind_of = args.kind
    # T-0230. Two flags, read once, because both the kind vocabulary and the
    # destination now depend on which route the writer asked for.
    wants_private = bool(getattr(args, "private", False))
    wants_public = bool(getattr(args, "public", False))
    if wants_private and wants_public:
        # Two destinations named in one command. Either one alone is a decision;
        # together they are a caller who has not decided, and `--public` winning
        # silently would be the same class of bug as the silent downgrade this
        # card is about — the tool picking a destination the writer did not.
        die("REFUSED: --private and --public name two destinations; pick one.",
            cls="form")
    if kind_of is None and phase == "CROSS_EXAMINE":
        # Unchanged, including the `--public` case: `--public` routes to the same
        # log CROSS_EXAMINE labels, so it inherits the same rule. Requiring a
        # label on `--public` in *every* phase was tried and withdrawn — it made
        # a `--public` write in COMMIT refuse with "required in CROSS_EXAMINE",
        # which is a refusal naming a phase the channel is not in, and the honest
        # refusal for that write is the one below (the channel is closed).
        die(
            "REFUSED: --kind is required in CROSS_EXAMINE.\n"
            f"Label the move: one of {', '.join(sorted(CROSS_EXAMINE_KINDS))}.\n"
            "An unlabelled message is how a rebuttal gets read as evidence and a "
            "concession gets read as a proposal.",
            cls="barrier",
        )
    kind_of = kind_of or "note"

    if kind_of == "ruling":
        require_leader(who, kind, m, what="publish a ruling")
    elif kind_of == "synthesis":
        # Both of these are the barrier's own rules, not form errors: one is
        # about who may speak for the channel, the other about when. A
        # `synthesis` typed `send` in SEALED_DIVERGENT is an attempt to publish
        # a merged position before anyone committed one.
        if who != m.get("synthesizer") and kind != "human":
            die(f"only the appointed synthesizer ('{m.get('synthesizer') or 'unset'}') publishes synthesis",
                cls="barrier")
        if phase != "SYNTHESIS":
            die("synthesis may only be published in SYNTHESIS phase", cls="barrier")
    elif wants_private:
        # T-0230. A declared private write is held to the *private* vocabulary
        # (`COMMITMENT_KINDS`) in every phase, the way the private log has always
        # held it — what changed is that a `claim`/`position` may now be written
        # privately while the public channel is open, which before this was
        # refused as "only meaningful in CROSS_EXAMINE" even though the private
        # log is the one place those words mean exactly what they say. This is
        # the permissive half of the split: the private log is the writer's own
        # reasoning, and reasoning is allowed to carry a label the public channel
        # does not accept.
        if kind_of not in COMMITMENT_KINDS:
            die(
                f"REFUSED: '{kind_of}' is not a private-log kind; the private log "
                f"takes {', '.join(sorted(COMMITMENT_KINDS))}.\n"
                f"A move of that name is public speech: {', '.join(sorted(CROSS_EXAMINE_KINDS))}.",
                cls="barrier",
            )
    else:
        if phase == "CROSS_EXAMINE":
            if kind_of not in CROSS_EXAMINE_KINDS:
                die(f"kind '{kind_of}' not allowed in CROSS_EXAMINE; use one of {sorted(CROSS_EXAMINE_KINDS)}",
                    cls="barrier")
        else:
            if kind_of not in COMMITMENT_KINDS:
                die(f"kind '{kind_of}' is only meaningful in CROSS_EXAMINE",
                    cls="barrier")

    rec = {
        "ts": now_iso(),
        "from": who,
        "kind": kind_of,
        "subject": args.subject or "",
        "body": body,
        "evidence": _evidence_list(args),
        "responds_to": args.responds_to or "",
        "refs_seal": args.refs_seal or "",
        "round": m["barrier"]["round"],
        "phase": phase,
    }

    # ---- routing ---------------------------------------------------------
    # T-0230. What used to stand here, and why it is gone:
    #
    #     to_public = kind_of == "synthesis" or phase not in ("SEALED_DIVERGENT",
    #                                                          "COMMIT", "SYNTHESIS")
    #
    # That is a second copy of `PHASE_RULES[phase]["channel_say"]`, spelled as a
    # list of phase *names*, and the file's rule at :135-139 is that a derived
    # fact is not written twice because the two copies drift. It had drifted in
    # the way that matters: it was read as the *destination* of the message,
    # when the only thing it can honestly answer is whether the public channel is
    # open. So `aim say --as alpha --channel gated --body "..."` in COMMIT
    # printed `[private/alpha] note recorded (43 chars)` and exited **0** while
    # `channels/gated/log.jsonl` was never created at all — a success report for
    # a message that reached nobody but the writer, and the refusal the card asks
    # for (`gate(...)` at :866, `REFUSED: … channel_say`) unreachable behind it.
    #
    # Measured, AIM_ROOT=/tmp/aim-probe/t0230, channel `gated` in COMMIT
    # (`channel_say: False, private_say: True`), before this change:
    #
    #     $ aim say --as alpha --channel gated --body "a message the public count must account for"
    #     [private/alpha] note recorded (43 chars)      # exit 0
    #     $ aim status --channel gated | grep '^log'
    #     log       0 public messages                   # and no log.jsonl exists
    #
    # The destination is now derived from the rule table and from a declared
    # intent, never from the phase name:
    #
    #   * `--public` — the writer asked for the channel, so the public route
    #     runs and `gate(...)` refuses by name when the channel is closed.
    #     `--public` therefore *cannot* downgrade: the one thing it must never do
    #     is report success while the message reached nobody but the writer.
    #   * `--private` — the writer asked for their own log, which is a real
    #     capability that phases have (`private_say`), and which `aim say` had
    #     only by accident: `note` is a member of the *public* vocabulary
    #     (`COMMITMENT_KINDS`) and landed privately only while the phase happened
    #     to be closed, so no caller could say "this is for my log" out loud.
    #     `aim say` is documented as private pre-barrier (`README.md` §6), so this
    #     is that route made explicit rather than a new one.
    #   * neither — *only* a kind with no public route is routed privately, and
    #     only while the public channel is shut. `SAY_PRIVATE_KINDS` is a label
    #     with exactly one destination, so the destination is not in doubt and
    #     nothing is downgraded. While the channel *is* open, an unlabelled
    #     `claim`/`position` goes to the public log and is refused there for its
    #     kind, because the writer named no destination and this is the clearer
    #     of the two errors: the words belong to a position-making act, and the
    #     channel is where positions go.
    #   * `synthesis` — unchanged and still public even in SYNTHESIS phase, for
    #     the reason the comment below gives.
    to_public = (kind_of == "synthesis" or wants_public
                 or not (wants_private
                         or (kind_of in SAY_PRIVATE_KINDS and not PHASE_RULES[phase]["channel_say"])))

    if not to_public:
        # A private write is a capability, not a consolation prize, and it is
        # gated by the rule that owns it — `RESOLVE` and `CLOSED` close it.
        gate(m, who, "private_say")
        p = channel_dir(args.channel) / "private" / f"{who}.jsonl"
        with Lock(channel_dir(args.channel) / ".lock"):
            append_chained(p, rec)
        print(f"[private/{who}] {kind_of} recorded ({len(body)} chars)")
        return

    # ---- public channel --------------------------------------------------
    # Publishing a synthesis is the one public write permitted while the channel
    # is still in SYNTHESIS. The role check above already established that only
    # the appointed synthesizer can be here with this kind.
    if kind_of != "synthesis":
        gate(m, who, "channel_say")
    log = channel_dir(args.channel) / "log.jsonl"

    if phase == "CROSS_EXAMINE":
        prior_log = read_jsonl(log)
        known = {r.get("id") for r in prior_log}
        if rec["responds_to"]:
            if rec["responds_to"] not in known:
                die(f"REFUSED: --responds-to '{rec['responds_to']}' is not a message in this channel",
                    cls="form")
        elif known:
            die(
                "REFUSED: every CROSS_EXAMINE message must set --responds-to <msg-id>.\n"
                "No free-floating broadcasts: you answer something specific, or you are silent.\n"
                "(An opening message is the one exception, and only into an empty channel.)",
                cls="form",
            )

        # Quota: your own top-level messages in this round. Direct replies to a
        # question that named you are exempt — otherwise a question could never
        # be answered. Everything else waits for the next round.
        def is_answer_to_me(r):
            tgt = next((q for q in prior_log if q.get("id") == r.get("responds_to")), None)
            return bool(tgt and tgt.get("kind") == "question"
                        and who in (tgt.get("subject") or "") + (tgt.get("body") or ""))

        prior = [r for r in prior_log
                 if r.get("from") == who and r.get("round") == m["barrier"]["round"]
                 and r.get("kind") in CROSS_EXAMINE_KINDS
                 and not is_answer_to_me(r)]
        if prior and len(prior) >= MAX_MSGS_PER_ROUND:
            die(
                f"REFUSED: you have already used your {MAX_MSGS_PER_ROUND} messages this round "
                f"(round {m['barrier']['round']}).\nTurn-taking is part of the barrier; "
                f"wait for the leader to open round {m['barrier']['round'] + 1}.",
                cls="barrier",
            )

        peers = [r["body"] for r in read_jsonl(log) if r.get("from") != who]
        ratio = echo_ratio(body, peers)
        if ratio > ECHO_RATIO_LIMIT and not args.echo_ok:
            die(
                f"REFUSED: {ratio:.0%} of this message restates a peer verbatim "
                f"(limit {ECHO_RATIO_LIMIT:.0%}).\n"
                f"Restating a peer's framing is how a channel drifts to one position "
                f"without evidence. Paraphrase in your own terms, add evidence, "
                f"or pass --echo-ok with --echo-reason to record why quoting is necessary.",
                cls="barrier",
            )
        if args.echo_ok and not args.echo_reason:
            die("--echo-ok requires --echo-reason (it is logged)", cls="form")

    with Lock(channel_dir(args.channel) / ".lock"):
        seq = len(read_jsonl(log)) + 1
        rec["id"] = f"m{seq:04d}"
        rec["echo_ratio"] = round(echo_ratio(body, [r["body"] for r in read_jsonl(log)
                                                    if r.get("from") != who]), 3)
        if args.echo_ok:
            rec["echo_override_reason"] = args.echo_reason
        append_chained(log, rec)
        if kind_of == "concession":
            with Lock(channel_dir(args.channel) / ".ledger.lock"):
                append_chained(channel_dir(args.channel) / "ledger.jsonl", {
                    "ts": rec["ts"], "event": "concession", "agent": who,
                    "target": rec["responds_to"], "refs_seal": rec["refs_seal"],
                    "body": body,
                })
    print(f"[{args.channel}] {rec['id']} {who} -> {kind_of}")


def check_claims_file(path):
    """The claims a `--claims` file holds, or a refusal naming the rule.

    T-0247. `cmd_seal` used to hand the parsed payload straight into the seal,
    whatever the JSON happened to be, and a file holding the bare string
    `"not-a-list"` sealed successfully:

        $ printf '"not-a-list"' > /tmp/n.json
        $ aim seal --as alpha --channel c --summary s --claims /tmp/n.json
        sealed alpha: fa87be50ae2df370…  (10 claims)      # rc=0, a seal written

    Ten is the length of the string. Every later reader that treats `claims` as
    a list of objects then indexes a character -- `aim tension` dies with
    `TypeError: string indices must be integers`, and `/api/state` answers 500
    with `'str' object has no attribute 'get'` -- so the record itself is the
    defect and the readers are only where it surfaces.

    Refusing here is the whole fix for anything sealed from now on, and it is a
    `form` refusal: the request was well-formed and the payload it named was
    not, which is the same shape as an unknown phase name or an unregistered
    owner (`tests/test_refusal_class.py` pins that a bad *value* in a correct
    argv reads `form`).

    Called *after* the phase and membership gates, not before them, and that
    order is deliberate -- it is the split `cmd_reveal` records at its own
    `free_text_body`/phase pair. A bad claims value does not make the channel
    open, so a stranger who also passed a bad file must still be refused for
    identity and recorded `barrier`; evaluating the payload first would file
    that as a malformed request, which is the T-0222 defect one verb over.

    What is checked, and why each clause is here rather than left to a reader:
    a list, because `len()` and iteration are what every reader does; an object
    per element, because they all read element keys; a non-empty `id`, because
    `aim tension` prints claims keyed by it (`bin/aim`, `cmd_tension`) and the
    board's expandable row is keyed by `c.id` (`BarrierPane.vue`); a non-empty
    `claim`, because a position with no claim is not a position; and `kill_if`,
    because the design makes it load-bearing -- `README.md` calls it "the
    observation that would make them drop it" and `_kill_overlap` compares the
    other side's claims against it. The sentence for a missing `kill_if` names
    a way *out* ("write the observation, or record `--empty-kill-if`"), which is
    the rule `cmd_task_move` states for its own `REFUSED` -- "finish the
    blocker, drop the edge, or state the reason with --force" -- rather than a
    way to comply more slowly.

    `confidence` is deliberately *not* required. Every writer the fabric ships
    emits a number, but the design describes a claim's confidence as a statement
    the claimant makes and never as something a reader indexes, so a missing one
    costs a heuristic field rather than breaking a reader.

    Five refusals come out of this function, in the order the checks run: an
    unreadable path, unparseable JSON, a payload that is not a list -- the one
    T-0247 names -- an element that is not an object, and an element missing
    `id`/`claim`/`kill_if`. Each names the value it found and the rule it broke.
    """
    try:
        raw = Path(path).read_text()
    except OSError as exc:
        # A path that cannot be read is the same class of defect one step
        # earlier, and it used to be a traceback too (`FileNotFoundError`, rc=1,
        # no message a script could act on). Named with the flag, because the
        # caller wrote the path and probably means to check it.
        die(f"--claims {path} could not be read: {exc.strerror or exc}", cls="form")
    try:
        payload = json.loads(raw)
    except ValueError as exc:
        die(f"--claims {path} is not valid JSON: {exc}", cls="form")
    if not isinstance(payload, list):
        die(
            f"--claims {path} holds a {type(payload).__name__}, and a claims file "
            f"is a JSON list of objects.\n"
            f"That type is not cosmetic. Sealing used to store whatever the file "
            f"parsed to, so a string sealed as its character count -- the bare "
            f"string \"not-a-list\" published ten claims that were not there -- "
            f"and every reader that treats claims as a list of objects then died "
            f"on the record: `aim tension` with TypeError, `/api/state` with "
            f"AttributeError, a 500 for the leader and for anyone who may see the "
            f"seal (T-0247). Refusing here is what keeps the record readable.\n"
            f"Expected: [{{\"id\": \"c1\", \"claim\": \"...\", \"confidence\": 0.7, "
            f"\"kill_if\": \"...\"}}, ...]",
            cls="form",
        )
    for i, c in enumerate(payload):
        if not isinstance(c, dict):
            die(
                f"--claims {path}: element {i} is a {type(c).__name__}, not an "
                f"object; claims are objects with an id, a claim and a kill_if",
                cls="form",
            )
        missing = [k for k in ("claim", "kill_if") if not str(c.get(k) or "").strip()]
        if not str(c.get("id") or "").strip():
            missing.insert(0, "id")
        if missing:
            die(
                f"--claims {path}: element {i} has no non-empty "
                f"{', '.join(missing)}"
                + (". Rules this refusal stands on: a claim is stated in `claim`; "
                   "`id` is what `aim tension` and the board's seal row key it by; "
                   "and a claim with no `kill_if` is not a claim -- README section "
                   "2 calls it \"the observation that would make them drop it\", "
                   "and `aim tension` scores each claim against the other side's. "
                   "So write the observation, or record the emptiness with "
                   "`--empty-kill-if`." if "kill_if" in missing else ""),
                cls="form",
            )
    return payload


def cmd_seal(args):
    who, kind = resolve_actor(args)
    text = free_text_body(args, body_attr="summary", literal_attr=None)
    if not text.strip():
        die("need --summary or --body-file", cls="form")
    m = load_manifest(args.channel)
    if m["barrier"]["phase"] not in ("SEALED_DIVERGENT", "COMMIT"):
        # A phase rule, and the one that name-and-position it is: sealing is how
        # a position is committed, and the phases after COMMIT are the ones
        # where committing a new one would change what the record means.
        die(f"sealing is closed in {m['barrier']['phase']}", cls="barrier")
    if who not in m["participants"]:
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    # The payload is read and checked here -- after the gates, before anything is
    # written. A seal is a commitment device, so the one thing it may never do is
    # commit a shape that the tools built to read commitments cannot read
    # (T-0247); and the gates run first so that a stranger who also passed a bad
    # file is refused for identity rather than for the file.
    claims = check_claims_file(args.claims) if args.claims else []
    private = channel_dir(args.channel) / "private" / f"{who}.jsonl"
    recs = read_jsonl(private)
    seal = {
        "ts": now_iso(),
        "agent": who,
        "kind": kind,
        "model": load_registry()["agents"][who].get("model", ""),
        "summary": text,
        "claims": claims,
        # Hash of the frozen PREFIX, record by record. Appending after sealing is
        # allowed and visible; editing what was sealed is not.
        "private_log_hashes": [r.get("hash", "") for r in recs],
        # The raw bytes as they were at this instant, for a byte-level check that
        # does not depend on how the file happens to be re-serialized. Every seal
        # written before 15:55Z carried this field under a different contract and
        # was checked by nothing (see cmd_verify); writing both makes the check
        # work for old and new seals alike.
        "private_log_bytes": private.read_bytes().hex() if private.exists() else "",
        "private_log_sha256": sha256_hex(private.read_bytes()) if private.exists() else "",
        "private_log_len": len(recs),
    }
    seal["digest"] = sha256_hex(canonical({k: v for k, v in seal.items() if k not in ("digest",)}))
    write_json(channel_dir(args.channel) / "seals" / f"{who}.json", seal)
    with Lock(channel_dir(args.channel) / ".ledger.lock"):
        append_chained(channel_dir(args.channel) / "ledger.jsonl", {
            "ts": seal["ts"], "event": "seal", "agent": who,
            "digest": seal["digest"], "claims": len(seal["claims"]),
        })
    print(f"sealed {who}: {seal['digest'][:16]}…  ({len(seal['claims'])} claims)")


def cmd_inbox(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    out = []
    can_read_others = PHASE_RULES[m["barrier"]["phase"]]["read_others"]
    for r in read_jsonl(channel_dir(args.channel) / "log.jsonl"):
        if r.get("from") == who or can_read_others:
            out.append(r)
    my_private = read_jsonl(channel_dir(args.channel) / "private" / f"{who}.jsonl")
    if args.json:
        print(json.dumps({"public": out, "private": my_private}, indent=2, ensure_ascii=False))
        return
    if not args.no_barrier_warning and not can_read_others:
        print(f"# barrier: {m['barrier']['phase']} — you see your own messages only\n")
    for r in out:
        if args.since and r.get("id", "") <= args.since:
            continue
        print(f"--- {r.get('id', '(private)')} [{r['kind']}] {r['from']} @ {r['ts']}")
        if r.get("subject"):
            print(f"    subject: {r['subject']}")
        print("    " + r["body"].replace("\n", "\n    "))
        if r.get("evidence"):
            for e in r["evidence"]:
                print(f"    evidence: {e.get('ref')} {e.get('sha256', '')[:12]}")
        print()
    if my_private and args.show_private:
        print("# --- your private log ---")
        for r in my_private:
            print(f"--- [private/{r['kind']}] {r['ts']}")
            print("    " + r["body"].replace("\n", "\n    "))
            print()


def cmd_wait(args):
    """Block until the channel has something new for you. Cheap polling."""
    who, kind = resolve_actor(args)
    deadline = time.time() + args.timeout
    log = channel_dir(args.channel) / "log.jsonl"
    seen = len(read_jsonl(log))
    while time.time() < deadline:
        recs = read_jsonl(log)
        if len(recs) > seen:
            new = recs[seen:]
            for r in new:
                if r.get("from") != who or args.include_own:
                    print(json.dumps(r, ensure_ascii=False))
            return
        time.sleep(args.interval)
    print(f"aim: timeout after {args.timeout}s with no new channel traffic", file=sys.stderr)
    sys.exit(3)


def cmd_advance(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    require_leader(who, kind, m)
    cur = m["barrier"]["phase"]
    to = args.to
    if to is None:
        nxt = TRANSITIONS[cur]
        if not nxt:
            die(f"{cur} is terminal", cls="form")
        to = nxt[0]
    if to not in PHASES:
        die(f"unknown phase '{to}'", cls="form")
    if to not in TRANSITIONS[cur] and not args.force:
        die(f"illegal transition {cur} -> {to} (allowed: {TRANSITIONS[cur]}); --force to override",
            cls="form")
    # Checked against the phase being *entered*, not the one being left: a
    # channel already past CROSS_EXAMINE may legitimately declare a shared
    # workspace, and it is the move back into divergence that falsifies it.
    # `--force` does not override this, deliberately: `--force` exists for "the
    # state machine says no but I mean it", and no amount of meaning it changes
    # what is on disk. A forced divergence on a shared workspace is exactly the
    # claim this refuses.
    #
    # The edge and the flag are passed, so the refusal can say which edge closed
    # and whether the caller had already spent `--force` on it (T-0248).
    # Measured on the pre-fix file, from COMMIT with a shared workspace declared:
    # `COMMIT -> SYNTHESIS` bare rc 2 and `COMMIT -> SYNTHESIS --force` rc 2,
    # both printing the *generic* four sentences, whose first remedy is a
    # manifest edit — so the leader who asked to leave COMMIT was told to go and
    # edit a file, for a request in which nothing was wrong with the file. The
    # silence about `--force` was the worse half: `--force` reached the guard and
    # was absorbed without a word, which is a flag that reports success by being
    # ignored. The guard still refuses either way; what changes is that it now
    # says so.
    assert_barrier_defensible(m, to_phase=to, refused_edge=f"{cur} -> {to}",
                              forced=bool(args.force))

    if to == "SYNTHESIS":
        missing = [p for p in m["participants"]
                   if not (channel_dir(args.channel) / "seals" / f"{p}.json").exists()]
        if missing and not args.force:
            # The barrier's own precondition, and the one `aim tension` repeats
            # from the other side: there is nothing to synthesize until every
            # position is committed, and entering the phase anyway would let the
            # leader read one side before the other exists.
            die(
                "REFUSED: cannot enter SYNTHESIS before every participant has sealed.\n"
                f"missing: {', '.join(missing)}\n"
                "Sealing first is the whole point: a position committed before exposure "
                "cannot be quietly retrofitted afterwards.",
                cls="barrier",
            )
    if to == "SYNTHESIS" and not m.get("synthesizer") and not args.synthesizer:
        if not args.force:
            die("REFUSED: SYNTHESIS needs a synthesizer (--synthesizer <agent>) — "
                "someone who did not argue either side", cls="barrier")
    if args.synthesizer:
        if args.synthesizer in m["participants"]:
            die(
                f"REFUSED: '{args.synthesizer}' is a participant in this channel.\n"
                "The synthesizer's whole value is that they did not argue either side. "
                "An advocate summarizing the disagreement is the first speaker wearing "
                "a lab coat.",
                cls="barrier",
            )
        if agent_kind(args.synthesizer) is None:
            # `--force` is not the escape here and the phase is not the reason:
            # the argument names an agent id the fabric has never seen.
            die(f"'{args.synthesizer}' is not a registered agent", cls="form")
        m["synthesizer"] = args.synthesizer
    if to == "CROSS_EXAMINE":
        m["barrier"]["round"] += 1

    # The rule diff, computed from the two entries of the same table the gate
    # consults. T-0213: the leader advanced to COMMIT expecting cross-examination
    # to open -- only CROSS_EXAMINE sets `read_others`, so the advance moved a
    # label and changed nothing, and the only thing printed was
    # `ch: COMMIT -> ... (round 0, by human)`, which reads as progress. So the
    # three rules are printed with their before and after values, the ones that
    # moved are named, and an advance that moved none says so in words rather
    # than by printing an unchanged list and leaving the reader to diff it.
    #
    # Three clauses, and each is a separate claim:
    #   * all three names with their new values, so a reader who never saw the
    #     old table can still read the current rule set off this line;
    #   * a transition whose rules did not move is reported as *not progress*,
    #     with the phase that next opens the thing the caller was waiting for;
    #   * the same sentence goes on the ledger row, so a reader of the record
    #     (a barrier audit that never runs the command) gets it too.
    rule_changes = [(name, PHASE_RULES[cur][name], PHASE_RULES[to][name])
                    for name in PHASE_RULES[to]
                    if PHASE_RULES[cur][name] != PHASE_RULES[to][name]]
    rules_now = " ".join(f"{n}={'open' if v else 'closed'}"
                         for n, v in PHASE_RULES[to].items())
    # The capability that stays closed and is reachable again later from here.
    # `read_others` is the one the card names. A divergence phase has none, so
    # the sentence is simply omitted rather than printed empty.
    next_opener = PHASE_OPENERS[to].get("read_others", "")
    if rule_changes:
        # The `was` side was inverted: `'closed' if was else 'open'` prints the
        # *opposite* of the old value, so the one line T-0213 exists to make
        # readable read `read_others: open -> open; channel_say: open -> open`
        # for the transition that opens both of them. A reader who trusted it
        # would conclude CROSS_EXAMINE changes nothing, which is the exact
        # misreading the card was filed about -- one that this line created
        # rather than prevented. The `now` side was correct, which is why the
        # bug survived a green-looking output: only one of the two arrows lied.
        moved = "; ".join(f"{n}: {'open' if was else 'closed'} -> "
                          f"{'open' if now else 'closed'}" for n, was, now in rule_changes)
        verdict = f"rules       {rules_now}  — this advance changed {len(rule_changes)}: {moved}"
        if not PHASE_RULES[to]["read_others"] and next_opener:
            verdict += f" (reading stays closed; {next_opener} is the next phase that opens it)"
    else:
        verdict = (f"rules       {rules_now}  — no rule changed; this advance moved a "
                   f"label only, not an access rule")
        if not PHASE_RULES[to]["read_others"] and next_opener:
            verdict += f" (reading is still closed; {next_opener} is the next phase that opens it)"

    m["barrier"]["phase"] = to
    m["barrier"]["history"].append({
        "phase": to, "at": now_iso(), "by": who,
        "round": m["barrier"]["round"], "note": args.note or "",
        "forced": bool(args.force),
        # The rule set the phase was entered with, snapshotted at the transition.
        # `PHASE_RULES` is a table in this file, so a later edit to it would
        # otherwise silently re-describe every phase already on the record --
        # and the one question the record has to be able to answer is what the
        # rules actually were when this advance was taken.
        "rules": dict(PHASE_RULES[to]),
        "rules_changed": [n for n, _, _ in rule_changes],
    })
    save_manifest(args.channel, m)
    with Lock(channel_dir(args.channel) / ".ledger.lock"):
        append_chained(channel_dir(args.channel) / "ledger.jsonl", {
            "ts": now_iso(), "event": "phase", "agent": who,
            "from_phase": cur, "to_phase": to, "round": m["barrier"]["round"],
            "forced": bool(args.force),
            "rules_from": dict(PHASE_RULES[cur]), "rules_to": dict(PHASE_RULES[to]),
            "rules_changed": [n for n, _, _ in rule_changes],
            "noop": not rule_changes,
            "verdict": verdict,
        })
    print(f"{args.channel}: {cur} -> {to} (round {m['barrier']['round']}, by {who})")
    print(verdict)
    if not rule_changes:
        # A second line, because the first one is the sentence the barrier pane
        # and the card's acceptance both quote, and it is long enough that a
        # reader skimming for "did anything happen" will miss it. This says it
        # again in the shortest form that is still true.
        print("            nothing was unlocked by this advance.")


def cmd_request_advance(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in m["participants"]:
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    log = channel_dir(args.channel) / "log.jsonl"
    with Lock(channel_dir(args.channel) / ".lock"):
        seq = len(read_jsonl(log)) + 1
        append_chained(log, {
            "ts": now_iso(), "id": f"m{seq:04d}", "from": who, "kind": "request",
            "subject": f"request: {m['barrier']['phase']} -> {args.to}",
            "body": args.reason, "evidence": [], "responds_to": "",
            "round": m["barrier"]["round"], "phase": m["barrier"]["phase"],
        })
    print(f"request recorded: {m['barrier']['phase']} -> {args.to} (awaiting {m['leader']})")


def cmd_synthesis_input(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who != m.get("synthesizer") and kind != "human":
        die(f"REFUSED: only the synthesizer ('{m.get('synthesizer') or 'unset'}') may read mixed inputs.\n"
            "A participant reading the other side's reasoning before committing their own "
            "is precisely the contamination the barrier exists to prevent.",
            cls="barrier")
    if m["barrier"]["phase"] != "SYNTHESIS":
        die(f"REFUSED: synthesis input is only available in SYNTHESIS (now {m['barrier']['phase']})",
            cls="barrier")
    bundle = {"channel": args.channel, "topic": m["topic"], "participants": []}
    for p in m["participants"]:
        s = read_json(channel_dir(args.channel) / "seals" / f"{p}.json", {}) or {}
        bundle["participants"].append({
            "agent": p,
            "seal": s,
            "private_log": read_jsonl(channel_dir(args.channel) / "private" / f"{p}.jsonl"),
        })
    text = json.dumps(bundle, indent=2, ensure_ascii=False)
    if args.out:
        Path(args.out).write_text(text, encoding="utf-8")
        print(f"wrote {args.out} ({len(text)} bytes)")
    else:
        print(text)


def tasks_path(ch):
    return channel_dir(ch) / "tasks.jsonl"


def task_events(ch):
    return read_jsonl(tasks_path(ch))


def context_of(rec):
    """The `contextId` an A2A record carries, or None if it carries none.

    `contextId` is A2A's name for what we have always called a channel — "an
    identifier for logically grouping related tasks and messages" (§4.4) — and
    design/07 D13 freezes the mapping: **keep `channel` inside, add `context_id`
    as the external field name**. So this function is the one place the two
    spellings meet, and it reads `context_id` first for a reason that is easy to
    get backwards: `context_id` is what the store writes *now*, and `channel` is
    what the records already on disk carry. Reading `channel` first would mean a
    record that carried both spellings with different values resolved to the
    older one.

    `None`, not `""`, when neither is present. An empty string is a value, and a
    caller that asks "does this record name a context" must not be told yes by a
    record that names nothing.
    """
    for field in ("context_id", "channel"):
        value = rec.get(field)
        if value:
            return value
    return None


def fold_tasks(ch):
    """Board state is a fold over the event log. No board file is ever written.

    A kanban board dragged by two agents is a read-modify-write on a shared
    object, which is the lost update this project has already measured once (5
    concurrent registrations, 1 survivor, well-formed file). An append-only log
    has no lost update: the second writer appends and the fold decides. It also
    means "who moved this to done, and when" survives a disagreement about
    whether it was done — a picture cannot do that, evidence can.

    Every event of a task carries `context_id` (or, before T-0105, `channel`),
    and the fold takes the context from the `created` event — the one record whose
    job is to establish what this task *is*. The other events are checked for
    agreement and a task whose events name two different contexts is marked
    `context_conflict`, because `aimboard` decides which channel's phase gate a
    card is drawn under by reading this field, and a card attributed to a channel
    its own log never names is a card drawn under a phase that does not govern it.
    """
    board = {}
    retracted = set()
    for e in task_events(ch):
        tid, ev = e.get("task"), e.get("event")
        if not tid:
            continue
        if ev == "created":
            board[tid] = {
                "id": tid, "title": e.get("title", ""), "owner": e.get("owner", ""),
                "status": e.get("status", "backlog"), "priority": e.get("priority", "normal"),
                "estimate_pts": e.get("estimate_pts", 0), "start": e.get("start", ""),
                "due": e.get("due", ""), "milestone": e.get("milestone", ""),
                "tags": e.get("tags", []), "accept": e.get("accept", ""),
                "visibility": e.get("visibility", "draft"),
                "blocked_by": list(e.get("blocked_by") or []),
                "created_by": e.get("actor", ""), "created_at": e.get("ts", ""),
                # Reported under the A2A name, because that is the name a foreign
                # reader has. `aimboard.fold.fold_tasks` is a second implementation
                # of this rule and does not set it; see the note at the end of this
                # function for why that is a measurement rather than an oversight.
                "context_id": context_of(e),
                "history": [],
            }
            retracted.discard(tid)
        elif ev == "retracted":
            # A retraction is an append, not an edit, and it is the repair for an
            # accidental `created` that does not hand-edit a hash-chained file.
            # The record stays in the chain so `aim verify` still covers it and a
            # reader can still see the mistake; the fold stops drawing the card.
            # Both folds implement it -- this one and `aimboard/fold.py` -- because
            # the writer and the board must agree about which ids exist, or
            # `aim task move` would accept an id the board does not draw.
            board.pop(tid, None)
            retracted.add(tid)
        elif tid in retracted:
            # Not "unknown": the creation *was* seen, then deliberately undone.
            continue
        if tid not in board:
            continue                       # an event for a task that was never created
        t = board[tid]
        t["history"].append(e)
        here = context_of(e)
        if here and t["context_id"] and here != t["context_id"]:
            t["context_conflict"] = sorted({t["context_id"], here})
        if ev == "moved":
            t["status"] = e.get("to", t["status"])
            if e.get("reason"):
                t["status_reason"] = e["reason"]
        elif ev == "assigned":
            t["owner"] = e.get("owner", t["owner"])
        elif ev == "published":
            t["visibility"] = "published"
        elif ev == "linked":
            # A string, because that is what the verb takes; normalised on the way
            # in so the fold never has to ask which generation wrote the event.
            # `set("T-0001")` is a set of six characters, which is how a dependency
            # list turns into six dependencies and nobody notices.
            deps = e.get("blocked_by")
            deps = [deps] if isinstance(deps, str) else list(deps or [])
            for dep in deps:
                if dep and dep not in t["blocked_by"]:
                    t["blocked_by"].append(dep)
        elif ev == "dropped":
            t["status"] = "dropped"
        elif ev == "edited" and e.get("changes"):
            # T-0246 added the verb and T-0246 added the branch *in the board's*
            # fold (`aimboard/fold.py`), not in this one -- and that gap was
            # measured on 2026-09-23 while T-0251's gate was being written:
            # `aim task edit --accept "<line>"` prints `T-0001: accept (unset) ->
            # <line>` and `aim task list --json` still folds `accept` as `""`,
            # because the `created` branch above is the only thing that ever
            # assigns it on this side. Two folds that disagree about a card is
            # the failure the note at the end of this function names, and it is
            # not academic: T-0251's own refusal tells the caller to add the
            # acceptance line with `task edit`, so a reader who followed that
            # remedy hit a card the tool could not see and could never close.
            # Read the same payload the board reads, field by field, and only the
            # fields a card may carry -- a change naming anything else would let
            # an event from another generation invent board state.
            for change in e["changes"]:
                if not isinstance(change, dict):
                    continue
                field = change.get("field")
                if field not in TASK_EDIT_FIELDS:
                    continue
                t[field] = change.get("to")
                # The `from` side, published beside the new value as
                # `<field>_was`, which is what makes an edit readable as an edit
                # rather than as a field that has always had this value. The
                # board's fold has done this since the branch was written
                # (`aimboard/fold.py`, whose comment calls it "the whole point");
                # this fold copied the assignment and not the pair, so the two
                # implementations agreed about every card's *current* state and
                # disagreed about its history. Measured on a throwaway root:
                # `task edit --tag beta --tag gamma --milestone M9` on a card
                # created with `--tag alpha` folded to `tags_was=None`,
                # `milestone_was=None` here and `tags_was=['alpha']`,
                # `milestone_was=''` on the board.
                #
                # Written unconditionally, including when the event carries no
                # `from`, because that is exactly what the board does and the
                # defect being repaired is the two folds disagreeing. A missing
                # key and a `None` both read as "no previous value"; a reader who
                # diffs the two folds does not get to decide which.
                t[f"{field}_was"] = change.get("from")
    # There is a second fold — `aimboard/fold.py`, codex's — and `context_id` is
    # deliberately not added to it here. Not because it does not belong there: it
    # does, and it is the fold the board actually renders from. Because that file
    # is his half of the interface (design/05 §8), and a field added to it from
    # this side would be the second-writer failure that doc names. The accept line
    # for T-0105 is about the *store* and about `aim` not dropping a record an
    # older aim wrote, both of which are asserted; the renderer half is a note to
    # him, not an edit by me.
    return board


def _visible_to(task, who, phase):
    """The board's version of the cross-read refusal.

    An unowned work item is readable by everyone in every phase, and that is the
    leader's rule rather than a relaxation of it: `the task should not belong to
    anyone before assigned, anyone (existing, new join guy) could pickup not
    assigned tasks`. A card nobody holds states no position -- it is an offer of
    work, and the barrier exists to stop a peer's *position* being read before it
    was sealed, not to hide the fact that there is work to do. A card that *is*
    owned keeps the rule exactly as it was: its owner, its creator, or nobody in
    a divergence phase.

    Written as its own clause rather than folded into the return below, and the
    two-line shape is deliberate: `tests/test_a2a_conformance.py` reads this
    function's source and requires every line that is both a `return` and a
    mention of `owner` to be a *claim test* (one that names `created_by` too).
    That check protects the union of owner and creator from being weakened, so
    the exemption must not be spelled as a second claim test -- it is not one.
    """
    if task["visibility"] == "published":
        return True
    if phase not in DIVERGENCE_PHASES:
        return True                        # the barrier is open; drafts are readable
    if not task.get("owner"):
        # Unowned: nobody's position to protect.
        return True
    return task.get("owner") == who or task.get("created_by") == who


def _plan_id_floor():
    """The highest task id the *plan* seeds anywhere under this root.

    The allocation below reads the store's events. The plan is a second source
    of ids that the store does not contain, and on 2026-09-22 that gap produced
    a real collision: `aim task new --channel hello` allocated T-0001 while
    `plan/plan.json` already seeded T-0001..T-0155, so a fresh draft named a
    card the plan already owned and the merged board would have shown the seed
    overridden by an event.

    Every plan file is read, not a chosen one: `plan/*.json` is the convention
    the board already uses (`aimboard/cli.py` globs the same pattern), and a
    floor computed from one file would be wrong the moment a second plan file
    exists — which this repo already has (plan/dogfood.json, plan/risks.json).
    A malformed plan is skipped rather than fatal: it is not this verb's job to
    validate the plan, and a syntax error there would otherwise make task
    creation impossible — a tool that cannot allocate an id because an unrelated
    file is broken is the failure T-0087's doctor exists to surface, reported by
    the wrong command.
    """
    n = 0
    plan_dir = ROOT / "plan"
    if not plan_dir.is_dir():
        return 0
    for path in sorted(plan_dir.glob("*.json")):
        try:
            doc = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        tasks = doc.get("tasks") if isinstance(doc, dict) else doc
        if isinstance(tasks, dict):
            tasks = tasks.values()
        if not isinstance(tasks, list):
            continue
        for task in tasks:
            tid = (task or {}).get("id") if isinstance(task, dict) else None
            if not tid or not str(tid).startswith("T-"):
                continue
            suffix = str(tid).split("-", 1)[1]
            if suffix.isdigit():
                n = max(n, int(suffix))
    return n


def _next_task_id(ch):
    """Allocate the next task id, above both the store's events and the plan.

    The old version took max(fold(...)) + 1, and the fold collapses duplicate
    ids. So after a collision left two records claiming T-0005, the fold showed
    one T-0005 and the next allocation handed out T-0006 — the counter never
    recovered, and every later id was allocated on a board that was missing a
    record. Codex found this by racing 8 creators and reading the log rather
    than the board.

    Reading the ids out of the *events* instead of the fold means a duplicate
    raises the high-water mark rather than hiding below it. That is a repair for
    a fault that should no longer happen, not the fix for it: the fix is that
    the caller passes a seed.

    Determinism is the actual point. Two agents that both call this with the
    same observed seed get the same id, and the second append is the one the
    lock waits for — so it can see that its id is taken and take the next. With
    no seed there is nothing to compare, which is exactly how two writers both
    end up holding T-0011.

    The plan is the second half of the high-water mark, and it is the half the
    event log cannot see: the board merges `plan/plan.json` with the store
    (`merge_plan` in aimboard/fold.py), so an id the plan already uses is an id
    that is *taken* on the board this fabric actually draws — while being absent
    from every event the store holds. Reading only events is how a from-scratch
    channel allocated T-0001 into a plan that had seeded T-0001..T-0155. The two
    maxima are combined rather than the plan replacing the events, because they
    answer different questions and either can be ahead.
    """
    n = _plan_id_floor()
    for e in task_events(ch):
        tid = e.get("task")
        if not tid or not str(tid).startswith("T-"):
            continue
        suffix = str(tid).split("-", 1)[1]
        if suffix.isdigit():
            n = max(n, int(suffix))
    return f"T-{n + 1:04d}"


def _refuse_stray_task_event(ev):
    """A card event whose name is outside the vocabulary is refused, not written.

    T-0251. `TASK_EVENTS` declared the vocabulary and **nothing read it**, and the
    cost was measured: `cmd_task_edit` emitted `edited` into `tasks.jsonl` for a
    whole day while the board's fold had no branch for it, so `task edit
    --priority high` printed its own success and the board did not move. The
    store's stray-name counter could not catch that either -- the fold's
    `unknown` fires on an event whose `created` was never seen, and a stray event
    of a card the fold *did* read takes the ordinary branch and is dropped in
    silence. A vocabulary with no reader is prose; this makes it a gate.

    The check lives here, in the pair of functions every card event is appended
    through, for the reason T-0242 stamped `session` in the same spot: a new verb
    cannot forget it. It is a `form` refusal -- "the event names something that is
    not a card event" is a fact about the request, not about the phase or the
    caller -- and it is refused *before* the write lock, since nothing about the
    store decides it.
    """
    name = ev.get("event")
    if name not in TASK_EVENTS:
        die(
            f"REFUSED: '{name}' is not a card event; a card may carry "
            f"{', '.join(TASK_EVENTS)}.\n"
            "This is the vocabulary `TASK_EVENTS` declares, and it is now read: an "
            "event outside it is one no fold has a branch for, so a store that "
            "accepted it would report the write as a success the board never "
            "shows. If the event is real, add it to `TASK_EVENTS` and give "
            "`aimboard/fold.py` a branch for it in the same change.",
            cls="form",
        )


def _append_task_event(ch, ev, seed=None):
    """Append one task event, allocating `ev['task']` under the write lock.

    The previous version allocated the id under `.lock.lock` and appended under
    `.lock` — two different files, so the id was chosen and the append happened
    outside the same critical section. Between them another process could take
    the same id, and the two creators both appended, both with a good hash and a
    good `prev`. `aim verify` said `chain OK` because the chain *is* intact: two
    records, one id, nothing tampered with.

    A lock is only a lock over the thing it guards, which is why the id is now
    allocated after the append lock is held. The seed is passed in because it
    has to come from the caller's fold, and the lock has to be the one the other
    writers take.
    """
    p = tasks_path(ch)
    _refuse_stray_task_event(ev)   # T-0251: the one gate every card event passes
    # Stamped here rather than in each verb (T-0242): this is the one function
    # every task event is appended through, so a new verb cannot forget it, and
    # `setdefault` leaves a caller that already knows its session in charge.
    ev.setdefault("session", session_of())
    with Lock(channel_dir(ch) / ".lock"):
        if seed is not None and ev.get("task") == seed:
            existing = _next_task_id(ch)
            if existing != seed:
                ev["task"] = existing
                ev["id_reallocated_from"] = seed
        append_chained(p, ev)
    return ev


def _append_task_event_guarded(ch, ev, guard):
    """Append one task event only if `guard` still says yes *under the lock*.

    Every other task verb decides from a fold read outside the write lock, and
    that is right for them: `move` out of a status another writer already left
    is refused on the record's own terms, not on what the reader believed when
    it started. `claim` is the exception. Its whole content is "nobody owns
    this yet" -- a statement about the *absence* of a record -- and two
    claimants who both read the board before either appended would both write a
    well-formed claim: two `assigned` events, one card, nothing erroring, and
    the second claim silently wins on the fold. That is the lost update this
    store has already been burned by once.

    `guard(task)` runs with the lock held and returns (True, "") to append, or
    (False, message) to refuse. It re-folds inside the critical section, so the
    second claimant is refused by the state the first one left behind.
    """
    p = tasks_path(ch)
    _refuse_stray_task_event(ev)   # T-0251: same gate, second path into the store
    # Same stamp as `_append_task_event`: `claim` is the event where two live
    # sessions of one agent are most likely to be mistaken for each other --
    # both read "nobody owns this yet" -- so the row that records the winner has
    # to name which session won (T-0242).
    ev.setdefault("session", session_of())
    with Lock(channel_dir(ch) / ".lock"):
        ok, why = guard(fold_tasks(ch).get(ev.get("task")))
        if not ok:
            return None, why
        append_chained(p, ev)
    return ev, None


def cmd_task_new(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in m["participants"] and kind != "human":
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    if args.status not in TASK_STATUSES:
        die(f"unknown status '{args.status}'; one of {', '.join(TASK_STATUSES)}", cls="form")
    if args.priority not in TASK_PRIORITIES:
        die(f"unknown priority '{args.priority}'; one of {', '.join(TASK_PRIORITIES)}", cls="form")
    if args.owner and agent_kind(args.owner) is None:
        die(f"REFUSED: owner '{args.owner}' is not a registered agent", cls="form")
    vis = args.visibility
    if vis == "published" and m["barrier"]["phase"] in DIVERGENCE_PHASES and kind != "human":
        # The board's version of the cross-read rule: a work item born published
        # during a divergence phase states a position before anyone has sealed
        # one, which is what the barrier exists to prevent.
        die(
            f"REFUSED: cannot publish a work item while the channel is in "
            f"{m['barrier']['phase']}.\n"
            "A task title states a position in the least suspicious form the fabric "
            "contains. Work items are born draft; `aim task publish` exposes one "
            "deliberately, and that act is recorded.",
            cls="barrier",
        )
    if args.blocked_by and args.blocked_by not in fold_tasks(args.channel):
        die(f"REFUSED: no such task to depend on: {args.blocked_by}", cls="form")
    tid = _next_task_id(args.channel)
    # `context_id` is written beside `channel` rather than replacing it, and every
    # reader falls back to `channel` for a record written before this line
    # existed. design/07 D13: keep the internal name, add the external one.
    # Writing both is not belt-and-braces; it is the migration. A store that
    # stopped writing `channel` would leave the records already on disk as the
    # only place the field exists, and a reader that folded them would be reading
    # a field the writer no longer produces — which is how a field quietly
    # becomes optional and then absent.
    ev = {
        "ts": now_iso(), "event": "created", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        # `--owner` is now an *explicit* assignment and not a fallback to the
        # creator (T-0226, the leader's rule: `the task should not belong to
        # anyone before assigned`). This was `args.owner or who`, so every card
        # in the store was born owned -- measured on the live fabric, 71 of 71
        # `created` events carried an owner -- and "who could take this" was
        # unanswerable. A card with `owner: ""` is unowned: readable by every
        # participant in every phase, and taken with `aim task claim`.
        "task": tid, "title": args.title, "owner": args.owner or "",
        "status": args.status, "priority": args.priority,
        "estimate_pts": args.estimate or 0, "start": args.start or "", "due": args.due or "",
        "milestone": args.milestone or "", "tags": args.tag or [], "accept": args.accept or "",
        "visibility": vis,
        # `--blocked-by` is documented in design/05 §5 and was accepted and then
        # dropped on the floor: the flag was parsed and never read, so a task
        # created with a blocker had none, and `move --to done` waved it through.
        # A dependency that only exists in the command line is worse than a
        # missing one, because the board looks right.
        "blocked_by": [args.blocked_by] if args.blocked_by else [],
    }
    ev = _append_task_event(args.channel, ev, seed=tid)
    tid = ev["task"]
    if ev.get("id_reallocated_from"):
        print(f"note: {ev['id_reallocated_from']} was taken while this was being "
              f"written; recorded as {tid}")
    unowned = "" if ev["owner"] else (
        f"  [unowned — `aim task claim --as <you> --channel {args.channel} --id {tid}`]")
    print(f"{tid} created ({ev['status']}, {ev['visibility']}) — {ev['title'][:60]}{unowned}")


def cmd_task_claim(args):
    """Take an unowned work item: the pickup half of the leader's rule.

    `the task should not belong to anyone before assigned, anyone (existing, new
    join guy) could pickup not assigned tasks`. Three things make that state
    real rather than a slogan: the card carries no owner (see `cmd_task_new`),
    it is readable in every phase by every participant of its channel (see
    `_visible_to`), and taking it is a recorded `assigned` event with
    `from: ""` rather than a private intention -- so "who took this, and when"
    survives a disagreement about it, exactly as every other change to a card
    does.

    A claim is not a reassignment. A card somebody already holds is refused, and
    the refusal names the verb that *can* move it (`assign`), because an agent
    that quietly overwrites a peer's claim is the failure the fabricated
    ownership rule was meant to prevent, arriving from the other direction.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in m["participants"] and kind != "human":
        # Same rule as `task new`: work in a channel belongs to its participants.
        # The leader's `new join guy` arrives by `aim channel add`, which is the
        # recorded join, and then claims; there is no path that skips the join,
        # because a claim is an act *in* the channel and not a read of it.
        die(
            f"REFUSED: '{who}' is not a participant in '{args.channel}' and cannot "
            "claim work in it.\n"
            "Picking a card up is work in the channel; the leader's `aim channel add` "
            "is the join.",
            cls="barrier",
        )
    _, _, t = _load_task_or_die(args.channel, args.id, who, kind)
    if t["status"] == "dropped":
        die(f"REFUSED: {args.id} is dropped; a dropped task is a record, not a workspace",
            cls="form")
    if t.get("owner") == who:
        print(f"{args.id} is already yours")
        return
    if t.get("owner"):
        die(
            f"REFUSED: {args.id} is claimed by {t['owner']}.\n"
            f"Taking a card somebody else holds is a reassignment, not a claim: "
            f"`aim task assign --as <you> --channel {args.channel} --id {args.id} "
            f"--owner <who>` is the verb that moves it, and it names its actor.",
            cls="form",
        )

    def still_unowned(task):
        if task is None:
            return False, f"no such task: {args.id}"
        if task.get("owner"):
            return False, (
                f"REFUSED: {args.id} was claimed by {task['owner']} while this claim "
                "was being written, so nothing was recorded. The card is theirs; "
                f"`aim task list --channel {args.channel}` will show its owner.")
        return True, ""

    ev = {
        "ts": now_iso(), "event": "assigned", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "owner": who, "from": "", "via": "claim",
    }
    # `--reason` is read rather than merely parsed: a flag that exists and is
    # dropped on the floor is the defect `--blocked-by` already was.
    if (args.reason or "").strip():
        ev["reason"] = args.reason.strip()
    got, why = _append_task_event_guarded(args.channel, ev, still_unowned)
    if got is None:
        die(why, cls="form")
    print(f"{args.id}: claimed by {who} (was unowned)")


def _load_task_or_die(ch, tid, who, kind):
    m = load_manifest(ch)
    board = fold_tasks(ch)
    t = board.get(tid)
    if t is None:
        die(f"no such task: {tid}", cls="form")
    if not _visible_to(t, who, m["barrier"]["phase"]) and kind != "human":
        die(
            f"REFUSED: '{tid}' is a draft owned by someone else and the channel is in "
            f"{m['barrier']['phase']}.\n"
            "Reading a peer's work item before cross-examination is the board's "
            "version of reading their private log.",
            cls="barrier",
        )
    return m, board, t


def cmd_task_move(args):
    """Move a card along the state machine, with the two actor rules the board needs.

    T-0243 measured the absence: `doing -> review` accepted any viewer, and
    `review -> done` accepted the card's own author. Both are the same missing
    clause -- a move has an *actor rule* and this verb had none -- and each is
    the shape design/05 §4 says `review` exists for: "the only status in which
    the reviewer role is visible on the board rather than in prose". A review
    three that its own author can grant is not a review, and a card a bystander
    can submit is not submitted by anyone whose submission means something.

    Which actor the rules are about is read off the *card*, not off the channel:
    `owner` (T-0226: empty means unowned, and an unowned card has nobody to
    reserve either half for). The leader is exempt for the same reason the
    leader is exempt from the read rule -- the leader is the audience, and
    `aim task move` is the one verb that can unstick a card whose owner has
    gone; without the exemption the escape would be `--force`, which records a
    breach.
    """
    who, kind = resolve_actor(args)
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    if t["status"] == "dropped":
        die(f"REFUSED: {args.id} is dropped; a dropped task is a record, not a workspace",
            cls="form")
    if args.to not in TASK_FLOW.get(t["status"], []):
        die(
            f"REFUSED: illegal transition {t['status']} -> {args.to} for {args.id} "
            f"(allowed: {', '.join(TASK_FLOW.get(t['status'], [])) or 'nothing — terminal'})",
            cls="form",
        )
    # ---- the actor rules (T-0243) ----------------------------------------
    # Applied before the blocker rule below, because "you may not make this
    # move at all" is a fact about the caller and the blocker is a fact about
    # the card; a refusal that named the blocker first would send the caller to
    # `--force` for a move they were never entitled to make.
    owner = t.get("owner") or ""
    actor_exempt = kind == "human"
    overridden = []            # rules `--force` was spent on, for the record
    if args.to == "review" and owner and who != owner and not actor_exempt:
        # The submission. Its whole value is that the author asserts the work is
        # ready to be looked at, so it is the author's to make.
        if not args.force:
            die(
                f"REFUSED: {args.id} is owned by '{owner}' and you are not its owner.\n"
                f"Sending a card to review is its owner's assertion that the work is "
                f"ready to be looked at; a bystander moving it says no such thing. "
                f"This is `aim task claim`/`aim task assign` territory, not `move`.\n"
                f"(--force records the override, with the owner it overrode.)",
                cls="barrier",
            )
        overridden.append(f"owner:{owner}")
    if args.to == "dropped" and owner and who != owner and not actor_exempt:
        # T-0264. The third of the three directions, and the one that was
        # missing. `review` is the submission and belongs to the author; `done`
        # is the approval and belongs to somebody other than the author; a
        # bystander moving a card into `dropped` says nothing about the work at
        # all and is nevertheless the only act in this verb that nothing walks
        # back -- `TASK_FLOW["dropped"]` is empty, so the card is a record from
        # here on, and the leader is refused by the same line as everyone else
        # (`T-0003 is dropped; a dropped task is a record, not a workspace`, rc
        # 2, measured with `--as h`).
        #
        # Measured before this gate, on a throwaway root, with the filer's own
        # reproduction of the accident: `z` creates a card owned by `b`; `b`
        # walks it `backlog -> ready -> doing`; then `z` — creator, not owner —
        # runs `--to dropped --reason probe` and gets **rc 0**, one `dropped`
        # event carrying `"owner": "b"` and `"actor": "z"`, no `--force`, no
        # `--overrode`. The card was `T-0246`, codex's, in `doing`, and it is
        # still gone from every view.
        #
        # The rule is `owner` alone, which is *stricter* than the accept line's
        # minimum: the card asks for a refusal "to a caller who is neither the
        # card's owner nor its creator", and this refuses the creator too when
        # the card has been handed to somebody else. That is deliberate, and it
        # is the half that matters for the accident this card was filed about:
        # `assign` exists precisely so that ownership can move, so a creator who
        # has handed the card on is not a bystander only by a technicality --
        # the filer of this card was exactly that caller, and the card they
        # destroyed was codex's. Measured after the gate, with `z` the creator
        # and `b` the owner: `z --to dropped` is refused rc 2, while `b --to
        # dropped` is rc 0. A creator who means to remove their own card is not
        # stuck -- the refusal names `retract`, which works for them and costs
        # the card without marking it dead.
        #
        # `owner` is not read when the card has none: a task with an empty owner
        # is a card nobody holds, and the verb that clears an owner is
        # `aim task claim`/`assign`, not this one. So the gate fires exactly when
        # there is a holder to protect.
        #
        # `--force` reaches it, and unlike the `review` gate this is the honest
        # shape: dropping codex's card was never the filer's to do, and the one
        # thing a leader has to be able to do in a channel that has gone wrong
        # is clear a card out of the way. What was missing was the record. So
        # the override is named on the event and the refusal names the
        # alternative, which here is the only thing that *is* recoverable:
        # `aim task retract` removes the card from every view without touching
        # the chain, so a card that should not exist can be taken out of the
        # board by its creator or the leader without being marked dead.
        if not args.force:
            die(
                f"REFUSED: {args.id} is owned by '{owner}' and you are not its owner.\n"
                f"Dropping a card is the one move in this verb with no way back: "
                f"`dropped` is terminal (`backlog`, `ready` and `doing` all refuse "
                f"it), and the leader is refused by this same line, so a bystander "
                f"who runs this on a peer's card ends that session's open work.\n"
                f"If the card should not exist at all, `aim task retract --id "
                f"{args.id} --reason '...'` is the verb for that, and its creator "
                f"or the leader may run it. If it is genuinely superseded, ask "
                f"its owner ({owner}), or state the reason with --force, and the "
                f"override is recorded with the owner it overrode.",
                cls="barrier",
            )
        overridden.append(f"owner:{owner}")
    if args.to == "done" and who == owner and not actor_exempt:
        # The approval. `owner` is read off the card and not off the `from`
        # event, so a card whose owner was released and re-claimed cannot be
        # self-approved by the session that held it before -- the rule follows
        # the card, which is the same discipline the fold uses.
        if not args.force:
            die(
                f"REFUSED: {args.id} is owned by '{who}', so '{who}' cannot approve it.\n"
                "`review -> done` is the reviewer's act; an author who closes their own "
                "review has replaced the reviewer with themselves. Ask a peer, or the "
                f"leader, to approve it -- or state the reason with --force, which is "
                f"recorded as an override.",
                cls="barrier",
            )
        overridden.append(f"self-approval:{who}")
    if args.to == "done":
        open_blockers = [b for b in t["blocked_by"] if board.get(b, {}).get("status") != "done"]
        if open_blockers and not args.force:
            # T-0221's third clause. This refusal used to carry a second sentence:
            # `"Done" is the one status that has to be decided by something other
            # than the person asserting it.` There is no such check in this verb
            # and there never was -- the real reason is the open blocker named
            # above -- and a refusal that describes a rule the tool does not have
            # is worse than a terse one, because it sends the reader looking for
            # the check instead of at the blocker.
            die(
                f"REFUSED: {args.id} is blocked by {', '.join(open_blockers)}, which are not done.\n"
                "A dependency that is open is an unmet edge: finish the blocker, drop the "
                "edge, or state the reason with --force, and the override is recorded.",
                cls="form",
            )
        overridden += [f"blocker:{b}" for b in open_blockers]
    # ---- the acceptance gate (T-0251) ------------------------------------
    # The three rules above this line are about *identity* (`:owner` keeps the
    # author out of `done`, `:bystander` keeps the bystander out of `review`) or
    # about *what the card depends on* (an open blocker). None of them reads
    # `accept`, so on every card in this store a close was an identity and never
    # a check -- and `web/src/concepts.js` told the reader the opposite: "The
    # acceptance condition is the part that matters: without one, 'done' is an
    # opinion." This is the clause that makes that sentence true.
    #
    # It is the smallest honest rule: the card's own first branch, first clause.
    # A card with no acceptance condition has nothing a closer could have
    # measured, so the close is refused for the same reason `--to blocked`
    # requires a reason -- an assertion with no content behind it is a stall or
    # an opinion, and both are what the store exists to distinguish. The second
    # clause the card offers (re-state the accept line at the close) is *not*
    # implemented: asking the closer to retype a sentence is an identity check
    # wearing a check's clothes, which is the defect the card is named for.
    #
    # Measured when this was written: 65 recorded closes, 64 of them on a card
    # whose `accept` was non-empty, 1 (`T-0245`) whose card never had one. So the
    # gate refuses exactly the close nobody could have verified, and leaves the
    # other 64 exactly as they were.
    if args.to == "done":
        accept = (t.get("accept") or "").strip()
        if not accept and not args.force:
            die(
                f"REFUSED: {args.id} has no --accept line, so 'done' would be an "
                f"opinion rather than a check.\n"
                "`accept` is the sentence that makes this card verifiable "
                "(`aim task new --accept`), and `review -> done` is the edge that "
                "is supposed to read it. A card with no acceptance condition "
                "leaves the reviewer nothing to check, which is what makes a "
                "close an identity instead of a decision.\n"
                f"Add the line (`aim task edit --id {args.id} --accept '...'`) and "
                "close it with the measurement that satisfies it, or state the "
                "reason with --force, and the override is recorded.",
                cls="form",
            )
        if not accept:
            overridden.append("accept:empty")
    # The measurement itself, on the event rather than only in the transcript.
    # `--evidence` is required on this edge for the same reason `--reason` is
    # required on `--to blocked`: the tool cannot evaluate a sentence like
    # "Playwright proves q, owner and priority", and a tool that pretended to
    # would be the same lie one level up. What it *can* do is require that the
    # closer states, at the moment of the close, what they measured -- so the
    # store holds the claim beside the acceptance condition it answers, and a
    # reader can tell "somebody checked this against the line" from "somebody
    # was entitled to move it".
    if args.to == "done" and not (args.evidence or "").strip() and not args.force:
        die(
            f"REFUSED: closing {args.id} requires --evidence: what was measured "
            f"against its acceptance condition.\n"
            f"The card's accept line is:\n    {accept}\n"
            "A close with no stated measurement is indistinguishable from a close "
            "that checked nothing, which is the whole defect this gate exists for. "
            "State what you ran or read and what it showed; it is recorded on the "
            "`moved` event, beside the accept line it answers. (--force records "
            "the override.)",
            cls="form",
        )
    if args.to == "done" and not (args.evidence or "").strip():
        # T-0251, clause (2). The gate above is skipped when `--force` is passed,
        # and `--force` here was spending an override on a rule the caller never
        # saw and never overrode: the sentence said "(--force records the
        # override)" and on that path there was nothing to record. Measured
        # before this line, on a throwaway root: a `review -> done` on a card
        # with a non-empty accept, `--force`, no `--evidence` -> rc 0, the
        # stored event carrying `"evidence": ""` and `"force_unused": true`, so
        # the row was byte-identical to an ordinary close that stated no
        # measurement apart from its hash. A silent close through a documented
        # door is the same defect as a silent close, and it is the door an agent
        # reads the error message to find.
        #
        # `--force` still reaches the close -- the escape has to exist, or a
        # leader cannot clear a card whose evidence is a phone call -- but it is
        # now a *recorded* override, named on the event beside the empty
        # evidence it stands for. That is the same treatment every other rule in
        # this verb gives `--force`, and it makes the store's one question
        # answerable: a `done` event with an empty `evidence` is either an old
        # row (before the field existed), or a close whose override is named on
        # it, or a close that should not have been permitted.
        overridden.append("evidence:empty")
    if args.to in ("blocked", "dropped") and not (args.reason or "").strip():
        die(f"REFUSED: moving to '{args.to}' requires --reason. "
            f"A blocker without a stated cause is a stall nobody can clear.", cls="form")
    ev = {
        "ts": now_iso(), "event": "dropped" if args.to == "dropped" else "moved",
        "actor": who, "channel": args.channel, "context_id": args.channel,
        "task": args.id,
        "from": t["status"], "to": args.to, "reason": args.reason or "",
        # T-0243: "submitted by its author" has to be answerable from the event
        # alone, so every move carries the owner as it stood *before* the move.
        # Without it a reader holding two `moved` rows and no fold cannot tell a
        # submission from an approval -- and the fold is the thing a
        # disagreement about the card's history would be argued from.
        "owner": owner,
        "actor_kind": kind,
    }
    # T-0251. The measurement travels with the close, not only in the terminal it
    # was typed into. Present only on the edge it governs: a `doing -> review`
    # move has no acceptance decision in it, and a key that appears on every move
    # is a key no reader can use to find the closes.
    if args.to == "done":
        ev["evidence"] = args.evidence or ""
        # The accept the closer was looking at, frozen onto the event. The card's
        # line can be edited afterwards (`aim task edit --accept`), and "which
        # sentence was this close measured against" then has no answer anywhere in
        # the record -- the same before/after problem `edited` events carry
        # `from`/`to` for (T-0246).
        ev["accept"] = accept
    # T-0221's second clause: the one flag that overrides a rule is the one act
    # the store did not record, so a forced move and an ordinary move were
    # byte-identical rows apart from their hashes. `forced` is present only when
    # `--force` was actually spent on something -- a `--force` on a move that no
    # rule would have stopped is not an override, and marking it as one would
    # make the flag mean "the caller was nervous".
    if args.force and overridden:
        ev["forced"] = True
        ev["overrode"] = overridden
    elif args.force:
        ev["force_unused"] = True
    _append_task_event(args.channel, ev)
    print(f"{args.id}: {t['status']} -> {args.to}")
    if ev.get("forced"):
        print(f"  FORCED: overrode {', '.join(overridden)} — the reason and the "
              f"overridden rule are on the event, not only in this line")


def cmd_task_assign(args):
    """Hand a card to somebody, or hand it back to the pool.

    `--owner ""` is the release, and it is the other half of T-0226 rather than
    a convenience: the leader's rule makes a card pickable by anyone, and a card
    taken by a session that then dies would be parked on an id nobody else may
    write -- the exact state the rule was written to remove. Releasing is
    `assign` to nobody rather than its own verb, because a release *is* an
    assignment record with an empty owner, and the fold already reads
    `assigned` that way.

    A release must state a reason, for the reason `move --to blocked` must: an
    unowned card with no recorded cause is indistinguishable from a card nobody
    ever took, and "why is this back in the pool" is the question the next
    claimer needs answered.

    Both directions take the same gate, and it is the one `T-0226` above already
    names: the card's owner, its creator, or the leader. A reassignment is a
    change to whose commitment the card is, and a release is stronger -- it ends
    the commitment outright. Measured on a throwaway root with a published card
    owned by `b` and created by `b`: `task assign --as a --owner a` gave
    `owner b -> a`, rc 0, and `--owner ""` gave `owner a -> (unowned)`, rc 0, so
    a bystander could take a peer's card and then return it to the pool with no
    `--force` and nothing on the event saying an override happened. Compare the
    neighbours, which all refuse a non-owner and name `--force` as the recorded
    way past: `edit` (`cmd_task_edit`), `retract` (`cmd_task_retract`), and the
    two `task move` actor rules. `claim` is not among them because it is the
    inverse -- it only acts on an unowned card, and its refusal names *this*
    verb as the way to take one that is held.

    This is not the leader's exemption being withdrawn: `kind == "human"` skips
    the gate, as everywhere else the fabric has an acting-owner rule, because
    the leader is the one seat that has to be able to unstick a card whose owner
    has gone.
    """
    who, kind = resolve_actor(args)
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    if kind != "human" and who not in (t.get("owner"), t.get("created_by")):
        if not args.force:
            die(
                f"REFUSED: {args.id} is owned by '{t.get('owner') or '(unowned)'}' and was "
                f"created by '{t.get('created_by') or '?'}'; '{who}' is neither.\n"
                f"Taking a card somebody else holds is a reassignment, not a "
                f"correction: the owner is the agent who owes the work, so moving "
                f"it silently moves a commitment, and releasing it "
                f"(`--owner \"\"`) ends that commitment outright. Both are "
                f"recorded as an `assigned` event whose whole content is a field "
                f"somebody else set.\n"
                f"If it is yours to take, its owner can hand it over, or state "
                f"the reason with --force and the override is recorded with the "
                f"owner it overrode.",
                cls="barrier",
            )
        overrode_owner = t.get("owner") or ""
    else:
        overrode_owner = ""
    owner = (args.owner or "").strip()
    if not owner:
        if not (args.reason or "").strip():
            die(
                f"REFUSED: releasing {args.id} requires --reason. "
                "A card returned to the pool with no stated cause is a stall "
                "nobody can clear.",
                cls="form",
            )
        if not t["owner"]:
            print(f"{args.id} is already unowned")
            return
        _append_task_event(args.channel, {
            "ts": now_iso(), "event": "assigned", "actor": who, "channel": args.channel,
            "context_id": args.channel,
            "task": args.id, "owner": "", "from": t["owner"], "via": "release",
            "reason": args.reason,
            **_override_fields(args, overrode_owner),
        })
        print(f"{args.id}: owner {t['owner']} -> (unowned): {args.reason}")
        return
    if agent_kind(owner) is None:
        die(f"REFUSED: owner '{owner}' is not a registered agent", cls="form")
    _append_task_event(args.channel, {
        "ts": now_iso(), "event": "assigned", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "owner": owner, "from": t["owner"],
        **_override_fields(args, overrode_owner),
    })
    print(f"{args.id}: owner {t['owner'] or '(unowned)'} -> {owner}")


def _override_fields(args, overrode_owner):
    """The three keys a `task` event carries when `--force` was actually spent.

    Spelled once because `assign` has two write paths (hand over, release) and a
    flag recorded on one of them is a flag a reader cannot use: T-0221's clause,
    which `cmd_task_move` already implements inline, is that a forced act and an
    ordinary one must not be byte-identical rows. A `--force` on an act no rule
    stopped is not an override, so it is recorded as `force_unused` rather than
    as `forced` with an empty `overrode`.
    """
    o = (args.reason or "").strip()
    if args.force and overrode_owner:
        return {"forced": True, "overrode": [f"owner:{overrode_owner}"]}
    if args.force:
        return {"force_unused": True}
    if overrode_owner and o:
        # Unreachable by construction: the gate refuses a non-owner without
        # `--force`, so `overrode_owner` is non-empty only on a forced path.
        # Named rather than left silent, in the shape `_refuse_stray_task_event`
        # uses, because a dead branch that looks live is how the next reader
        # writes a test that cannot fail.
        die("INTERNAL: an unforced override was recorded on a task event",
            cls="form")
    return {}


def cmd_task_edit(args):
    """Correct the metadata on an existing card. T-0235.

    A card's `milestone` was written once, by `task new`, and no verb could ever
    change it -- so a card filed under the wrong milestone was there for good,
    and the milestone's denominator absorbed unrelated work. The case that made
    this concrete is T-0235's own card: it sits in M2, whose accept line is
    "N agents in one room, ordered, no lost message under 12 concurrent
    writers", while the card is about a `bin/aim` verb. `reports.milestones`
    (`aimboard/fold.py:293`) counts every card whose `milestone` equals the id,
    so M2's `total` was one card larger than M2's sentence has anything to do
    with, and the only remedy was to hand-edit a hash-chained store.

    Scope is the closed list in `TASK_EDIT_FIELDS`, and the omissions are the
    point: `status` belongs to `move` (which owns the state machine and the
    evidence rules), `owner` to `assign`, `blocked_by` to `link`, `visibility`
    to `publish`. A general "edit anything" verb would be a second path around
    every gate those verbs enforce, which is the failure this fabric has
    measured often enough to have a name for it.

    An edit that changes nothing appends nothing. A row that records no change
    is not evidence of anything, and the store's value is that every record in
    it means something happened.
    """
    who, kind = resolve_actor(args)
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    if t["status"] == "dropped":
        die(f"REFUSED: {args.id} is dropped; a dropped task is a record, not a workspace",
            cls="form")
    # Only the card's owner, its creator, or the leader. Not the read rule --
    # `_load_task_or_die` has already let this caller see the card -- but a write
    # rule: a milestone is an appointment about who owes what by when, and a peer
    # that can re-file another agent's card can move work into a milestone it does
    # not own the acceptance of.
    if kind != "human" and who not in (t.get("owner"), t.get("created_by")):
        if not args.force:
            die(
                f"REFUSED: {args.id} is owned by '{t.get('owner') or '(unowned)'}' and was "
                f"created by '{t.get('created_by') or '?'}'; '{who}' is neither.\n"
                f"A milestone is an appointment about who owes what by when, so re-filing "
                f"another agent's card is a change to their commitment, not a correction "
                f"of it. `aim task claim` or `aim task assign` first, or ask the leader.",
                cls="barrier",
            )
        # T-0235, reported as measured (T-0241): the verb shipped with no
        # override, which made it unusable for the case that asked for it -- the
        # card whose owner had gone. The override is the same `--force` every
        # other barrier refusal here takes, and it is recorded with the owner
        # whose appointment is being overridden, because an unrecorded override
        # of somebody's commitment is the act this record cannot afford to lose.
        overrode_owner = t.get("owner") or ""
    else:
        overrode_owner = ""
    changes = []
    for field in TASK_EDIT_FIELDS:
        new = getattr(args, field, None)
        if new is None:
            continue
        if field == "tags":
            new = list(new)
        elif field == "estimate_pts":
            new = int(new)
        if t.get(field) == new:
            continue
        changes.append((field, t.get(field, ""), new))
    if not changes:
        # Not a refusal: the caller asked for a state that is already true, and
        # `channel add` already set the precedent that the no-op is reported
        # rather than performed. What must not happen is an event that records a
        # change which did not occur.
        print(f"{args.id}: nothing to change — "
              + ", ".join(f"{f}={getattr(args, f)}" for f in TASK_EDIT_FIELDS
                          if getattr(args, f, None) is not None))
        return
    ev = {
        "ts": now_iso(), "event": "edited", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id,
        # Every change carries its before and after. A `set` alone would leave a
        # reader unable to answer "was this card always in M2", which is the
        # question that made the verb necessary.
        "changes": [{"field": f, "from": old, "to": new} for f, old, new in changes],
        "reason": args.reason or "",
    }
    if overrode_owner:
        # Only when `--force` was actually spent on the owner rule: a `--force`
        # on an edit the caller was entitled to make is not an override, and
        # marking it as one would make the flag mean "the caller was nervous"
        # (the reading `task move` uses for the same field).
        ev["forced"] = True
        ev["overrode"] = [f"owner:{overrode_owner}"]
    _append_task_event(args.channel, ev)
    print(f"{args.id}: " + ", ".join(
        f"{f} {old or '(unset)'} -> {new or '(unset)'}" for f, old, new in changes))
    if any(f == "milestone" for f, _, _ in changes):
        # The denominator this verb exists to correct, stated at the moment it
        # moves, so the reader does not have to go and compute it. This is the
        # measurement T-0235 was written from: `reports.milestones.<M>.total` is
        # a count of cards whose `milestone` equals M, so exactly one card moves
        # between two denominators here.
        was = next(old for f, old, _ in changes if f == "milestone")
        now = next(new for f, _, new in changes if f == "milestone")
        print(f"  milestones: {args.id} moves from {was or '(none)'} to {now or '(none)'} "
              f"— one card leaves one denominator and joins another")


def cmd_task_publish(args):
    who, kind = resolve_actor(args)
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    if t["visibility"] == "published":
        print(f"{args.id} is already published")
        return
    phase = m["barrier"]["phase"]
    ev = _append_task_event(args.channel, {
        "ts": now_iso(), "event": "published", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "reason": args.reason or "",
    })
    # Publishing during a divergence phase is the one deliberate act that exposes
    # a work item to a peer while the barrier is supposed to be closed, and until
    # codex ran a barrier audit over it, nothing the audit *reads* knew it had
    # happened. The `published` event in the task store was the only trace, so
    # "read the ledger, count the refusals" could not tell a channel where nobody
    # leaned on the barrier from one where an agent opened a draft to its peer.
    # The ledger is where README §3 says that question gets answered, so the
    # answer goes there: a leak is not a refusal, and it is not a `task.published`
    # line, it is its own event class.
    if phase in DIVERGENCE_PHASES:
        with Lock(channel_dir(args.channel) / ".ledger.lock"):
            append_chained(channel_dir(args.channel) / "ledger.jsonl", {
                "ts": ev["ts"], "event": "task_published_during_divergence",
                "agent": who, "action": "task publish", "phase": phase,
                "class": "barrier", "task": args.id,
                "reason": args.reason or "",
                "visibility_written": "published",
            })
        print(f"{args.id} published DURING {phase} — it is now readable by every "
              f"participant in {args.channel}, and this is recorded in the ledger as "
              f"a barrier event")
        return
    print(f"{args.id} published — it is now readable by every participant in "
          f"{args.channel}, and the act is on the record")


def _dependency_reaches(board, start, target):
    """The chain of ids from `start` to `target` through `blocked_by`, or None.

    A path, not a boolean, because the refusal has to name both ends *and* the
    route between them: T-0221 measured two cards that each refused to close
    while no row on the board said they blocked each other, so "these two block
    each other" is the sentence the caller needs, and it is only derivable while
    the cycle is being refused.

    Walked over the fold's live `blocked_by` lists, so it sees the same graph
    the `done` gate reads. The visited set is what terminates it on a graph that
    already contains a cycle -- one written by hand, or by a build older than
    this check -- because a cycle check that itself hangs on a cycle is a tool
    that cannot report the fault it exists to find.
    """
    stack = [(start, [start])]
    seen = set()
    while stack:
        node, path = stack.pop()
        if node == target:
            return path
        if node in seen:
            continue
        seen.add(node)
        for dep in board.get(node, {}).get("blocked_by") or []:
            stack.append((dep, path + [dep]))
    return None


def cmd_task_link(args):
    """Record a dependency edge, and refuse one that would close a cycle.

    T-0221: `link a --blocked-by b` was accepted when `b` was already blocked by
    `a`, and the result was two cards that each refuse `done` while every row on
    the board shows one blocker id -- so the deadlock was invisible and the only
    escape was `--force`, whose use the store did not record. A cycle is not a
    dependency with a strange shape; it is a statement that neither card can
    ever be finished, which is why it is refused at the edge rather than
    diagnosed at the `done` gate.
    """
    who, kind = resolve_actor(args)
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    if args.blocked_by not in board:
        die(f"REFUSED: no such task to depend on: {args.blocked_by}", cls="form")
    if args.blocked_by == args.id:
        # The length-one cycle, kept as its own refusal because the message for
        # a two-card cycle reads oddly for one card.
        die("REFUSED: a task cannot block itself", cls="form")
    # Would the *dependency* already reach back to the card? `T-0001 blocked_by
    # T-0002` closes a cycle exactly when T-0002 can already reach T-0001.
    path = _dependency_reaches(board, args.blocked_by, args.id)
    route = " -> ".join([args.id] + path) if path else ""
    if path and not args.force:
        die(
            f"REFUSED: {args.id} blocked_by {args.blocked_by} would close a cycle "
            f"({route}).\n"
            f"Each card would block the other, so neither could ever reach done, and "
            f"nothing on the board would say so: every row names one blocker. Record "
            f"the real dependency, drop the edge that is wrong, or mean it: --force "
            f"writes the edge *and* the cycle onto the event.",
            cls="form",
        )
    ev = {
        "ts": now_iso(), "event": "linked", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "blocked_by": args.blocked_by,
        # The verdict travels with the event, so a reader of the store alone can
        # tell an edge that was checked from one written by a build that did not
        # check -- which is the whole difference between the defect and the fix.
        # A third value rather than a boolean, so the rows already written keep
        # the meaning they were written with.
        "cycle_check": "forced" if path else "clean",
    }
    if path:
        # T-0221's second clause, spent on the edge rather than on the move. The
        # cycle is what makes both cards unclosable, and it is derivable only
        # from a route no board row carries: each row names one blocker, so the
        # deadlock is invisible unless the route is written down at the moment
        # somebody asserts it. `_dependency_reaches` returns the path for
        # exactly this, and this is where it is spent.
        ev["forced"] = True
        ev["cycle"] = route
    _append_task_event(args.channel, ev)
    print(f"{args.id} blocked_by {args.blocked_by}")
    if path:
        print(f"  FORCED: this edge closes a cycle ({route}); neither card can now "
              f"reach done, and the cycle is on the `linked` event, not only here")


def cmd_task_comment(args):
    who, kind = resolve_actor(args)
    body = free_text_body(args)
    if not body.strip():
        die("need --body or --body-file", cls="form")
    m, board, t = _load_task_or_die(args.channel, args.id, who, kind)
    _append_task_event(args.channel, {
        "ts": now_iso(), "event": "commented", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "body": body,
    })
    print(f"comment on {args.id} ({len(body)} chars)")


def cmd_task_retract(args):
    """Undo a `created` that should not have happened, without editing history.

    This exists because of a real accident. On 2026-09-22 a from-scratch channel
    allocated T-0001 while `plan/plan.json` already seeded T-0001..T-0155, and the
    merged board then drew the plan's "Freeze the PM contract" card under a draft
    called "Fix Kanban filtering". The id collision is fixed at the allocator
    (`_plan_id_floor`), but the event was already in a hash-chained file, and
    this fabric has exactly one repair policy: **never edit a chain**. Editing
    `tasks.jsonl` to remove the line would leave every later record's `prev`
    pointing at a hash that is no longer in the file -- a chain that `aim verify`
    reports as TAMPER, for a repair someone performed deliberately. `verify` is
    the thing that makes the log evidence, so a repair that breaks it is not a
    repair.

    So the repair is an append: a `retracted` event, which both folds read as
    "stop drawing this card". The `created` event stays in the file, the chain
    stays intact, and a reader can still see exactly what happened and who did
    it. Refusing when the task is not in the store keeps the event stream honest:
    a retraction of something that was never created would be a record of an act
    that had no effect.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if kind != "human" and who not in m["participants"]:
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    if kind != "human":
        # Not a barrier rule -- a `created` event is already visible to its own
        # creator, and retracting it discloses nothing new. It is an ownership
        # rule: a task is retracted by whoever would have owned it.
        t = fold_tasks(args.channel).get(args.id)
        if t is not None and t.get("created_by") != who and t.get("owner") != who:
            die(f"REFUSED: {args.id} was created by '{t.get('created_by') or '?'}'; "
                f"only its creator or the leader may retract it.", cls="barrier")
    if args.id not in fold_tasks(args.channel):
        die(f"REFUSED: no such task in {args.channel}'s store: {args.id}\n"
            f"Retraction appends to the store, so it can only name a card the "
            f"store itself holds. A plan seed is the plan's, not the store's.",
            cls="form")
    if not (args.reason or "").strip():
        die("REFUSED: retracting a task requires --reason. It removes a card from "
            "every view, and the record of why is the only thing that makes it "
            "auditable rather than a silent disappearance.", cls="form")
    _append_task_event(args.channel, {
        "ts": now_iso(), "event": "retracted", "actor": who, "channel": args.channel,
        "context_id": args.channel,
        "task": args.id, "reason": args.reason,
    })
    print(f"{args.id} retracted — the created event stays in the chain, and the "
          f"board no longer draws it")


def cmd_task_list(args):
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    board = fold_tasks(args.channel)
    phase = m["barrier"]["phase"]
    rows = []
    withheld = 0
    for tid in sorted(board):
        t = board[tid]
        if not _visible_to(t, who, phase) and kind != "human":
            withheld += 1
            continue
        if args.owner and t["owner"] != args.owner:
            continue
        if args.status and t["status"] != args.status:
            continue
        if args.milestone and t["milestone"] != args.milestone:
            continue
        rows.append(t)
    if args.count_hidden:
        # The one shape of this read that is not a refusal, because it answers a
        # question that does not require reading a peer's work: how much work is
        # there. Counts, never titles — the same thing the renderer's gate emits.
        print(json.dumps({"visible": len(rows), "withheld": withheld,
                          "phase": phase, "channel": args.channel}))
        return
    # `[]` and "there is no work here" were the same bytes. Codex read
    # `task list --json` on a channel with nine items in it, got `[]`, rc=0 and
    # no ledger line, and the only thing wrong with that answer is that it was
    # false. A caller cannot tell a withheld board from an empty one, which is
    # the well-formed-file-missing-a-fact failure this project has a name for.
    #
    # My first version of this fix refused only when *nothing* was visible, and
    # returned the visible subset with a note on stderr otherwise. That is not
    # the contract: design/05 §5 says the read is refused and recorded, and a
    # JSON consumer that parses stdout cannot see a stderr note, so the array
    # still reads as "this is the whole board". Codex's contract suite caught it
    # (`task list --json` -> rc=0 on a channel holding one draft owned by
    # someone else). The rule is now the one the note froze: while the barrier
    # is closed, asking for a peer's draft through this verb is refused and
    # recorded, and `--count-hidden` is how you ask for the size without the
    # contents. `--owner <yourself>` is exempt, because a result that can only
    # contain your own rows cannot leak a peer's.
    # Two things this pair of lines got wrong, both measured on the live fabric
    # with a viewer who was registered but not a participant of the channel.
    #
    # First, the exemption was ANDed with channel membership, so it could never
    # fire for the registered non-participant -- the "stranger" case this file
    # documents at length -- while the refusal underneath recommended
    # `--owner <the viewer>`, a remedy that returned the identical refusal. The
    # rule the comment above states is about the *result*, not the caller's
    # standing: a result that can only contain the viewer's own rows cannot
    # leak a peer's, and that argument does not depend on membership. So the
    # exemption is "the requested owner is the caller", and the caller being
    # registered is already guaranteed -- `resolve_actor` refuses an unknown id
    # before this line runs -- which is exactly why membership was never doing
    # any work here.
    #
    # Second, the count came from the post-filter result set, so it tracked the
    # *requested* owner rather than the caller: the same viewer asking three
    # different owners got three different claims about what they owned
    # (measured: `--owner codex-orangement` -> 23, `--owner claude-session1`
    # -> 21, `--owner codex` -> 1, in one channel, from one seat). A number in
    # a refusal is evidence. It may not move when the caller changes a filter,
    # so it is computed from the viewer's own rows.
    viewer_registered = agent_kind(who) is not None
    self_read = args.owner == who and viewer_registered
    if withheld and not self_read:
        mine = sum(1 for t in board.values() if t.get("owner") == who)
        me = f" (you own {mine} work item(s) in this channel)" if mine else ""
        die(
            f"REFUSED: {withheld} work item(s) in '{args.channel}' are drafts owned by "
            f"someone else, and the channel is in {phase}{me}.\n"
            f"Reading a peer's work item before cross-examination is the board's "
            f"version of reading their private log. Use --count-hidden for the counts "
            f"without the titles, --owner {who} for your own work, or wait for "
            f"CROSS_EXAMINE.",
            cls="barrier",
        )
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    if not rows:
        print(f"aim: no visible work items in '{args.channel}'"
              + (f" matching those filters" if (args.owner or args.status or args.milestone) else ""))
        return
    for t in rows:
        badge = "" if t["visibility"] == "published" else "  [draft]"
        block = f"  blocked_by={','.join(t['blocked_by'])}" if t["blocked_by"] else ""
        due = f"  due={t['due']}" if t["due"] else ""
        # `owner: ""` printed as blank is a column a reader cannot tell from a
        # bug; T-0227 does the same marking on the board renderer. The word is
        # long for the column, so the id stays in its place and only the field
        # widens -- an unowned card must be *findable*, which is the whole point
        # of making it readable.
        print(f"{t['id']}  {t['status']:<8} {(t['owner'] or '(unclaimed)'):<16} "
              f"{t['priority']:<6} {t['title'][:52]}{badge}{block}{due}")
    if withheld:
        # Counted, never shown: a board that quietly omits rows is a board that
        # lies about the size of the project.
        print(f"\n({withheld} more work item(s) exist in this channel and are not visible "
              f"to you in {phase})")


# --------------------------------------------------------------------------
# rooms: the write side `aimboard` has been reading a hand-written file for
# --------------------------------------------------------------------------
# design/06 §1 defines a room as `channels/<ch>/rooms/<room>.jsonl`, "same
# chaining, same flock, no quota, never a barrier", and §2 says a room created
# while the parent channel is in a divergence phase is a draft room whose
# messages are readable "by their author and by the leader, and by nobody else",
# opened early by `aim room publish` -- "deliberate, recorded, and visible on
# the board as an event".
#
# Until now there was no writer at all. Measured by T-0219: `aim --help` had no
# `room` verb, `rooms/` did not exist in any live channel, and the only way to
# set a room's `visibility` field was to write the JSON by hand -- which is
# neither recorded nor on the board. The gate in `aimboard/gate.py` then read
# that hand-written string, so the deliberate act and the accident were the same
# bytes on disk.
#
# The rule that replaces it is provenance, and it is the rule `task publish`
# already follows (design/05 §1): a `visibility` value with no recorded event
# behind it is inert. See `_room_published` for the reader half.
def rooms_dir(ch):
    return channel_dir(ch) / "rooms"


def room_events(ch, rid):
    """Every message in a room, in order. An absent room is an empty list."""
    return read_jsonl(rooms_dir(ch) / f"{rid}.jsonl")


def _room_author(meta, msgs):
    """A room's author: the agent who *opened* it. The rule is imported, not copied.

    Hoisted out of `_load_room_or_die` for T-0024's `search`, and the hoist is
    the point rather than tidiness: a searcher that re-derived "which rooms may
    this caller read" would be a second implementation of the gate, which is the
    failure this repo keeps measuring. `_load_room_or_die` and `cmd_room_list`
    already had two copies of these four lines; the search asks the same
    question a third time, so the rule now has one home and three callers.

    T-0249 moved that one home *out of this file* entirely. The rule here used to
    be "the author is whoever wrote the messages, and a room with two attributed
    voices has no author at all" -- fail-closed in appearance and, in effect, the
    opposite: `aim room publish` and the draft gate are both author-exempted by
    comparison with this value, so a room whose opener spoke and then heard a
    second voice (a human, who is exempt from the draft gate -- `_load_room_or_die`
    below) had no author, its opener could not read or publish it, and the
    *later* voice inherited the room by default. The room's own creation message
    promised "readable by you and the leader"; neither could read it.

    `aimboard.gate.room_author_from_metadata` decides now, and this function only
    supplies the evidence: the first attributed voice in the log, plus the
    `author`/`created_by` this tool wrote at creation (`cmd_room_new`). One rule,
    one home, two readers -- the board calls the same function, so "the CLI and
    the board disagree about who owns a room" is no longer expressible.
    """
    op = next((x.get("agent") for x in msgs if x.get("agent")), "")
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
        from aimboard.gate import room_author_from_metadata  # noqa: E402
    except Exception as exc:  # pragma: no cover - only on a broken checkout
        die(f"REFUSED: cannot decide who a room's author is: aimboard.gate did "
            f"not import ({exc}).\nThe room gate's author rule lives beside the "
            f"renderer that asks the same question, so a checkout missing that "
            f"module has two answers to 'who may read this room' and no way to "
            f"pick one.", cls="form")
    return room_author_from_metadata(meta, op)


def _room_or_channel_stranger(ch, who, kind, action):
    """Is this caller outside the room's channel without standing? A stranger.

    Two exemptions, and only two: a **participant** of the channel, and the
    channel's **leader**. `kind == "human"` alone is not standing -- the registry
    has more than one human in it, and `walled_off` (`aimboard/gate.py:24`) exempts
    *any* of them from the barrier because the leader is the audience. On the
    write side that exemption is a skeleton key: T-0249 measured a registered
    human who was neither a participant nor the leader reading a draft room's
    messages and publishing it, with the publish recorded in the ledger as a
    barrier event by an actor the channel had never admitted.

    Refused, and recorded -- the refusal is the ledger's evidence that the gate
    was tested, which is the point of recording it rather than printing a warning.
    """
    m = load_manifest(ch)
    if who in m.get("participants", []) or who == m.get("leader"):
        return False
    die(
        f"REFUSED: '{who}' is not a participant in '{ch}' and is not its leader "
        f"({m.get('leader') or '(unset)'}), so `{action}` is not an act '{who}' may "
        f"take in it.\n"
        f"A room inherits its channel's participants (design/06 §5.1), and being "
        f"registered -- or declaring yourself human -- is not the same as being in "
        f"the room. Ask the leader to `aim channel add --as {who}` first.",
        cls="barrier",
    )


def _room_withheld(ch, rid, who, kind, phase=None):
    """Would the room gate refuse this caller? The predicate, not the refusal.

    `_load_room_or_die` refuses; `cmd_room_list` and `cmd_room_list` alone used
    to *label* the same condition, and `search` is the third caller to need the
    second shape, so the rule is written once here and the two others ask it.
    A search that hid a room's text while `room list` announced it exists (or
    the reverse) would be the two-readers disagreeing about one rule, and the
    reader who is lied to would be the one holding the search output.
    """
    m = load_manifest(ch)
    if phase is None:
        phase = m["barrier"]["phase"]
    if who not in m["participants"] and who != m.get("leader"):
        return True
    if _room_published(ch, rid) or phase not in DIVERGENCE_PHASES:
        return False
    # The leader's exemption, and only the leader's: T-0249 measured a registered
    # human who was neither a participant nor the leader reading a draft room
    # through `room meta`, which is the label this predicate has to match.
    if who == m.get("leader"):
        return False
    msgs = room_events(ch, rid)
    return who != _room_author(read_json(rooms_dir(ch) / f"{rid}.json") or {"id": rid},
                               msgs)


def _load_room_or_die(ch, rid, who, kind):
    """The room and its metadata, with the barrier applied to the *record*.

    `author` is `_room_author`'s verdict -- the agent who opened the room -- and
    not "everyone who ever spoke in it" (T-0249). That is a correction, not a
    relaxation: the gate below is `who != author`, so a value of `""` refuses
    *every* non-human caller, including the agent the room belongs to. Reading
    the opener off the metadata (`cmd_room_new` writes `author`/`created_by`) and
    checking it against the log's first voice is what `aimboard.gate` does, and
    this file now imports that decision rather than restating it. A second voice
    therefore cannot evict the author, and the draft gate still refuses everyone
    else for as long as the phase is a divergence phase.
    """
    m = load_manifest(ch)
    _room_or_channel_stranger(ch, who, kind, "room")
    msgs = room_events(ch, rid)
    meta_path = rooms_dir(ch) / f"{rid}.json"
    meta = read_json(meta_path, None)
    if meta is None and not msgs:
        die(f"no such room: {rid}", cls="form")
    meta = meta or {"id": rid}
    author = _room_author(meta, msgs)
    published = _room_published(ch, rid)
    draft = not published
    # `kind != "human"` used to stand alone here, which read as "the leader is
    # exempt" and behaved as "anyone the registry calls human is exempt". The
    # exemption is the *leader's* -- they are the audience, not a participant --
    # and `_room_or_channel_stranger` above has already refused every other human.
    if draft and m["barrier"]["phase"] in DIVERGENCE_PHASES and who != m.get("leader"):
        if who != author:
            die(
                f"REFUSED: room '{rid}' in {ch} is a draft, the channel is in "
                f"{m['barrier']['phase']}, and you are not its author"
                f"{f' ({author})' if author else ' (the room records no author)'}.\n"
                f"A room is where two participants in a divergence phase would go to "
                f"agree on what they think, which is the leak design/06 §2 exists to "
                f"close. Read your own rooms, or ask the author to open it with "
                f"`aim room publish --id {rid}`.",
                cls="barrier",
            )
    return m, meta, msgs, published, author


def _record_room_event(ch, rid, ev):
    """Append a room event to the channel ledger, under the ledger lock.

    The ledger and not a file beside the room, because design/06 §2 asks for a
    publish that is "visible on the board as an event" and README §3 says the
    ledger is the artifact a barrier audit reads without opening anything else.
    It is also what makes the hand-written field inert: the publish fact lives
    somewhere a hand cannot reach without forging a hash-chained row.
    """
    with Lock(channel_dir(ch) / ".ledger.lock"):
        append_chained(channel_dir(ch) / "ledger.jsonl", ev)


def _room_published(ch, rid):
    """Was this room opened by a *recorded* act? The provenance rule.

    Returns the ledger row that published it, or None. Two facts are needed and
    neither alone is enough: the room's own `visibility: "published"` (what the
    renderer reads, and what a hand-edit can forge) and a `room_published` row
    naming this room (what only `aim room publish` writes).
    """
    for rec in read_jsonl(channel_dir(ch) / "ledger.jsonl"):
        if rec.get("event") == "room_published" and rec.get("room") == rid:
            return rec
    return None


def _room_cursor_advance(ch, rid, who, rec):
    """Move this reader's cursor to the message they just wrote.

    T-0219 clause 6: `aimboard/fabric.py:146` derives every room's `unread` from
    `rooms/<room>.cursors.json` and nothing wrote that file, so T-0181's "land on
    the first unread message" depended on a store with no writer. `say` is the
    writer, and it advances the cursor to the message the session just appended
    -- the only read position this fabric can honestly attest to. A cursor that
    tracked what the transport *pushed* would need a second channel back from the
    renderer, and a field claiming a session read a message it never received is
    the well-formed-empty-file failure this project keeps finding.

    Keyed by `last_hash` rather than an index, because that is the shape the
    reader parses and because a hash identifies a message in a log two writers
    appended to concurrently, where an ordinal identifies whatever is at position
    n now.
    """
    def _bump(cursors):
        cursors[who] = {"last_hash": rec["hash"], "at": rec["ts"]}
        return cursors
    update_json(rooms_dir(ch) / f"{rid}.cursors.json", _bump, {})


def cmd_room_new(args):
    """Create a named sub-log. Recorded, so it is on the board and in the ledger.

    The room is born a *draft* during a divergence phase, which is the whole of
    design/06 §2: "a room created while the parent channel is in a divergence
    phase is a draft room". The event is written to the ledger rather than the
    room directory because the room's existence is a fact about the channel, of
    the same kind as a membership change -- and `aim verify` covers the ledger
    already, so the new object inherits tamper-evidence instead of needing a
    mechanism of its own.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in m["participants"] and kind != "human":
        die(
            f"REFUSED: '{who}' is not a participant in '{args.channel}' and cannot "
            "open a room in it.\n"
            "A room inherits the channel's participants (design/06 §5.1: a room with "
            "its own membership is a channel with a worse barrier), so opening one is "
            "an act *in* the channel.",
            cls="barrier",
        )
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", args.id):
        # The id becomes a path component, so this is a form rule and a safety
        # rule at once: `../../etc/passwd` is not a room name.
        die(f"REFUSED: '{args.id}' is not a usable room id (letters, digits, . _ -; "
            f"64 chars max)", cls="form")
    if (rooms_dir(args.channel) / f"{args.id}.jsonl").exists() or \
            (rooms_dir(args.channel) / f"{args.id}.json").exists():
        die(f"REFUSED: room '{args.id}' already exists in {args.channel}", cls="form")
    phase = m["barrier"]["phase"]
    ts = now_iso()
    write_json(rooms_dir(args.channel) / f"{args.id}.json", {
        "id": args.id, "topic": args.topic, "author": who, "created_by": who,
        "created_at": ts, "channel": args.channel,
        "phase_at_creation": phase,
        # Written, and deliberately not load-bearing: the gate asks whether a
        # *recorded* publish exists, so this field states what the room is and
        # never what it may be read as. A hand-edit that flips it changes
        # nothing, which is the difference between this rule and the one
        # T-0219 measured.
        "visibility": "draft",
    })
    (rooms_dir(args.channel) / f"{args.id}.jsonl").touch()
    _record_room_event(args.channel, args.id, {
        "ts": ts, "event": "room_created", "agent": who, "action": "room new",
        "phase": phase, "class": "barrier", "room": args.id,
        "topic": args.topic,
        "draft": phase in DIVERGENCE_PHASES,
    })
    print(f"room '{args.id}' created in {args.channel} ({phase}) — "
          + ("a draft room: readable by you and the leader until "
             f"`aim room publish --as {who} --channel {args.channel} --id {args.id}`"
             if phase in DIVERGENCE_PHASES else "readable by the channel's participants"))


def cmd_room_say(args):
    """Append to a room, with the same flock and hash chain as a channel log.

    design/06 §1: "same chaining, same flock, no quota, never a barrier". So the
    message is appended under the channel's `.lock` with `append_chained` -- the
    one writer every other record in this fabric uses -- which is what makes
    `aim verify --channel` cover it. A room log written by a second mechanism
    would be a second chain with a second set of rules, and the whole point of
    putting rooms in `channels/<ch>/rooms/` was that they inherit the first one.

    Mentions are computed here rather than stored decoratively: `@<agent-id>` in
    the body produces the `mentions` list, which turns design/06 §1's "mentions
    instead" from a field three readers consulted and no writer produced into a
    fact about the message.
    """
    who, kind = resolve_actor(args)
    body = free_text_body(args)
    if not body.strip():
        die("need --body or --body-file", cls="form")
    _m, _meta, _msgs, _published, _author = _load_room_or_die(
        args.channel, args.id, who, kind)
    mentioned = sorted({x for x in re.findall(r"@([A-Za-z0-9._-]+)", body)
                        if agent_kind(x) is not None})
    rec = {
        "ts": now_iso(), "agent": who, "kind": args.kind or "note",
        "body": body, "mentions": mentioned,
    }
    if args.responds_to:
        rec["responds_to"] = args.responds_to
    with Lock(channel_dir(args.channel) / ".lock"):
        # Re-read under the lock and take the sequence number from it, exactly as
        # `cmd_say` does: the id has to be allocated inside the same critical
        # section as the append, or two writers both compute `len+1` and the
        # second one's message is the one that never happened.
        seq = len(read_jsonl(rooms_dir(args.channel) / f"{args.id}.jsonl")) + 1
        rec["id"] = f"r{seq:04d}"
        append_chained(rooms_dir(args.channel) / f"{args.id}.jsonl", rec)
    _room_cursor_advance(args.channel, args.id, who, rec)
    tail = f" (mentions {', '.join(mentioned)})" if mentioned else ""
    print(f"[{args.channel}/{args.id}] {rec['id']} {who} -> {rec['kind']}{tail}")


def cmd_room_publish(args):
    """Open a room to the channel's participants, deliberately and on the record.

    design/06 §2: "A participant may open it early with `aim room publish`, which
    is deliberate, recorded, and visible on the board as an event. Default
    closed, deliberately opened." The identical rule already exists for tasks
    (design/05 §1), so this verb is the room-shaped spelling of `task publish`
    rather than a new policy -- and it records in the same ledger, next to the
    phase rows a barrier audit already reads.

    Opening a draft is an act in the room's own channel, so the caller must be a
    participant of that channel or the leader: a self-declared human who is
    neither is a stranger, and `_room_or_channel_stranger` refuses them. That
    check used to be missing here and in `_load_room_or_die`, which made kind
    `human` a skeleton key -- a stranger could read a draft room's messages and
    then publish it, and the publish was recorded as a *barrier event* with an
    actor who was never in the room's channel. T-0249's second half. The read
    gate's human exemption now applies only to `m["leader"]`.
    """
    who, kind = resolve_actor(args)
    _room_or_channel_stranger(args.channel, who, kind, "room publish")
    m, meta, msgs, published, author = _load_room_or_die(
        args.channel, args.id, who, kind)
    if published:
        print(f"room '{args.id}' is already published "
              f"(by {published.get('agent')} at {published.get('ts')})")
        return
    if who != m.get("leader") and author and who != author:
        die(
            f"REFUSED: room '{args.id}' was opened by '{author}'; '{who}' may not "
            f"open it.\n"
            f"Publishing a room exposes its messages to every participant. Opening the "
            f"room is the decision of the agent who created it -- a second voice in the "
            f"room does not inherit it (T-0249).",
            cls="barrier",
        )
    phase = m["barrier"]["phase"]
    ts = now_iso()
    # The metadata field and the ledger row are written together, field first:
    # the field is what `aimboard` draws the room's badge from, and the ledger row
    # is what makes the field count. If the second write were lost the room would
    # revert to a draft, which is the fail-closed direction.
    meta = dict(meta, visibility="published", published_by=who, published_at=ts)
    write_json(rooms_dir(args.channel) / f"{args.id}.json", meta)
    _record_room_event(args.channel, args.id, {
        "ts": ts, "event": "room_published", "agent": who, "action": "room publish",
        "phase": phase, "class": "barrier", "room": args.id,
        "messages": len(msgs), "reason": args.reason or "",
        # `task publish` writes a distinct class when it happens in a divergence
        # phase (`task_published_during_divergence`), and the same distinction is
        # worth having here: a room opened while the barrier is shut is the
        # deliberate breach T-0219's clause 2 is about, and a reader auditing the
        # ledger must be able to count those without knowing the phase table.
        "barrier_open": phase not in DIVERGENCE_PHASES,
    })
    if phase in DIVERGENCE_PHASES:
        print(f"room '{args.id}' published DURING {phase} — its {len(msgs)} message(s) "
              f"are now readable by every participant in {args.channel}, and this is "
              f"recorded in the ledger as a barrier event")
        return
    print(f"room '{args.id}' published — it is now readable by every participant in "
          f"{args.channel}, and the act is on the record")


def cmd_room_list(args):
    """Which rooms exist, what the gate would show this viewer, and why."""
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    # A stranger used to be refused on the `kind != "human"` arm, so a registered
    # human who was neither a participant nor the leader listed every room in a
    # channel they were not in (T-0249). The standing is the leader's, not
    # everyone's whose registry row says human.
    _room_or_channel_stranger(args.channel, who, kind, "room list")
    phase = m["barrier"]["phase"]
    rows = []
    for path in sorted(rooms_dir(args.channel).glob("*.jsonl")):
        rid = path.stem
        meta = read_json(rooms_dir(args.channel) / f"{rid}.json") or {}
        msgs = read_jsonl(path)
        author = _room_author(meta, msgs)
        pub = _room_published(args.channel, rid)
        draft = not pub
        # Named, not implied: a reader who cannot see a room must be able to tell
        # "it does not exist" from "it exists and the gate is holding it", which
        # is the same distinction `task list --count-hidden` exists for. The
        # label has to be the read gate's own answer, so this asks
        # `_room_withheld` rather than restating the condition -- a `list` that
        # announced a room the caller then could not open would be the two
        # readers disagreeing about one rule (T-0249).
        withheld = _room_withheld(args.channel, rid, who, kind, phase)
        rows.append((rid, meta.get("topic", ""), len(msgs), draft, pub, author, withheld))
    if args.json:
        print(json.dumps([{"id": r[0], "topic": r[1], "messages": r[2],
                           "draft": r[3], "published_by": (r[4] or {}).get("agent", ""),
                           "author": r[5], "withheld": r[6]} for r in rows],
                         indent=2, ensure_ascii=False))
        return
    if not rows:
        print(f"aim: no rooms in '{args.channel}'")
        return
    for rid, topic, n, draft, pub, author, withheld in rows:
        state = ("published by " + pub["agent"] if pub else "draft")
        mark = "  [withheld from you]" if withheld else ""
        print(f"{rid:<16} {n:>4} msg(s)  {state:<24} by {author or '(unknown)'}  "
              f"{topic[:40]}{mark}")


def cmd_room_meta(args):
    """A room's own metadata, and the gate's verdict on the caller.

    `unread` here is honestly named `undrained`: this fabric keeps no read
    cursor for rooms (there is no `rooms/<room>.cursors.json` writer, T-0219
    clause 6), so there is nothing to derive "how many are unread" from. The
    count that *is* derivable is how many messages this viewer has not
    acknowledged in any way at all, and this verb does not pretend it is the
    other number -- a fabricated unread count is exactly the kind of
    well-formed-empty-file failure this project keeps finding.
    """
    who, kind = resolve_actor(args)
    m, meta, msgs, published, author = _load_room_or_die(
        args.channel, args.id, who, kind)
    out = dict(meta)
    out["messages"] = len(msgs)
    out["author"] = author
    out["published"] = bool(published)
    out["published_by"] = (published or {}).get("agent", "")
    out["phase"] = m["barrier"]["phase"]
    out["cursors"] = read_json(rooms_dir(args.channel) / f"{args.id}.cursors.json", {}) or {}
    for x in msgs:
        out.setdefault("mentions", {})
        for target in x.get("mentions") or []:
            out["mentions"][target] = out["mentions"].get(target, 0) + 1
    print(json.dumps(out, indent=2, ensure_ascii=False))


def _push_configs_path(ch=None):
    """Where the push notification configs live.

    Beside the work items rather than inside `manifest.json`, and the reason is
    a property of the object rather than taste: a config is created, read,
    listed, rotated and deleted, and every one of those is an append. A manifest
    is a read-modify-write, which is the lost update this project has already
    measured once (5 concurrent registrations, 1 survivor, well-formed file). The
    board keeps no board file for the same reason; neither does this.

    A channel's configs live in the channel's directory, so a config is subject
    to the same permissions as everything else in that channel and `aim verify`
    covers it with the rest of the channel's files.
    """
    return channel_dir(ch or _CTX.get("channel") or "") / "push.jsonl"


def _push_config_recs(ch=None):
    """Every config record on disk, newest state per config id.

    A fold rather than a list, because rotation and deletion are appends: a
    `doorbell_rotated` record does not erase the token it replaced, it supersedes
    it, and that is deliberate — the token that was in force during a window is a
    fact about that window, and a ledger that forgets it cannot answer "which
    secret was live when this was delivered". What a *read* returns is the
    current state; what is on disk is the history.
    """
    recs = read_jsonl(_push_configs_path(ch))
    live = {}
    for r in recs:
        cid = r.get("configId")
        if not cid:
            continue
        if r.get("event") == "deleted":
            live.pop(cid, None)
            continue
        live[cid] = r
    return recs, live


def cmd_task_doorbell(args):
    """The doorbell as a spec object: TaskPushNotificationConfig (T-0106).

    `bin/aim-doorbell-hook` is the doorbell and stays the default. It prints your
    unread outbox on your next turn, it is harness glue, and its own header says
    `aim` must not know how any harness wakes a session — moving it in here would
    be the daemon the design already rejected. This verb adds the *object* the
    design says the hook was missing: url, token, authenticationInfo, and the
    four operations addressed by a config id.

    Deliberately not the whole A2A surface. `validate_push_config` is shared with
    `aimboard/a2a.py`, which returns the same verdicts as `-32602
    fieldViolations` for a JSON-RPC client, so there is one implementation of the
    rules and two spellings of the answer. Writing the rule here and a second
    copy there is the failure this project keeps finding.

    The token is a secret in a store where every other refusal path reads files
    as root, and that is stated rather than implied: masking it on every read
    shape is defence against the *response*, not against the filesystem, and
    §13.2's "treat as secrets and rotate periodically" is served by the rotation
    verb and the mask rather than by a permission model this fabric does not have.
    """
    who, kind = resolve_actor(args)
    load_manifest(args.channel)               # refuses an unknown channel
    sub = args.doorbell_cmd

    def _module():
        """The translation, imported late so a broken `aimboard` costs one verb."""
        try:
            sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
            from aimboard.a2a import (validate_push_config, push_config_id,  # noqa: E402
                                      mask_secret)
            return validate_push_config, push_config_id, mask_secret
        except Exception as exc:  # pragma: no cover - only on a broken checkout
            die(f"REFUSED: cannot use the push notification object: aimboard.a2a "
                f"did not import ({exc}).\nThe config's shape is a translation of "
                f"a foreign spec and it lives beside the renderer; if that module "
                f"is missing, so is the translation.", cls="form")

    if sub == "create":
        validate, config_id_of, _ = _module()
        _, board, t = _load_task_or_die(args.channel, args.id, who, kind)
        config = {"taskId": args.id, "url": args.url, "token": args.token}
        auth = {}
        if args.scheme:
            auth["scheme"] = args.scheme
        if args.credentials:
            auth["credentials"] = args.credentials
        if auth:
            config["authenticationInfo"] = auth
        problems = validate(config)
        if problems:
            # The first line carries the field names, not just a verdict. The
            # ledger records `msg.split("\n")[0]`, and `_BARRIER_ERRORS` maps a
            # refusal onto an A2A error by matching a substring of *that* line — so
            # a refusal whose specific cause lives on line 2 is a refusal the
            # mapping table cannot see, and an unmappable refusal is one that
            # answers every client the same generic way. Caught by the T-0106
            # conformance check that reads the ledger back and looks for the field
            # it expected. [measured: with the detail only on line 2, the recorded
            # reason was "REFUSED: T-0001's push notification config is not usable."
            # and nothing downstream could tell which field was wrong]
            where = "; ".join(f"{field}: {why}" for field, why in problems)
            fields = ", ".join(field for field, _ in problems)
            die(f"REFUSED: {args.id}'s push notification config is not usable — {fields}\n"
                f"{where}\n"
                f"The object is the spec's (§4.3.1, §4.3.3, §13.2) and it is "
                f"refused rather than partly stored, because a config that is "
                f"half written is one that reports success and never fires.", cls="form")
        cid = config_id_of(args.id, config)
        recs, live = _push_config_recs(args.channel)
        if cid in live:
            # Idempotent on purpose. `push_config_id` is derived from the task and
            # the url and never from the token, so re-running this with a rotated
            # token would otherwise append a second config for one webhook and
            # the doorbell would ring twice.
            print(f"{args.id}: {cid} already configured for {live[cid]['url']}; "
                  f"the token was not changed (use --rotate)")
            return
        with Lock(channel_dir(args.channel) / ".lock"):
            append_chained(_push_configs_path(args.channel), {
                "ts": now_iso(), "event": "doorbell_created", "actor": who,
                "channel": args.channel, "context_id": args.channel,
                "task": args.id, "configId": cid, "url": args.url,
                "token": args.token,
                "authenticationInfo": auth or {"scheme": "Bearer",
                                               "credentials": args.token},
            })
        print(f"{args.id}: {cid} -> {args.url}  (token {_mask_hint(args.token)})")

    elif sub == "list":
        _, _, mask = _module()
        _, live = _push_config_recs(args.channel)
        rows = [r for r in live.values() if r.get("task") == args.id]
        if args.json:
            print(json.dumps([
                {"taskId": r["task"], "configId": r["configId"], "url": r["url"],
                 "token": r["token"] if args.show_token else mask(r["token"]),
                 "createdAt": r.get("ts", ""), "createdBy": r.get("actor", "")}
                for r in rows], indent=2, ensure_ascii=False))
            return
        if not rows:
            print(f"{args.id}: no push notification configs")
            return
        for r in rows:
            token = r["token"] if args.show_token else mask(r["token"])
            print(f"{r['configId']}  {r['url']}  token={token}  "
                  f"by {r.get('actor', '')} {r.get('ts', '')[:19]}")

    elif sub == "rotate":
        _, config_id_of, _ = _module()
        _, live = _push_config_recs(args.channel)
        cid = args.config_id
        if cid not in live:
            die(f"REFUSED: no push notification config '{cid}' on that task in "
                f"'{args.channel}'. `aim task doorbell --help` lists them.", cls="form")
        with Lock(channel_dir(args.channel) / ".lock"):
            append_chained(_push_configs_path(args.channel), {
                "ts": now_iso(), "event": "doorbell_rotated", "actor": who,
                "channel": args.channel, "context_id": args.channel,
                "task": live[cid]["task"], "configId": cid,
                "url": live[cid]["url"], "token": args.token,
                "previous_token_sha256": sha256_hex(str(live[cid]["token"]).encode()),
                "authenticationInfo": dict(
                    live[cid].get("authenticationInfo") or {}, credentials=args.token),
            })
        # The one verb that prints the new token, and it says so in its name:
        # §13.2 asks for rotation, and a rotation whose result the caller cannot
        # read has rotated nothing they can use.
        print(f"{cid}: token rotated ({_mask_hint(args.token)}) — this is the only "
              f"read shape that returns it, and it will not be printed again")

    elif sub == "delete":
        _, _, _ = _module()
        _, live = _push_config_recs(args.channel)
        cid = args.config_id
        if cid not in live:
            die(f"REFUSED: no push notification config '{cid}' on that task in "
                f"'{args.channel}'", cls="form")
        with Lock(channel_dir(args.channel) / ".lock"):
            append_chained(_push_configs_path(args.channel), {
                "ts": now_iso(), "event": "deleted", "actor": who,
                "channel": args.channel, "context_id": args.channel,
                "task": live[cid]["task"], "configId": cid,
                "url": live[cid]["url"], "token": "(removed with the config)",
                "reason": args.reason or "",
            })
        print(f"{cid}: deleted — §3.1.7's configuration no longer exists; the "
              f"record of it does, in {_push_configs_path(args.channel).name}")


def _mask_hint(secret):
    """A length and a digest prefix. Never the secret, never a fixed `***`.

    The same reasoning as `aimboard.a2a.mask_secret`, spelled here because
    `bin/aim` must not import the package at module load: a caller needs to tell
    "the token I just set" from "the token that was there", and `***` cannot.
    """
    return f"<masked:{len(str(secret))}b:sha256:{sha256_hex(str(secret).encode())[:12]}>"


def cmd_reveal(args):
    """Voluntarily disclose the reasoning behind one sealed claim.

    Full private logs stay private. You disclose what you choose, when you
    choose, and the disclosure is dated against the seal digest it came from.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    # T-0224 before the barrier, and the empty check after it.
    #
    # `--body <path>` is a statement about the command line, and a command line is
    # not in a phase: the writer meant `--body-file` whether the channel is sealed
    # or not, so the guard fires first and names that flag in every phase (pinned by
    # tests/test_body_path_guard.py). But "you gave me no body at all" is a claim
    # about a request that is otherwise *complete*, so it must not pre-empt the
    # barrier: a sealed channel asked to reveal something is refused by the barrier,
    # and the ledger has to record `class: barrier` -- evaluating the body first
    # turned a barrier refusal into a malformed-request refusal, which is the T-0222
    # defect wearing this verb's name. Both orders are wrong; the split is the fix.
    body = free_text_body(args)
    if m["barrier"]["phase"] not in ("CROSS_EXAMINE", "RESOLVE"):
        # `reveal` is the one verb whose entire purpose is to undo part of the
        # barrier deliberately, so the phase it is open in is the barrier's own
        # boundary rather than a formality about the command.
        die(f"REFUSED: reveal is only open from CROSS_EXAMINE on (now {m['barrier']['phase']})",
            cls="barrier")
    if not body.strip():
        die("need --body or --body-file", cls="form")
    seal = read_json(channel_dir(args.channel) / "seals" / f"{who}.json")
    if seal is None:
        # Not a barrier refusal: the seal is *yours*, so nothing here is withheld
        # from you, and no phase would make the request well-formed. It is a
        # missing precondition in the request, which is what `form` covers.
        die("you have no seal in this channel", cls="form")
    log = channel_dir(args.channel) / "log.jsonl"
    with Lock(channel_dir(args.channel) / ".lock"):
        seq = len(read_jsonl(log)) + 1
        append_chained(log, {
            "ts": now_iso(), "id": f"m{seq:04d}", "from": who, "kind": "disclosure",
            "subject": f"reveal: {args.claim_id}", "body": body, "evidence": [],
            "responds_to": "", "refs_seal": seal["digest"], "claim_id": args.claim_id,
            "round": m["barrier"]["round"], "phase": m["barrier"]["phase"],
        })
    print(f"revealed {args.claim_id} against seal {seal['digest'][:16]}…")


def cmd_push(args):
    """Drop a message in a peer's outbox. Transport-agnostic delivery.

    This is deliberately *not* the channel. The channel is the record; the
    outbox is the doorbell. A doorbell can be rung by any means available
    (shared file, another agent's hook, a human pasting it) without changing
    what was actually said and when.
    """
    who, kind = resolve_actor(args)
    body = free_text_body(args)
    if not body.strip():
        die("need --body or --body-file", cls="form")
    m = load_manifest(args.channel) if args.channel else None
    if args.channel and who not in m["participants"] and kind != "human":
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    if args.to not in load_registry()["agents"]:
        die(f"'{args.to}' is not a registered agent", cls="form")
    # ---- T-0147: the barrier's blind side -------------------------------
    # `say` is gated twice -- by the phase, and by the ledger that records the
    # refusal -- and this doorbell was gated by neither, so a *position* could
    # travel the fabric without ever meeting the barrier: outbox is the one path
    # a body takes that no `PHASE_RULES` entry names. The docstring above is
    # still right that the outbox is a doorbell and not the record. The repair
    # is not to gate the doorbell -- a doorbell that is refused is a broken
    # doorbell, and every ordinary "your mail arrived" push would stop -- but
    # to stop being silent about it. A push that carries a commitment meets the
    # gate a say would (so the position cannot pass), and a push that does not
    # is *recorded* in the ledger, so a position that travelled out-of-band is
    # at least findable by whoever audits the channel. `findable` is the shape
    # of the whole card: the failure was that the record could not tell "nobody
    # sent a position out-of-band" from "somebody did and nothing wrote it
    # down", which is the same unfalsifiable claim `_record_refusal` exists to
    # prevent on the refusal side.
    #
    # The ledger and not `friction.jsonl`, on T-0084's own division of the two
    # files: friction answers "the fabric got in the way" and is written by the
    # reader's own hand (`cmd_friction`'s docstring: "a note about the tool the
    # tool ran"), while a push-by-commitment is something that *happened* to the
    # channel and has to be countable without opening the doorbell that rang --
    # so it belongs where design/06 §2 put room publishes and where `aim audit`
    # already reads. It also means `aim verify` covers this event with the rest
    # of the channel's chain, which a record beside the outbox would not.
    #
    # `refs_seal` is the flag `cmd_say` treats as a commitment: it is what a
    # position points at to say *which* sealed reasoning it speaks for, and
    # `--kind` is the same vocabulary a say accepts (`position`/`claim`/
    # `concession`). Either on a push is a body that would have needed a phase
    # to be public, so the gate below is the same one `say` takes, with the same
    # text shape and the same class. No new class is invented; the CLI has no
    # `--refs-seal` on `push` today, so this is a documented contract for the
    # harness that forwards one, not a live path.
    carries_position = bool(getattr(args, "refs_seal", "") or
                            (getattr(args, "kind", "") or "") in COMMITMENT_KINDS)
    if carries_position and m is not None:
        # `load_manifest` above returns a manifest only when a channel was
        # named; with no channel there is no phase for anyone to have violated,
        # and the event below is recorded with `channel: ""` so the audit can
        # still find the push itself.
        gate(m, who, "channel_say")
    d = outbox_dir(args.to)
    d.mkdir(parents=True, exist_ok=True)
    ts = now_iso()
    # The id is derived from a microsecond timestamp and the sender, so two
    # writers never collide on a filename and therefore never share a .tmp path
    # either. write_json() lands atomically, so a message is either fully present
    # or absent — never half-written, which is the failure a reader can neither
    # detect nor recover from.
    msg_id = f"{ts.replace(':', '').replace('-', '')}-{who}"
    body_bytes = body.encode("utf-8")
    rec = {
        "msg_id": msg_id,
        "ts": ts, "from": who, "to": args.to, "channel": args.channel or "",
        "subject": args.subject or "", "body": body, "delivered_via": args.via or "",
        # Delivery alone cannot be verified by the delivery. These two fields are
        # what let the *recipient* prove to the sender that the bytes they hold
        # are the bytes that were sent — the difference between "a file exists in
        # my outbox" and "the message arrived intact".
        "bytes": len(body_bytes),
        "body_sha256": sha256_hex(body_bytes),
        "ack_required": bool(args.require_ack),
        # T-0242: the record names the *session* that sent it, because one agent
        # id can be held by two live sessions at once — measured: an id whose
        # registry entry reads `pts/7 claude pid 1697672` while another session
        # in the same workspace answered to it, and a message addressed to the id
        # reached both. `from` says who; this says which one.
        "from_session": session_of(),
    }
    write_json(d / f"{msg_id}.json", rec)
    # T-0147 clause 1: one ledger event per successful push, written whether or
    # not a channel was named. It names all five facts the card asks for --
    # sender, recipient, channel, msg_id, and that this was a push rather than a
    # say -- because `event: "push"` is the only field in the ledger that can
    # tell the two apart after the fact, and a reader auditing "did a position
    # travel around the barrier?" has to answer it from `refs_seal`/`kind` on a
    # row that exists rather than from the absence of a row, which is
    # indistinguishable from a push that never happened. Recorded after the
    # write, so the ledger never claims a delivery the outbox does not hold: the
    # failure mode of a crash between the two is an unrecorded push, and the
    # failure mode of the other order is a recorded push nobody can read.
    # `append_chained` is the same writer the room publishes and the refusals
    # use, so this row is covered by `aim verify --channel` for free.
    ch = args.channel or _CTX.get("channel")
    if ch:
        with Lock(channel_dir(ch) / ".ledger.lock"):
            append_chained(channel_dir(ch) / "ledger.jsonl", {
                "ts": ts, "event": "push", "agent": who, "session": session_of(),
                "to": args.to, "channel": ch, "msg_id": msg_id,
                "carries_position": carries_position,
                # `--via` is the sender's own account of how the bytes were
                # handed over (outbox is transport-agnostic by design), so it is
                # carried here verbatim and attributed to them rather than
                # checked: the ledger's job is to make the claim findable, not to
                # be able to confirm it.
                "via": args.via or "",
                "action": "push", "class": "record",
            })
    (d / f"{msg_id}.md").write_text(
        f"# message from {who} -> {args.to}\n"
        f"msg_id: {msg_id}\n"
        f"channel: {args.channel or '(none)'}\nsent: {ts}\nsubject: {args.subject or ''}\n\n"
        f"{body}\n\n---\n"
        f"Received it? Confirm with:\n"
        f"  aim confirm --as {args.to} --msg-id {msg_id}\n"
        f"Reply through the channel, not through this file:\n"
        f"  aim inbox --as {args.to} --channel {args.channel or '<channel>'}\n"
        f"  aim say   --as {args.to} --channel {args.channel or '<channel>'} ...\n",
        encoding="utf-8")
    print(f"outbox: {d}/{msg_id}.md  ({len(body_bytes)} bytes, sha {rec['body_sha256'][:12]}…)")


def outbox_dir(agent):
    return ROOT / "outbox" / agent


def _read_outbox(agent):
    d = outbox_dir(agent)
    if not d.exists():
        return []
    return [read_json(p) for p in sorted(d.glob("*.json"))]


def _verify_outbox_record(rec):
    """Returns None if intact, else a one-line description of the damage.

    Two generations of records exist. D4 added `bytes`/`body_sha256`; anything
    written before that carries no hash, so a checker that asks "do the bytes
    hash to the recorded value?" answers `no` for every old message and reports
    intact mail as damaged. Silence there is a safety *feature* — an unsigned
    message has not been shown to be corrupt, and crying wolf about it would
    make the real `DAMAGED` line mean nothing. `confirm` is where the absence
    becomes a refusal, because vouching for bytes you cannot check is a
    different act from displaying them.
    """
    body = rec.get("body", "")
    if not body.strip():
        return "empty body"
    b = body.encode("utf-8")
    if rec.get("body_sha256") and sha256_hex(b) != rec["body_sha256"]:
        return "body does not hash to the value recorded when it was sent"
    if rec.get("bytes") and len(b) != rec["bytes"]:
        return f"length is {len(b)} bytes, recorded as {rec['bytes']}"
    return None


def _receipt_verification(rec, b):
    """What a receipt for this record can honestly claim to have checked.

    Returns (refuse_reason_or_None, claim_lines). Two generations of records
    exist: D4 added `bytes`/`body_sha256`, and anything sent before it carries
    neither. A receipt is a message to the *sender* asserting what arrived, so
    for a legacy record it has to say the verification did not happen — the
    sender knows they did not hash it, and a receipt that claimed otherwise
    would be the one lie this mechanism exists to prevent. Refusing outright
    would be worse in the other direction: the mail is real, the sender is
    waiting, and "I cannot tell you anything" and "you sent me nothing" would
    look the same from over there.
    """
    damage = _verify_outbox_record(rec)
    if damage:
        return damage, []
    if not rec.get("body_sha256"):
        return None, [
            f"bytes: {len(b)} (as I received them; no length was recorded at send time)",
            "body sha256: (none — this message predates body hashes)",
            "verified: NOTHING. This message was sent before receipts could check "
            "anything, so this receipt tells you it arrived and how big it is. It "
            "does not tell you it is intact.",
        ]
    return None, [
        f"bytes: {rec.get('bytes')}",
        f"body sha256: {rec.get('body_sha256')}",
        "verified: the bytes I hold hash to the value recorded at send time",
    ]


def _outbox_id(path, rec):
    """The id to show for an outbox record.

    `msg_id` arrived with D4; mail sent before it has none, and the filename has
    always carried the same value. Reading the record is the right source when it
    is there, because the filename could have been renamed and the record could
    not. Falling back to the filename is not a guess about identity — it is the
    only identifier that generation of record has, and hiding those rows would
    make `outbox` silently under-report what was sent, which is the one thing it
    exists not to do.
    """
    return rec.get("msg_id") or path.stem


def cmd_confirm(args):
    """Acknowledge a specific delivered message.

    Delivery is not receipt. A file that appears in someone's outbox proves the
    sender wrote it; it proves nothing about whether a reader ever saw it. This
    closes that loop, and the acknowledgement is itself a message, so the sender
    learns about it through the same pull they already do.
    """
    who, kind = resolve_actor(args)
    # Match on the record's id or on the filename, because those are the same
    # value and only one of them existed before D4. A receipt request that push
    # printed for a legacy record names a filename; refusing it would make the
    # id in that header unconfirmable, and the sender would never learn anything.
    mine = []
    for path in sorted(outbox_dir(who).glob("*.json")) if outbox_dir(who).exists() else []:
        rec = read_json(path)
        if rec.get("msg_id") == args.msg_id or path.stem == args.msg_id:
            mine.append((path, rec))
    if not mine:
        die(f"no message '{args.msg_id}' in your outbox", cls="form")
    path, rec = mine[0]
    if rec.get("to") != who:
        die(f"'{args.msg_id}' was not addressed to you", cls="form")
    # Did you actually read it? A receipt that does not require a prior read is a
    # receipt for a file's existence. Codex produced exactly that in the first
    # live use of this command: it confirmed a push it had never pulled, so the
    # sender learned "you received it" from an agent that had not opened it. The
    # whole point of the receipt is that it means more than the file did.
    if not rec.get("claimed_at"):
        die(
            f"REFUSED: cannot confirm '{args.msg_id}' — you have not read it.\n"
            f"Read it first (aim pull --as {who} --claim), then confirm. A receipt "
            f"for an unread message tells the sender intact delivery happened when "
            f"what actually happened is that a file arrived.",
            cls="form",
        )
    damage, claims = _receipt_verification(rec, rec.get("body", "").encode("utf-8"))
    if damage:
        # Confirming a message you cannot vouch for is worse than silence: it
        # would let the sender believe intact delivery happened when it did not.
        die(f"REFUSED: cannot confirm '{args.msg_id}' — {damage}", cls="form")

    ts = now_iso()
    rid = f"{ts.replace(':', '').replace('-', '')}-{who}-receipt"
    receipt = {
        "msg_id": rid,
        "ts": ts, "from": who, "to": rec["from"], "channel": rec.get("channel", ""),
        "subject": f"RECEIPT for {args.msg_id}",
        "body": (f"{who} received {args.msg_id} from {rec['from']}.\n"
                 + "".join(line + "\n" for line in claims)
                 + f"acknowledged: {ts}\n"
                 + (f"note: {args.note}\n" if args.note else "")),
        "receipt_for": args.msg_id,
        "ack_required": False,
    }
    write_json(outbox_dir(rec["from"]) / f"{rid}.json", receipt)
    rec["acked_at"] = ts
    # A receipt is an act by a session, and the id it is filed under may be held
    # by more than one (T-0242): the sender reading `acked_at` is asking "who
    # vouched for this", which is not the same question as "which id".
    rec["acked_by_session"] = session_of()
    write_json(path, rec)
    print(f"receipt -> {rec['from']}: {args.msg_id} acknowledged at {ts}")


def cmd_outbox(args):
    """What have I sent, and what happened to it? Sent is not received."""
    who, kind = resolve_actor(args)
    reg = load_registry()["agents"]
    rows = []
    for peer in reg:
        if peer == who:
            continue
        d = outbox_dir(peer)
        for path in (sorted(d.glob("*.json")) if d.exists() else []):
            r = read_json(path)
            if r.get("from") != who:
                continue
            if args.peer and peer != args.peer:
                continue
            rows.append((peer, path, r))
    if not rows:
        print(f"aim: nothing sent by '{who}'")
        return
    rows.sort(key=lambda pr: pr[2]["ts"])
    print(f"{'msg_id':<26} {'to':<16} {'bytes':>6}  {'state':<9} written  claimed  acked")
    for peer, path, r in rows:
        state = "ACKED" if r.get("acked_at") else ("claimed" if r.get("claimed_at") else "sent")
        acked = r.get("acked_at", "—")
        print(f"{_outbox_id(path, r):<26} {peer:<16} {r.get('bytes', 0):>6}  {state:<9} "
              f"{r['ts'][11:19]}  {(r.get('claimed_at') or '—')[11:19]:>7}  "
              f"{(acked[11:19] if acked != '—' else '—'):>7}")
    unacked = [r for _, _, r in rows if r.get("ack_required") and not r.get("acked_at")]
    if unacked:
        print(f"\n{len(unacked)} message(s) demanded an ack and have not received one:")
        for r in unacked:
            print(f"  {r['msg_id']} -> {r['to']}")
        sys.exit(4)


def cmd_pull(args):
    """Read everything in your outbox, newest last, and mark it claimed."""
    who, kind = resolve_actor(args)
    d = outbox_dir(who)
    items = sorted(d.glob("*.json")) if d.exists() else []
    if not items:
        print(f"aim: outbox empty for '{who}'")
        return
    unread = []
    for p in items:
        rec = read_json(p)
        if not rec.get("claimed_at"):
            unread.append((p, rec))
    if args.unread_only and not unread:
        print(f"aim: nothing unread for '{who}' ({len(items)} claimed)")
        return
    show = unread if args.unread_only else [(p, read_json(p)) for p in items]
    # T-0146, design/06 R4: a claim follows a completed delivery of the complete
    # output, never a buffered or per-record print. Python ignores SIGPIPE, so a
    # pull piped into a consumer that stops early (head, a closed shell, `| true`)
    # would let per-record prints succeed into the pipe buffer and the loop keep
    # going; claiming on the authority of a buffered write marks a message *read*
    # that never left this process, and `confirm` then accepts an ack for it.
    # So build the whole transcript first, emit it in one write+flush, and claim
    # only if that flush succeeds. A partial read gets no partial credit — R4's
    # word: a false "read" costs an ack the sender trusts, while a repeated read
    # costs one `pull`.
    parts = []
    for _, rec in show:
        parts.append(f"=== from {rec['from']} @ {rec['ts']}  channel={rec['channel'] or '-'}"
                     f"  msg_id={rec.get('msg_id', '(none)')}\n")
        if rec.get("subject"):
            parts.append(f"    subject: {rec['subject']}\n")
        # Integrity first: a message you cannot trust is worse than a missing one,
        # because you will act on it.
        damage = _verify_outbox_record(rec)
        if damage:
            parts.append(f"    !!! DAMAGED: {damage}\n")
        parts.append("    " + rec["body"].replace("\n", "\n    ") + "\n")
        if rec.get("ack_required") and not rec.get("acked_at"):
            parts.append(f"    >>> the sender asked for an ack: "
                         f"aim confirm --as {who} --msg-id {rec.get('msg_id')}\n")
        parts.append("\n")
    delivered = False
    try:
        sys.stdout.write("".join(parts))
        sys.stdout.flush()
        delivered = True
    except BrokenPipeError:
        # The reader closed before the complete output left the process, so claim
        # NONE of it. Point the real fd at devnull instead of closing sys.stdout:
        # the interpreter flushes stdout once more at exit, and a close-flush on a
        # broken pipe would raise again (BrokenPipeError is what we are in). dup2
        # gives that shutdown flush a target that cannot fail, so the run reports
        # the failure once and exits non-zero with no traceback — R4 point 4.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    claimed = 0
    if args.claim and delivered:
        for p, rec in show:
            if not rec.get("claimed_at"):
                rec["claimed_at"] = now_iso()
                # Which session read it (T-0242). `claimed_at` alone cannot say,
                # and a shared id is exactly the case where two sessions would
                # each believe the claim was theirs; the reader that finds one
                # claim row needs to know which session made it.
                rec["claimed_by_session"] = session_of()
                write_json(p, rec)
                claimed += 1
    if not delivered and unread:
        print(f"\nnote: the output did not reach the reader ({len(unread)} message(s)"
              f" not delivered); claimed 0", file=sys.stderr)
        sys.exit(1)
    if args.claim and claimed:
        print(f"claimed {claimed} message(s)")


def cmd_nudge(args):
    """Print the shortest thing you can hand a peer session to get it in."""
    m = load_manifest(args.channel)
    print(f"""A file-first agent IM is running in this workspace. `aim` is on PATH.

  cd /root/tmp/agent-im
  cat AGENTS.md            # the rule that matters, 40 lines
  aim status  --channel {args.channel}
  aim pull    --as {args.peer} --claim     # read what was sent to you

You are '{args.peer}' in channel '{args.channel}', currently
{m['barrier']['phase']}. Before you read anyone else's reasoning, write down
your own:

  aim seal --as {args.peer} --channel {args.channel} --summary "<your position>" --claims <file.json>

A `claims` file is a JSON list of {{id, claim, confidence, kill_if}} — `kill_if`
is the observation that would make you drop the claim. Then read
channels/{args.channel}/seals/ and argue.

Reply through the channel, not through whatever delivered this message.
""")


def _tokens(text):
    stop = {
        "the", "a", "an", "and", "or", "of", "to", "in", "is", "it", "that", "this",
        "for", "on", "as", "at", "be", "by", "with", "from", "are", "was", "were",
        "not", "but", "if", "then", "than", "so", "we", "you", "i", "they", "it's",
        "can", "cannot", "will", "would", "could", "should", "do", "does", "did",
        "have", "has", "had", "what", "which", "who", "when", "where", "how", "why",
        "one", "two", "there", "their", "its", "my", "our", "your", "about", "into",
        "more", "most", "less", "least", "only", "also", "just", "some", "any",
        "all", "no", "yes", "up", "out", "over", "under", "again", "very", "own",
        "same", "other", "such", "nor", "too", "each", "both", "few", "many", "much",
    }
    return [w for w in re.findall(r"[a-z][a-z'\-]+", text.lower()) if w not in stop and len(w) > 2]


def _tfidf_cosine(texts):
    """Cosine similarity of tf-idf vectors. Pure python, no deps."""
    import math
    from collections import Counter
    docs = [Counter(_tokens(t)) for t in texts]
    df = Counter()
    for d in docs:
        for w in d:
            df[w] += 1
    n = len(docs)
    vecs = []
    for d in docs:
        vec = {w: c * math.log((1 + n) / (1 + df[w])) for w, c in d.items()}
        norm = math.sqrt(sum(v * v for v in vec.values())) or 1.0
        vecs.append({w: v / norm for w, v in vec.items()})
    return vecs


def _cos(a, b):
    return sum(v * b.get(w, 0.0) for w, v in a.items())


def _containment(a, b, n=8):
    """What fraction of a's n-grams also appear in b."""
    sa = _shingles(a, n)
    if not sa:
        return 0.0
    return len(sa & _shingles(b, n)) / len(sa)


def _readable_claims(seal):
    """The claims `aim tension` can score: a list of objects, or [].

    The same rule `aimboard.primitives.read_seal_claims` states for the board,
    spelled here because this is a standalone script and imports nothing from
    `aimboard/`. It is the reader half of T-0247: `aim seal` refuses a payload
    that is not a list of objects now, but a seal written before that check can
    still be on disk, and this verb used to die on one --
    `TypeError: string indices must be integers` on the first element of a
    `"claims": ["x"]` seal -- when the report it exists to produce was exactly
    what was wanted.

    An element that is not an object is dropped rather than coerced: `str(c)`
    would print a string as a claim nobody wrote, and this verb's whole output
    is a comparison between two positions, so an invented claim is worse than a
    missing one. A dropped element makes the mean overlap a statement about
    fewer claims, which the printed `N claim(s)` rows let a reader see.
    """
    claims = seal.get("claims") if isinstance(seal, dict) else None
    if not isinstance(claims, list):
        return []
    return [c for c in claims if isinstance(c, dict)]


def _kill_overlap(kill_if, claim_text):
    """Heuristic: how much of a kill_if condition is addressed by a claim.

    This is lexical and it is weak. It cannot tell whether the claim actually
    satisfies the condition — only whether the claim is even *about* the same
    things. Weak signals reported as weak signals.
    """
    kt = set(_tokens(kill_if))
    if not kt:
        return 0.0
    return len(kt & set(_tokens(claim_text))) / len(kt)


def cmd_tension(args):
    """Measure how far apart two sealed positions actually are.

    Computed from the sealed material before anyone reads anyone. Visible to the
    leader and the synthesizer only — a participant seeing this report before
    CROSS_EXAMINE would be reading the other side through a summary, which is
    the thing the barrier exists to prevent.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in (m["leader"], m.get("synthesizer")) and kind != "human":
        die(
            f"REFUSED: the tension report is visible to the leader ('{m['leader']}') and "
            f"the synthesizer only.\nIt is a summary of the other side's reasoning. "
            f"Reading it before CROSS_EXAMINE is exposure by another name.",
            cls="barrier",
        )
    parts = list(args.participants.split(",")) if args.participants else m["participants"]
    if len(parts) != 2:
        die("tension compares exactly two participants; pass --participants a,b", cls="form")
    seals = {}
    for p in parts:
        s = read_json(channel_dir(args.channel) / "seals" / f"{p}.json")
        if s is None:
            # The same rule as `advance --to SYNTHESIS`: the leader may not see a
            # comparison of positions until there are positions to compare. It
            # is the barrier's precondition, not a missing argument.
            die(f"REFUSED: '{p}' has not sealed. There is nothing to compare yet.",
                cls="barrier")
        seals[p] = s
    a, b = parts
    la = "\n".join(r["body"] for r in read_jsonl(channel_dir(args.channel) / "private" / f"{a}.jsonl"))
    lb = "\n".join(r["body"] for r in read_jsonl(channel_dir(args.channel) / "private" / f"{b}.jsonl"))
    ta = la + "\n" + seals[a]["summary"]
    tb = lb + "\n" + seals[b]["summary"]

    va, vb = _tfidf_cosine([ta, tb])
    rep = {
        "channel": args.channel,
        "topic": m["topic"],
        "compared": [a, b],
        "lexical_similarity": round(_cos(va, vb), 3),
        "verbatim_containment": {
            f"{a}->{b}": round(_containment(ta, tb), 3),
            f"{b}->{a}": round(_containment(tb, ta), 3),
        },
        "claim_analysis": [],
        "caveat": (
            "Lexical only. It can see shared words and shared sentences. It cannot "
            "see shared framing expressed in different words, which is the failure "
            "mode that matters. A high score is weak evidence of independence; a "
            "low score is strong evidence of contact."
        ),
    }

    ca, cb = _readable_claims(seals[a]), _readable_claims(seals[b])

    def score_against(claim, others):
        """Score one claim against another set, symmetrically.

        Both directions get the same two measurements. An asymmetric loop here
        would make whichever agent is listed first the reference frame inside
        the very tool built to stop the first speaker setting the frame.
        (Found by claude-session2 reading this file while unsealed — claim C6.)
        """
        best_dup = max(((_kill_overlap(claim["claim"], o["claim"]), o["id"]) for o in others),
                       default=(0.0, ""))
        best_kill = max(((_kill_overlap(claim.get("kill_if", ""), o["claim"]), o["id"]) for o in others),
                        default=(0.0, ""))
        return best_dup, best_kill

    for side, others in ((a, cb), (b, ca)):
        for c in (ca if side == a else cb):
            best_dup, best_kill = score_against(c, others)
            rep["claim_analysis"].append({
                "agent": side, "id": c.get("id") or "", "claim": str(c.get("claim") or "")[:80],
                "closest_counterpart": best_dup[1], "counterpart_overlap": round(best_dup[0], 2),
                "kill_if_addressed_by": best_kill[1], "kill_if_addressed": round(best_kill[0], 2),
                "confidence": c.get("confidence"),
            })

    # Headline: how much of each side's sealed position is even about the same
    # things as the other's. Very high coverage + low lexical distance = the two
    # agents answered the same question the same way, which is the outcome the
    # barrier was supposed to make less likely, not more.
    overlaps = [r["counterpart_overlap"] for r in rep["claim_analysis"]]
    rep["mean_claim_overlap"] = round(sum(overlaps) / len(overlaps), 2) if overlaps else 0.0
    sim = rep["lexical_similarity"]
    rep["reading"] = (
        "positions look genuinely different" if sim < 0.25 else
        "positions share substantial vocabulary — check whether they are answering the same question"
        if sim < 0.5 else
        "positions are lexically close; independent convergence or one position elaborated from the other"
    )

    if args.json:
        print(json.dumps(rep, indent=2, ensure_ascii=False))
        return
    print(f"tension report  {args.channel}   ({a} vs {b})")
    print(f"  lexical similarity     {sim}   (0 = no shared vocabulary, 1 = identical)")
    for k, v in rep["verbatim_containment"].items():
        print(f"  8-gram containment     {k}: {v}")
    print(f"  mean claim overlap     {rep['mean_claim_overlap']}")
    print()
    # What this number is not, said before anyone reads it as a verdict.
    print("  caveat: a word counts as shared however it got there. This cannot tell")
    print("  whether the two positions converged or whether one is downstream of the")
    print("  other, and those have opposite implications. It is a prompt to look, not")
    print("  a finding.")
    print("  claims:")
    for r in rep["claim_analysis"]:
        kill = f"  kill_if addressed {r['kill_if_addressed']:.0%} by {r['kill_if_addressed_by']}" \
            if r.get("kill_if_addressed_by") else ""
        print(f"    {r['agent'][:12]:<12} {r['id']:<4} overlap {r['counterpart_overlap']:.0%} "
              f"with {r['closest_counterpart'] or '-':<4} {r['claim'][:52]}{kill}")
    print()
    print(f"  reading: {rep['reading']}")
    print(f"  caveat:  {rep['caveat']}")


def cmd_status(args):
    m = load_manifest(args.channel)
    b = m["barrier"]
    log = read_jsonl(channel_dir(args.channel) / "log.jsonl")
    print(f"channel   {m['id']}")
    print(f"topic     {m['topic']}")
    print(f"phase     {b['phase']}   round {b['round']}")
    print(f"leader    {m['leader']}   synthesizer {m.get('synthesizer') or '(unset)'}")
    print(f"rules     {PHASE_RULES[b['phase']]}")
    # The clause of T-0213 that is about a reader who is *not* running
    # `advance`: a closed capability is a fact about this phase, and the line
    # that says when it opens again is what makes the closure legible instead of
    # looking like the current state of the world. Omitted when nothing is shut.
    shut = [f"{n} opens at {opener}" for n, opener
            in sorted(PHASE_OPENERS[b["phase"]].items())
            if not PHASE_RULES[b["phase"]][n] and opener]
    if shut:
        print(f"next      {b['phase']}: " + "; ".join(shut))
    print("participants:")
    for p in m["participants"]:
        seal = read_json(channel_dir(args.channel) / "seals" / f"{p}.json")
        priv = read_jsonl(channel_dir(args.channel) / "private" / f"{p}.jsonl")
        pub = [r for r in log if r.get("from") == p]
        mark = f"sealed {seal['digest'][:12]}…" if seal else "unsealed"
        print(f"  {p:<16} private={len(priv):<4} public={len(pub):<4} {mark}")
    print(f"history   " + " -> ".join(h["phase"] for h in b["history"]))
    print(f"log       {len(log)} public messages")
    # The barrier's precondition, stated where the phase is stated. A reader who
    # sees SEALED_DIVERGENT and nothing else has been told the claim without the
    # evidence for it; the workspace is the one fact that can falsify it.
    if m.get("workspace"):
        conflicts = _workspace_conflicts(m)
        print(f"workspace " + ", ".join(f"{k}={v}" for k, v in sorted(m["workspace"].items())))
        if conflicts:
            print(f"          WARNING: {len(conflicts)} shared writable path(s) — a "
                  f"divergence phase on this channel is a claim the tool cannot keep")


def cmd_card(args):
    """Render an agent's A2A AgentCard. A read: no lock, no ledger, no refusal.

    The translation lives in `aimboard/a2a.py` and this is a thin front end to
    it, for the reason design/08 section 3 gives about MCP: one rule, one owner.
    The rule here is "how an agent's identity is described to a foreign client",
    and a second implementation of it inside `bin/aim` would be a second place
    for it to drift from the module the conformance suite pins.

    The import is inside the function so that a broken or absent `aimboard` costs
    one verb rather than the whole tool: `aim` is the fabric and every other
    command must keep working when only the dashboard side is unwell. [measured:
    this is not hypothetical, design/06 mentions a window today where bin/aim
    itself was unparseable and the entire fabric was down.]
    """
    who, kind = resolve_actor(args)
    reg = load_registry()["agents"]
    # The binding's interface is the file root: that is where every one of the
    # eleven operations actually reads and writes. It is not a URL a foreign
    # client can dial, and the card says so in two places rather than dressing a
    # path up as an endpoint — `metadata.aim.reachability` and the absent @-scheme.
    target = str(ROOT)
    if args.all:
        cards = [_render_card(reg[i], target) for i in sorted(reg)]
        print("[" + ",\n ".join(cards) + "]")
        return
    # --as is required by resolve_actor and it also names the card's subject, so a
    # registered agent can render any other registered agent's card. That is
    # correct rather than sloppy: an AgentCard is the *public* description of an
    # agent, the spec publishes it at /.well-known/agent-card.json, and there is
    # nothing in a card that its subject would not hand a stranger.
    print(_render_card(reg[who], target))


def cmd_doctor(args):
    """Ask whether this checkout can be run at all. A front end, and only that.

    The diagnosis lives in `bin/aim-doctor`, deliberately outside the tool it
    watches: a verb inside `bin/aim` that reported "bin/aim does not parse" is a
    verb that is gone exactly when it is needed. This exists so the check is one
    word away on a working tree, and it forwards its exit code unchanged so a
    script can use it either way.

    Nothing here is checked before the forward, and that is the point: this
    command must not be able to fail for a reason of its own.
    """
    script = Path(__file__).resolve().parent / "aim-doctor"
    if not script.exists():
        print(f"aim: {script} is missing, so there is nothing to run. The check "
              f"lives outside this file on purpose: a doctor inside the patient "
              f"cannot report the patient's own syntax error.", file=sys.stderr)
        return 127
    argv = [sys.executable, str(script)]
    if args.quiet:
        argv.append("--quiet")
    if args.root:
        argv += ["--root", args.root]
    return subprocess.run(argv).returncode


def _render_card(agent, target):
    """Build and serialise one card; `target` is what `supportedInterfaces[].url` names."""
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
        from aimboard.a2a import agent_card  # noqa: E402
    except Exception as exc:  # pragma: no cover - only on a broken checkout
        die(f"REFUSED: cannot render an AgentCard: aimboard.a2a did not import ({exc}).\n"
            f"The card is a translation of the registry and it lives beside the "
            f"renderer; if that module is missing, so is the translation.",
            cls="form")
    return json.dumps(agent_card(agent, target), indent=2, ensure_ascii=False)


# Which chained channel files `aim verify` audits. `friction.jsonl` is written
# with the same `append_chained` as the rest, and an unverified chain is a
# decoration: nothing reads the `prev`/`hash` it carries, so the fields look
# like tamper-evidence and are not. The board already verifies it (fabric.py
# puts it in the channel's `chain` dict); this is the CLI's copy of the same
# contract, one check instead of two answers.
VERIFY_CHAIN = ("log.jsonl", "ledger.jsonl", "tasks.jsonl", "push.jsonl",
                "friction.jsonl")


def _friction_path(ch=None):
    """Where friction lives. One record per time the fabric got in the way.

    Written by the verb that is the whole of T-0084. design/06 §4 is precise
    about the shape — "the command that was typed, what happened, what it cost,
    and whether the workaround touched the record" — so a bare note with none of
    the four is a note that does not exist yet. The record is chained like the
    log and the ledger it sits beside, so `aim verify` audits it and the board
    reads it as the channel's `friction` list, which means the cheapest
    instrument in the system has the same evidentiary footing as every other
    record the fabric keeps.
    """
    return channel_dir(ch or _CTX.get("channel") or "") / "friction.jsonl"


def cmd_friction(args):
    """Write or read the friction log. Nobody wrote it, so nobody did.

    The wall-avoidance was invisible (design/06 §4): an agent hits a wall,
    works around it, and the workaround is lost — three sessions later the
    design still assumes the wall is fine. This is the writer for the log that
    measures the fabric *as used* rather than as designed, and its whole point
    is to be cheap enough that the note happens instead of being postponed into
    nothing.

    Deliberately not gated by the barrier, and the reason is the phase map
    rather than a guess: this is not a position on the topic and not a claim
    about anyone's reasoning, so `read_others` has no rule for it — it is a
    note *about the tool* the tool ran. Refusing it in SEALED_DIVERGENT would
    refuse the exact moment (the barrier refusing) that produces the most
    friction, which is the one note the log exists to record. So any participant
    or the human leader may write in any phase, and what a writer is trusted not
    to do is put someone else's sealed reasoning in the note — that is a
    position entered by hand, and it is refused only if it tries to cross the
    barrier the way every other leak does.

    `--touched-record` is the alarming flag and exists because design/06 §4
    asks for it: *whether the workaround touched the record*. A workaround that
    wrote the fabric's own log or ledger by hand, rather than through a verb, is
    the exact failure the barrier exists to catch — bypassing the record rather
    than navigating it — so it is stated rather than inferred, and defaulting
    to false on purpose: an unexamined workaround is the common case, but a
    truthful record of one that touched the record is the case the log is for.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)                 # refuses an unknown channel
    if who not in m["participants"] and kind != "human":
        die(f"'{who}' is not a participant in {args.channel}", cls="barrier")
    if args.add:
        missing = [f for f, v in (("--command", args.command), ("--cost", args.cost))
                   if not v]
        if missing:
            die(f"a friction record needs {', '.join(missing)}; "
                f"see `aim friction --help`", cls="form")
        with Lock(channel_dir(args.channel) / ".lock"):
            append_chained(_friction_path(args.channel), {
                "ts": now_iso(), "event": "friction", "actor": who,
                "channel": args.channel, "context_id": args.channel,
                "command": args.command, "happened": args.happened,
                "cost": args.cost,
                "touched_record": bool(args.touched_record),
                "action": "friction add",
            })
        print(f"{args.channel}: friction noted ({args.command[:60]}{'…' if len(args.command) > 60 else ''})")
        return
    recs = [r for r in read_jsonl(_friction_path(args.channel))
            if r.get("channel", args.channel) == args.channel]
    if args.json:
        print(json.dumps(recs, indent=2, ensure_ascii=False))
        return
    if not recs:
        print(f"{args.channel}: the friction log is empty — which means either "
              f"nobody used the fabric or nobody is recording, and design/06 §4 "
              f"calls both a failure")
        return
    for r in reversed(recs):
        touched = " [touched the record]" if r.get("touched_record") else ""
        print(f"{r.get('ts', '')[:19]}  {r.get('actor', ''):<14} "
              f"cost={str(r.get('cost', '')):<0} "
              f"{r.get('command', '')[:60]}{touched}")
        if r.get("happened"):
            print(f"          " + r["happened"][:120])


def cmd_search(args):
    """One query over the channel log, the board and the rooms (T-0024).

    Three readers already exist and this verb calls them rather than opening a
    file: `read_jsonl` on `log.jsonl` (as `cmd_inbox` does), `fold_tasks` over
    `task_events` (as `cmd_task_list` does), and `room_events` under the room
    gate (as `_load_room_or_die` does). A fourth reader for messages or for work
    items is the second-implementation failure this project keeps measuring, and
    a search is exactly where one gets written by accident -- it looks like a
    filter over text rather than a read of a record.

    **Order is the chain order.** Results print in the order the records appear
    in their file, and for this fabric that is not a convention: `append_chained`
    links every record to its predecessor through the `prev` field and recomputes
    `hash` over the whole record, so a record's *position in the file* is the
    position the chain attests to. Sorting by score or timestamp would each
    destroy that -- `ts` is wall-clock from two writers who interleave under the
    lock, and a score is not a fact about the record at all -- and sorting by
    path would be a claim about where the file happens to live. A search is where
    a reader reconstructs what happened, so the answer has to arrive in the order
    it happened.

    The gate is the existing one, not a new one: the log half applies
    `PHASE_RULES[...]["read_others"]` record by record exactly as `cmd_inbox`
    does (including that the log has no human exemption, because adding one here
    would make `search` read more than `inbox` under the same phase), the task
    half asks `_visible_to` with the same `fold_tasks` board, and the room half
    asks `_room_withheld`. What is withheld is *counted* rather than silently
    dropped, the same way `task list` prints its hidden count: a search that
    quietly omits records is a search that lies about the size of the log.
    """
    who, kind = resolve_actor(args)
    query = (args.query or "").strip().lower()
    if not query:
        # A malformed invocation, which is what `form` means here: the request
        # is well-formed but empty, so it is not the barrier's business and no
        # phase would make it answerable.
        die("REFUSED: search needs a query.\n"
            "  aim search --as <who> --channel <ch> [--log] [--tasks] [--rooms] <query>",
            cls="form")
    scopes = ({name for name, on in (("log", args.log), ("tasks", args.tasks),
                                     ("rooms", args.rooms)) if on}
              or set())
    if not scopes:
        die("REFUSED: name at least one scope to search (--log, --tasks, --rooms).\n"
            "An unnamed scope is not every scope: a search that silently widens to "
            "the whole fabric is the cross-read this tool exists to gate.",
            cls="form")
    m = load_manifest(args.channel)
    withheld = {"log": 0, "tasks": 0, "rooms": 0}
    rows = []
    phase = m["barrier"]["phase"]

    if "log" in scopes:
        can_read_others = PHASE_RULES[phase]["read_others"]
        for r in read_jsonl(channel_dir(args.channel) / "log.jsonl"):
            if r.get("from") != who and not can_read_others:
                withheld["log"] += 1
                continue
            if query in (r.get("body") or "").lower():
                rows.append(f"log   {r.get('id', ''):<7} {r.get('from', ''):<16} "
                            f"{(r.get('kind') or ''):<10} {_snippet(r.get('body', ''))}")

    if "tasks" in scopes:
        board = fold_tasks(args.channel)
        # Walked in *file* order and resolved against the fold, so the board's
        # output order is the chain order of the `created` events and not the
        # sorted id order `task list` prints. Same reader, same visibility rule,
        # different order -- the order is a property of what the caller asked.
        seen = set()
        for ev in task_events(args.channel):
            tid = ev.get("task")
            t = board.get(tid)
            if t is None or tid in seen:
                continue
            if not _visible_to(t, who, phase) and who != m.get("leader"):
                continue
            if query in (t.get("title") or "").lower() or \
                    query in (t.get("accept") or "").lower():
                seen.add(tid)
                rows.append(f"task  {tid:<7} {(t.get('status') or ''):<10} "
                            f"{(t.get('owner') or '(unclaimed)'):<16} "
                            f"{_snippet((t.get('title') or '') + ' | ' + (t.get('accept') or ''))}")
        withheld["tasks"] = sum(1 for t in board.values()
                                if not _visible_to(t, who, phase)
                                and who != m.get("leader"))

    if "rooms" in scopes:
        for path in sorted(rooms_dir(args.channel).glob("*.jsonl")):
            rid = path.stem
            if _room_withheld(args.channel, rid, who, kind, phase):
                withheld["rooms"] += len(read_jsonl(path))
                continue
            for x in read_jsonl(path):
                if query in (x.get("body") or "").lower():
                    rows.append(f"room  {rid:<7} {x.get('id', ''):<7} "
                                f"{x.get('agent', ''):<16} "
                                f"{(x.get('kind') or ''):<10} {_snippet(x.get('body', ''))}")

    if not rows:
        print(f"aim: nothing in '{args.channel}' ({', '.join(sorted(scopes))}) "
              f"matches {query!r}")
    for line in rows:
        print(line)
    for name in ("log", "tasks", "rooms"):
        if withheld[name]:
            # Counted, never shown: the reader must be able to tell "no match"
            # from "there is a match behind the gate in {phase}".
            print(f"\n({withheld[name]} record(s) in {name} were not searched: the "
                  f"barrier in {phase} does not let you read them)")


def _snippet(text, width=72):
    """One line of a body, for the search result row.

    Flattened to a single line because the reader is scanning *positions in a
    chain* and a multi-line body would break the one-row-per-record shape that
    makes the order legible. Truncated at `width` for the same reason.
    """
    flat = " ".join((text or "").split())
    return flat[:width] + ("…" if len(flat) > width else "")


def cmd_verify(args):
    ok = True
    # `push.jsonl` is checked with the rest because it is written with the same
    # `append_chained`, and an unverified chain is a decoration: the file would
    # carry `prev` and `hash` fields that nothing ever reads, which reads as
    # tamper-evidence and is not. It holds a secret, and that is an argument for
    # checking it rather than against — a rotated token is superseded by a later
    # record, so the *history* is what makes 'which secret was live then'
    # answerable, and a history nobody verifies is a history anyone may rewrite.
    # Only TAMPER lines are printed, never contents, so verifying it prints no
    # secret. `friction.jsonl` is covered for the same reason: a friction note
    # that names a wall in the log no verb audits is a note that can be quietly
    # rewritten, and the cheapest instrument must not be the first one to rot.
    for rel in VERIFY_CHAIN:
        p = channel_dir(args.channel) / rel
        try:
            recs = read_jsonl(p)
        except MalformedLog as exc:
            # A truncated line is what a writer killed mid-append leaves behind,
            # and it is TAMPER, not a crash. This is the reader's one job.
            print(f"TAMPER {rel}:{exc.lineno} is not valid JSON "
                  f"({exc.detail}) — a writer was interrupted, or a record was cut")
            ok = False
            continue
        prev = "genesis"
        for i, r in enumerate(recs, 1):
            h = r.get("hash")
            body = {k: v for k, v in r.items() if k != "hash"}
            if sha256_hex(canonical(body)) != h:
                print(f"TAMPER {rel}:{i} content does not match its hash")
                ok = False
            if r.get("prev") != prev:
                print(f"TAMPER {rel}:{i} broken chain (prev={r.get('prev', '')[:12]}… expected {prev[:12]}…)")
                ok = False
            prev = h
    # Room logs are covered by the same walk, and for the same reason T-0219
    # clause 4 gives: `aim room say` appends with `append_chained` and the
    # channel's `.lock`, so a room chain that nothing verifies would be
    # tamper-evidence in a file no verb audits -- a decoration. Sorted, so the
    # output is deterministic and a diff of two verifies is meaningful.
    #
    # Forward only, in the sense that matters here: nothing below rewrites a
    # room log. A hand-written room with no chain at all (there are such files in
    # this repo's history, from before the write side existed) is reported as
    # unchained rather than repaired, because repairing it would mean writing to
    # a record somebody else made by hand -- and the point of the report is that
    # the hand-made one is now visible.
    for p in sorted((channel_dir(args.channel) / "rooms").glob("*.jsonl")):
        try:
            recs = read_jsonl(p)
        except MalformedLog as exc:
            print(f"TAMPER rooms/{p.name}:{exc.lineno} is not valid JSON ({exc.detail})")
            ok = False
            continue
        prev = "genesis"
        for i, r in enumerate(recs, 1):
            if not r.get("hash"):
                # A room message written before the write side existed carries no
                # chain fields. It is reported, not counted as TAMPER: there is
                # nothing tampered with, there is a record that was never chained.
                print(f"UNCHAINED rooms/{p.name}:{i} carries no hash — written by "
                      f"hand, before `aim room say` existed")
                ok = False
                continue
            body = {k: v for k, v in r.items() if k != "hash"}
            if sha256_hex(canonical(body)) != r["hash"]:
                print(f"TAMPER rooms/{p.name}:{i} content does not match its hash")
                ok = False
            if r.get("prev") != prev:
                print(f"TAMPER rooms/{p.name}:{i} broken chain "
                      f"(prev={str(r.get('prev'))[:12]}… expected {prev[:12]}…)")
                ok = False
            prev = r["hash"]
    for p in sorted((channel_dir(args.channel) / "seals").glob("*.json")):
        try:
            s = read_json(p)
        except json.JSONDecodeError as exc:
            # The seal equivalent of the truncated append `read_jsonl` already
            # refuses to guess about: a seal file cut mid-write is damage this
            # verb exists to report, and it used to raise instead.
            print(f"TAMPER seal {p.name}: is not valid JSON ({exc}) — a writer was "
                  f"interrupted, or the file was cut")
            ok = False
            continue
        if not isinstance(s, dict):
            print(f"TAMPER seal {p.name}: is not a seal object at all")
            ok = False
            continue
        # T-0145's second half, measured live by lane I3: the digest is
        # recomputed over every field *except* `digest`, so the comparison
        # itself indexed a key a malformed seal does not have, and `verify` on a
        # seal carrying `private_log_hashes` but no `digest` died with
        # `KeyError: 'digest'`, rc=1, no TAMPER line. T-0145's accept line
        # forbids exactly that -- a missing field is damage to *report* -- and
        # the `ts` half was fixed in `check_sealed_prefix` while this half was
        # left. Same treatment for `agent`: every line below names the file it is
        # about, and a seal that names no agent has no private log to name.
        if not s.get("agent"):
            print(f"TAMPER seal {p.name}: carries no agent, so the private log it "
                  f"seals cannot be named")
            ok = False
            continue
        if not s.get("digest"):
            print(f"TAMPER seal {p.name}: carries no digest, so the seal's own "
                  f"contents cannot be checked against it")
            ok = False
        else:
            d = sha256_hex(canonical({k: v for k, v in s.items() if k != "digest"}))
            if d != s["digest"]:
                print(f"TAMPER seal {p.name}: digest mismatch")
                ok = False
        # The seal covers the private log as a frozen PREFIX: the bytes and record
        # hashes that existed at sealing time. Appending after sealing is
        # legitimate — you keep reasoning — and is reported as a note, not a
        # failure. Editing or reordering what was already sealed is not.
        pl = channel_dir(args.channel) / "private" / f"{s['agent']}.jsonl"
        if pl.exists():
            # The log's own chain first: a record whose body was edited without
            # its hash being recomputed is caught here, independently of the seal.
            prev = "genesis"
            for i, r in enumerate(read_jsonl(pl), 1):
                if sha256_hex(canonical({k: v for k, v in r.items() if k != "hash"})) != r.get("hash"):
                    print(f"TAMPER private/{s['agent']}.jsonl:{i} content does not match its hash")
                    ok = False
                if r.get("prev") != prev:
                    print(f"TAMPER private/{s['agent']}.jsonl:{i} broken chain")
                    ok = False
                prev = r.get("hash")
            if not check_sealed_prefix(s, pl):
                ok = False
    print("chain OK" if ok else "chain BROKEN")
    sys.exit(0 if ok else 1)


def check_sealed_prefix(seal, pl):
    """Does the private log still start with exactly what the seal froze?

    Three seal generations exist in this repo, and the check has to be honest
    about which one it is looking at:

      private_log_bytes   raw hex of the frozen prefix. Newest, exact, and the
                          only form that cannot be defeated by re-serializing.
      private_log_hashes  record hashes of the frozen prefix (current cmd_seal).
      private_log_sha256  the original contract: sha256 of the whole file, plus
                          a record count. Checked against the first N raw lines,
                          which is the reading both old seals on disk actually
                          satisfy. [measured: barrier-v0 does]

    A seal carrying none of these cannot be checked at all. That is reported as
    TAMPER, not skipped: silently declaring an unverifiable seal intact is the
    failure this function exists to prevent, and the version that shipped did
    exactly that for every seal written before 15:55Z.
    """
    n_bytes, n_hashes = seal.get("private_log_bytes"), seal.get("private_log_hashes")
    n_sha, n_len = seal.get("private_log_sha256"), seal.get("private_log_len") or 0
    # A seal without a timestamp is a seal this function has to be able to *report*,
    # and it could not: every TAMPER line indexed seal['ts'], so the one path whose
    # entire job is to describe damage raised KeyError on a damaged seal. Codex's
    # renderer test builds such a seal (agent + digest + private_log_hashes, no ts)
    # and `verify` crashed on it instead of reporting. A verifier that dies on the
    # input it exists to judge is worse than one that says nothing, because it
    # looks like a tool failure rather than a finding.
    when = seal.get("ts") or "(no ts recorded in the seal)"
    raw = pl.read_bytes()
    lines = [l for l in raw.split(b"\n") if l.strip()]
    if n_bytes:
        prefix = (b"\n".join(lines[:n_len]) + b"\n") if n_len else b""
        if prefix.hex() != n_bytes:
            print(f"TAMPER private log {seal['agent']}: the bytes sealed at {when} "
                  f"are not a prefix of the file now")
            return False
        return _note_append(seal, len(lines), n_len)
    if n_hashes:
        actual = [r.get("hash", "") for r in read_jsonl(pl)]
        if actual[:len(n_hashes)] != n_hashes:
            print(f"TAMPER private log {seal['agent']}: a record sealed at {when} "
                  f"was removed or reordered")
            return False
        return _note_append(seal, len(actual), len(n_hashes))
    if n_sha and n_len:
        prefix = (b"\n".join(lines[:n_len]) + b"\n") if n_len else b""
        if sha256_hex(prefix) != n_sha:
            print(f"TAMPER private log {seal['agent']}: the {n_len} record(s) sealed at "
                  f"{when} no longer hash to the sealed value")
            return False
        return _note_append(seal, len(lines), n_len)
    if n_sha or n_len or ("private_log_sha256" in seal) or ("private_log_len" in seal):
        # T-0257. The three branches above decide on the *truthiness of the
        # value*; this one decides on the *presence of the key*, and that is the
        # whole difference. A seal written over a private log that did not exist
        # yet is still a seal that froze something: it froze the empty prefix.
        # `cmd_seal` writes `private_log_sha256: ""` and `private_log_len: 0` for
        # that case (`bin/aim:1749`), and the old guard here read the empty
        # string as "no commitment at all", so the fabric's own verifier called
        # the fabric's own seal unverifiable.
        #
        # Measured on the live channel `hello` before this change: `aim verify
        # --channel hello` printed exactly two TAMPER lines — `seal
        # claude-session1` and `seal codex`, both `carries no private-log
        # commitment` — and `chain BROKEN`, rc 1, while every `prev`/`hash` link
        # in the channel's four chained files verified. The two seals it
        # condemned are the two whose logs were empty at sealing time and hold 5
        # and 2 records now, and `private_log_len: 0` is on both records: the
        # commitment is present and says "zero records".
        #
        # What the empty frozen prefix buys is asymmetric and worth stating,
        # because it is a limit and not a victory: a seal over zero records can
        # detect nothing appended later. Every record in the log arrived after
        # the seal, and none of them was frozen, so there is no prefix to
        # compare and no reordering to catch. What it *does* attest is that the
        # log was empty at `when` — and that is a claim about the file this
        # check can still verify, by looking at whether the seal's own record
        # count is zero while the file is not. So the count is named, and the
        # line says what the seal can and cannot answer, rather than the
        # sentence the accept line forbids ("carries no commitment") for a seal
        # that carries one.
        #
        # The genuinely field-less seal — the shape `tests/selftest.sh`'s
        # fixture builds by popping all four keys, and the shape the pre-15:55Z
        # writer could have produced — keeps its old TAMPER line below, because
        # for it the old sentence is exactly true and the accept line's first
        # clause records it as the correct behaviour.
        n_len = n_len or 0
        if not n_len:
            # Zero records frozen. Three shapes reach here, and they are not the
            # same claim: a digest over nothing (`sha256_hex(b"")`, which is what
            # a seal written while the private file existed-but-empty carries), a
            # digest that is absent (the file did not exist at sealing time, the
            # shape both live `hello` seals have), and — the one that is damage
            # rather than emptiness — a count of zero beside a digest that is not
            # the digest of nothing.
            if n_sha and n_sha != sha256_hex(b""):
                print(f"TAMPER private log {seal['agent']}: it names 0 sealed "
                      f"record(s) at {when} and carries a digest that is not the "
                      f"digest of an empty prefix, so the count and the bytes "
                      f"disagree")
                return False
            if lines:
                print(f"TAMPER private log {seal['agent']}: the seal froze 0 "
                      f"record(s) at {when}, and the log now holds {len(lines)} — "
                      f"the seal attests that this agent's log was empty then and "
                      f"can say nothing about any record in it, because none of "
                      f"them was frozen")
                return False
            return _note_append(seal, 0, 0)
        # A count with nothing to check it against: the seal names N records and
        # carries no bytes, no hashes and no digest. The three branches above
        # cannot see it, and reporting it as "no commitment" would be the false
        # half of the same sentence this branch exists to fix.
        print(f"TAMPER private log {seal['agent']}: the seal names {n_len} record(s) "
              f"at {when} and the log holds {len(lines)}, but it carries no bytes, "
              f"no record hashes and no digest, so those {n_len} cannot be checked")
        return False
    print(f"TAMPER seal {seal['agent']}: carries no private-log commitment, so the "
          f"sealed reasoning cannot be verified at all")
    return False


def _note_append(seal, now_n, sealed_n):
    if now_n > sealed_n:
        print(f"note   private log {seal['agent']}: {now_n - sealed_n} record(s) "
              f"appended after sealing (allowed; the sealed prefix is intact)")
    return True



# --------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(prog="aim", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, **kw):
        p = sub.add_parser(name, **kw)
        p.set_defaults(func=fn)
        return p

    add("init", cmd_init)
    p = add("card", cmd_card, help="render an agent's A2A AgentCard (a read of the registry)")
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--all", action="store_true",
                   help="every registered agent, as one JSON array")
    p = add("register", cmd_register)
    p.add_argument("--as", dest="actor", required=True)
    # The kind vocabulary is small and closed on purpose, and what each word
    # *does* is worth stating where it is defined rather than discovering by
    # reading every consumer: `agent_kind` is consulted to decide whether an
    # actor is the human leader (`require_leader`, and `new-channel --leader`,
    # which refuses any other kind). Every other comparison in this file is
    # `kind != "human"` -- the barrier, the participant rule, the divergence
    # publication gate, the task visibility rule and the tension report all turn
    # on that one negation -- so a kind is a *name*, not a permission, and
    # adding one changes who can be described and not who can do what.
    #
    # `orchestration` was added for T-0231 and design/13 section 7, whose first
    # acceptance item reads "its registry entry says what it is
    # (`kind: orchestration`)". It could not be satisfied before this word
    # existed: the choices were claude|codex|human|other, so the live
    # `codex-orangement` entry says `kind: codex`, which is a false statement
    # about a seat that dispatches work and writes no code. `other` was the
    # available dodge and it is not a name -- it is the absence of one.
    p.add_argument("--kind", required=True,
                   choices=["claude", "codex", "human", "orchestration", "other"])
    p.add_argument("--model", default="")
    p.add_argument("--session", default="")
    p.add_argument("--force", action="store_true",
                   help="take over an id that is already registered (recorded as a takeover)")

    p = add("depart", cmd_depart,
            help="declare that this session has finished with an id (the exit "
                 "mechanism; self-declaration, so it cannot cover a crash)",
            description="Declare that this session has finished with an id. The id "
                        "keeps its name, its kind and its channel memberships; what "
                        "changes is that every verb refuses it with class=barrier "
                        "until a session calls `aim depart --as <you> --return` or "
                        "takes the id over with `aim register --force`.\n\n"
                        "This is self-declaration, not liveness: a session that "
                        "crashes cannot call it, so it covers orderly exits and "
                        "nothing else. The case that prompted the verb -- sessions "
                        "that died without saying so -- needs a witness outside the "
                        "session and does not have one.")
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--reason", default="",
                   help="why the session is finishing, recorded in the registry")
    p.add_argument("--return", dest="returning", action="store_true",
                   help="clear a departure: this session speaks for the id again")

    p = add("new-channel", cmd_new_channel)
    p.add_argument("--id", required=True)
    p.add_argument("--topic", required=True)
    p.add_argument("--participants", required=True, help="comma-separated agent ids")
    p.add_argument("--leader", default="human")
    p.add_argument("--synthesizer", default="")
    p.add_argument("--workspace", action="append", metavar="AGENT=PATH",
                   help="a directory this participant writes to; two participants "
                        "naming the same one makes the barrier indefensible (T-0110)")

    p = add("channel", cmd_channel,
            help="channel-level declarations that outlive a phase: workspace, "
                 "and membership (add/remove a participant)")
    csub = p.add_subparsers(dest="channel_cmd", required=True)
    q = csub.add_parser("workspace", help="declare or clear the workspace participants share")
    q.set_defaults(func=cmd_channel_workspace)

    p = csub.add_parser("add", help="join a registered agent to an existing channel (leader-only)")
    p.set_defaults(func=cmd_channel_add)
    p.add_argument("--as", dest="actor", required=True, help="must be the channel leader")
    p.add_argument("--channel", required=True)
    p.add_argument("--agent", required=True, help="the registered agent to join")
    p.add_argument("--reason", default="", help="why the membership changed")

    p = csub.add_parser("remove", help="remove a participant from a channel (leader-only)")
    p.set_defaults(func=cmd_channel_remove)
    p.add_argument("--as", dest="actor", required=True, help="must be the channel leader")
    p.add_argument("--channel", required=True)
    p.add_argument("--agent", required=True)
    p.add_argument("--reason", default="", help="why the membership changed")
    q.add_argument("--as", dest="actor", required=True)
    q.add_argument("--channel", required=True)
    q.add_argument("--set", action="append", metavar="AGENT=PATH",
                   help="repeatable; PATH empty clears that participant")
    q.add_argument("--none", action="store_true",
                   help="clear the whole declaration (recorded in the ledger)")

    p = add("say", cmd_say)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--kind")
    p.add_argument("--subject", default="")
    p.add_argument("--body", default="")
    p.add_argument("--body-file")
    p.add_argument("--body-literal", dest="body_literal",
                   help="send this text literally, even if it names an existing file (T-0224)")
    p.add_argument("--evidence", action="append")
    p.add_argument("--responds-to")
    p.add_argument("--refs-seal")
    p.add_argument("--echo-ok", action="store_true")
    p.add_argument("--echo-reason", default="")
    # T-0230. Where the message goes is a decision the writer makes and says out
    # loud, not one the phase makes for them. Before this, a `note` written in
    # COMMIT landed in the private log because the phase happened to be closed,
    # and the command printed that as success with no way to tell it apart from a
    # delivered message. `--private` is the private log on purpose; `--public`
    # is the channel on purpose, and it is refused by name when the channel is
    # closed rather than quietly rerouted; neither means "route by the rule
    # table" (see cmd_say).
    p.add_argument("--private", action="store_true",
                   help="write to your own private log (private_say), not the channel")
    p.add_argument("--public", action="store_true",
                   help="write to the channel; refused by name if channel_say is False")

    p = add("seal", cmd_seal)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--summary", default="")
    p.add_argument("--body-file")
    p.add_argument("--claims")

    p = add("inbox", cmd_inbox)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--since")
    p.add_argument("--json", action="store_true")
    p.add_argument("--show-private", action="store_true")
    p.add_argument("--no-barrier-warning", action="store_true")

    p = add("wait", cmd_wait)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--timeout", type=float, default=300)
    p.add_argument("--interval", type=float, default=1.0)
    p.add_argument("--include-own", action="store_true")

    p = add("advance", cmd_advance)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--to")
    p.add_argument("--note", default="")
    p.add_argument("--synthesizer")
    p.add_argument("--force", action="store_true")

    p = add("request-advance", cmd_request_advance)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--to", required=True)
    p.add_argument("--reason", required=True)

    p = add("synthesis-input", cmd_synthesis_input)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--out")

    # ---- work items (design/05 §5, frozen interface) ----------------------
    tp = sub.add_parser("task", help="work items: the board, gated by the barrier")
    tsub = tp.add_subparsers(dest="task_cmd", required=True)

    def tadd(name, fn):
        q = tsub.add_parser(name)
        q.set_defaults(func=fn)
        q.add_argument("--as", dest="actor", required=True)
        q.add_argument("--channel", required=True)
        return q

    q = tadd("new", cmd_task_new)
    q.add_argument("--title", required=True)
    q.add_argument("--owner", default="")
    q.add_argument("--status", default="backlog")
    q.add_argument("--priority", default="normal")
    q.add_argument("--estimate", type=int, default=0)
    q.add_argument("--start", default="")
    q.add_argument("--due", default="")
    q.add_argument("--blocked-by", dest="blocked_by", default="")
    q.add_argument("--milestone", default="")
    q.add_argument("--tag", action="append")
    q.add_argument("--accept", default="", help="the sentence that makes this verifiable")
    q.add_argument("--visibility", default="draft", choices=["draft", "published"])

    q = tadd("move", cmd_task_move)
    q.add_argument("--id", required=True)
    q.add_argument("--to", required=True)
    q.add_argument("--reason", default="")
    q.add_argument("--evidence", default="",
                   help="required on review -> done (T-0251): what was measured "
                        "against the card's --accept line. Recorded on the `moved` "
                        "event beside the accept it answers")
    q.add_argument("--force", action="store_true")

    q = tadd("claim", cmd_task_claim)
    q.add_argument("--id", required=True)
    q.add_argument("--reason", default="",
                   help="why you are taking it (recorded; optional)")

    q = tadd("assign", cmd_task_assign)
    q.add_argument("--id", required=True)
    q.add_argument("--owner", required=True,
                   help='the new owner, or "" to release the card back to the pool '
                        "(which requires --reason)")
    q.add_argument("--reason", default="", help="required when releasing")
    q.add_argument("--force", action="store_true",
                   help="take or release a card you neither own nor created; the "
                        "overridden owner is recorded on the event (§ task assign)")

    q = tadd("publish", cmd_task_publish)
    q.add_argument("--id", required=True)
    q.add_argument("--reason", default="")

    q = tadd("link", cmd_task_link)
    q.add_argument("--id", required=True)
    q.add_argument("--blocked-by", dest="blocked_by", required=True)
    q.add_argument("--force", action="store_true",
                   help="record the edge anyway; the cycle it closes is written on "
                        "the event, so a forced deadlock is auditable (§ T-0221)")

    q = tadd("comment", cmd_task_comment)
    q.add_argument("--id", required=True)
    q.add_argument("--body", default="")
    q.add_argument("--body-file")
    q.add_argument("--body-literal", dest="body_literal",
                   help="send this text literally, even if it names an existing file (T-0224)")

    # T-0235. Every flag is optional and the verb does nothing when none is
    # given, so the command cannot be run "by accident" into an empty edit; the
    # fields it accepts are the closed list in `TASK_EDIT_FIELDS`, and the ones it
    # refuses are the ones another verb already owns.
    q = tadd("edit", cmd_task_edit)
    q.add_argument("--id", required=True)
    q.add_argument("--milestone", default=None,
                   help='the milestone this card counts under, or "" to take it out '
                        "of every milestone (§ T-0235)")
    q.add_argument("--priority", default=None, choices=TASK_PRIORITIES)
    q.add_argument("--start", default=None)
    q.add_argument("--due", default=None)
    q.add_argument("--estimate", dest="estimate_pts", type=int, default=None,
                   help="the estimate in points (recorded as estimate_pts)")
    q.add_argument("--tag", dest="tags", action="append", default=None,
                   help="repeatable; replaces the whole tag list, not one tag")
    q.add_argument("--title", default=None)
    q.add_argument("--accept", default=None)
    q.add_argument("--reason", default="", help="why the card is being corrected")
    q.add_argument("--force", action="store_true",
                   help="correct a card you neither own nor created; the overridden "
                        "owner is recorded on the event (§ T-0235)")

    # The one repair verb, and it is an append rather than an edit. It exists
    # because an accidental `created` landed in a hash-chained store and this
    # fabric does not edit chains: removing the line would leave every later
    # record's `prev` pointing at a hash the file no longer contains, which
    # `aim verify` reports as TAMPER -- for a deliberate repair. The record of
    # the mistake stays; the board stops drawing the card.
    q = tadd("retract", cmd_task_retract)
    q.add_argument("--id", required=True)
    q.add_argument("--reason", required=True,
                   help="why the card is being removed; it lands in the chain")

    q = tadd("list", cmd_task_list)
    q.add_argument("--owner", default="")
    q.add_argument("--status", default="")
    q.add_argument("--milestone", default="")
    q.add_argument("--json", action="store_true")
    q.add_argument("--count-hidden", dest="count_hidden", action="store_true",
                   help="how many items exist but are withheld from you, without their titles")

    # The doorbell as an object rather than as glue. `--as` and `--channel` sit on
    # the subcommands rather than on `doorbell` because everything else under
    # `task` names them per-verb, and a config is as much a fact about a task in a
    # channel as a move is.
    dp = tsub.add_parser("doorbell", help="push notification configs: the doorbell as the spec's object")
    dsub = dp.add_subparsers(dest="doorbell_cmd", required=True)

    def dadd(name, fn):
        r = dsub.add_parser(name)
        r.set_defaults(func=fn)
        r.add_argument("--as", dest="actor", required=True)
        r.add_argument("--channel", required=True)
        return r

    r = dadd("create", cmd_task_doorbell)
    r.add_argument("--id", required=True, help="the task this config is for")
    r.add_argument("--url", required=True, help="where the doorbell rings (http(s))")
    # Deliberately *not* `required=True`. The accept line is "a config with no
    # token is refused", and argparse's refusal is a usage error: it exits 2
    # before `note_context` has run, so nothing reaches the ledger and the one
    # artifact that answers "did anyone try this" is empty. A missing token is a
    # decision this tool makes, and a decision this tool makes belongs in
    # `validate_push_config` with the rest of them. [measured: with
    # `required=True` the refusal printed a usage block, rc=2, and no ledger line]
    r.add_argument("--token", default="",
                   help="the secret the agent presents on every notification (required)")
    r.add_argument("--scheme", default="", help="authenticationInfo.scheme (default Bearer)")
    r.add_argument("--credentials", default="",
                   help="authenticationInfo.credentials, if it differs from --token")

    r = dadd("list", cmd_task_doorbell)
    r.add_argument("--id", required=True)
    r.add_argument("--json", action="store_true")
    r.add_argument("--show-token", dest="show_token", action="store_true",
                   help="print the secret itself; every other read shape masks it")

    r = dadd("rotate", cmd_task_doorbell)
    r.add_argument("--config-id", dest="config_id", required=True)
    r.add_argument("--token", required=True, help="the new secret")

    r = dadd("delete", cmd_task_doorbell)
    r.add_argument("--config-id", dest="config_id", required=True)
    r.add_argument("--reason", default="")

    p = add("reveal", cmd_reveal)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--claim-id", required=True)
    p.add_argument("--body", default="")
    p.add_argument("--body-file")
    p.add_argument("--body-literal", dest="body_literal",
                   help="send this text literally, even if it names an existing file (T-0224)")

    p = add("push", cmd_push)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--to", required=True)
    p.add_argument("--channel", default="")
    p.add_argument("--subject", default="")
    p.add_argument("--body", default="")
    p.add_argument("--body-file")
    p.add_argument("--body-literal", dest="body_literal",
                   help="send this text literally, even if it names an existing file (T-0224)")
    p.add_argument("--via", default="", help="how you intend to deliver this (recorded for the ledger)")
    p.add_argument("--require-ack", action="store_true",
                   help="record that this message demands a receipt")
    # T-0147 clause 2's two flags. They are declared here rather than left to a
    # caller that forwards them, and the reason is the failure this repo keeps
    # measuring: an interface that cannot express the case cannot be audited for
    # it. With the flags undeclared, `cmd_push`'s commitment gate was reachable
    # only by a hand-built namespace -- so "a push that carries a position is
    # refused" was a claim no command line could test, and a reader of the ledger
    # could not tell whether it held because the gate worked or because nothing
    # could reach it. The verbs keep their meaning: `--refs-seal` is the digest of
    # the seal this body speaks for, exactly as in `say` (`bin/aim:1150`), and
    # `--kind` is the same vocabulary `say` accepts. Declaring them costs nothing
    # on the ordinary doorbell, which names neither.
    p.add_argument("--refs-seal", dest="refs_seal", default="",
                   help="the seal this message speaks for; a push carrying one is a "
                        "position and meets the barrier (T-0147)")
    p.add_argument("--kind", default="",
                   help="position/claim/note/…; a commitment kind makes this push a "
                        "position and it meets the barrier (T-0147)")

    p = add("pull", cmd_pull)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--claim", action="store_true", help="mark the messages as read")
    p.add_argument("--unread-only", action="store_true")

    p = add("confirm", cmd_confirm)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--msg-id", required=True)
    p.add_argument("--note", default="")

    p = add("outbox", cmd_outbox)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--peer", default="", help="only show one recipient")

    p = add("nudge", cmd_nudge)
    p.add_argument("--channel", required=True)
    p.add_argument("--peer", required=True)

    # ---- rooms (design/06 §1-§2) ------------------------------------------
    # The write side `aimboard` has been reading a hand-written file for. A room
    # is a named sub-log of a channel: same chaining, same flock, no quota,
    # never a barrier -- and, during a divergence phase, a draft until a
    # *recorded* publish opens it.
    rp = sub.add_parser("room", help="named sub-logs of a channel: group chat that inherits the barrier")
    rsub = rp.add_subparsers(dest="room_cmd", required=True)

    def radd(name, fn):
        r = rsub.add_parser(name)
        r.set_defaults(func=fn)
        r.add_argument("--as", dest="actor", required=True)
        r.add_argument("--channel", required=True)
        return r

    r = radd("new", cmd_room_new)
    r.add_argument("--id", required=True, help="the room's name inside the channel")
    r.add_argument("--topic", default="")

    r = radd("say", cmd_room_say)
    r.add_argument("--id", required=True)
    r.add_argument("--kind", default="", help="a note by default; no quota, no kinds required")
    r.add_argument("--body", default="")
    r.add_argument("--body-file")
    r.add_argument("--body-literal", dest="body_literal",
                   help="send this text literally, even if it names an existing file (T-0224)")
    r.add_argument("--responds-to", dest="responds_to", default="")

    r = radd("publish", cmd_room_publish)
    r.add_argument("--id", required=True)
    r.add_argument("--reason", default="")

    r = radd("list", cmd_room_list)
    r.add_argument("--json", action="store_true")

    r = radd("meta", cmd_room_meta)
    r.add_argument("--id", required=True)

    # ---- search (T-0024) --------------------------------------------------
    # Scopes are flags rather than a positional list because the *answer* has to
    # say which record it came from, and a caller who asked only about the board
    # must not be handed a log message that matched. `--tasks` is the name of the
    # store the reader knows (`aim task list`), `--rooms` the name of the verb
    # they came from, `--log` the name `cmd_status` and `cmd_inbox` print.
    p = add("search", cmd_search,
            help="one query over the channel log, the board and the rooms, answered "
                 "in chain order")
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--log", action="store_true",
                   help="search message bodies in the channel's public log")
    p.add_argument("--tasks", action="store_true",
                   help="search work item titles and acceptance text")
    p.add_argument("--rooms", action="store_true",
                   help="search message bodies in the channel's rooms, under the room gate")
    # Last, so a query that begins with `-` is still the query: `aim search --as x
    # --channel y --log ""` is refused for an empty query rather than being
    # reported as an unrecognised flag, which is the shape every refusal here has.
    p.add_argument("query", nargs="?", default="")

    # No git verb is registered here, and T-0238 is why one must not be added
    # casually. The hazard is measured, not hypothetical: two live sessions share
    # one `.git/index`, so a session that stages stages whatever its peer left in
    # the tree, and the commit that follows carries a card's file under a message
    # that never mentions it (`1edf47c` carried a peer's spec; `944ce90` carried
    # an `unmet_dependency` rewrite). A verb added here that commits has to hold
    # one exclusive lock across the whole stage-then-commit pair --
    # `Lock(ROOT / ".git" / "aim-commit.lock")`, the same flock every writer in
    # this file takes -- and stage the paths it was named rather than the tree;
    # a lock around `commit` alone leaves open the window that produced both
    # commits above. Nothing here commits today, so there is nothing to fix yet.
    p = add("tension", cmd_tension)
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--participants", default="", help="exactly two agent ids; default = channel participants")
    p.add_argument("--json", action="store_true")

    p = add("status", cmd_status)
    p.add_argument("--channel", required=True)

    p = add("verify", cmd_verify)
    p.add_argument("--channel", required=True)

    # The verb that gives the friction log a writer, and thereby finishes the
    # sentence M6 opens with: a diary nobody can write to is a diary that will
    # be empty, and an empty friction log is design/06 §4's definition of a
    # project nobody is dogfooding. `--as --channel` sit on the root verb, not
    # on `--add`, because the read (`aim friction` alone) needs the same
    # identity the write does and a reader who cannot say who they are cannot
    # be distinguished from a writer.
    p = add("friction", cmd_friction, help="write or read the friction log: the record of the fabric getting in the way")
    p.add_argument("--as", dest="actor", required=True)
    p.add_argument("--channel", required=True)
    p.add_argument("--add", action="store_true", help="append a friction record (default is to read)")
    p.add_argument("--command", default="", help="the command that was in the way (with --add)")
    p.add_argument("--happened", default="", help="what the wall did (with --add)")
    p.add_argument("--cost", default="", help="what it cost to get around (with --add)")
    p.add_argument("--touched-record", dest="touched_record", action="store_true",
                   help="the workaround wrote the fabric's own record by hand (with --add)")
    p.add_argument("--json", action="store_true")

    # Its own verb rather than a flag on `verify`. `verify` validates *a
    # channel's record* — chains, seals, tamper — and this validates *the
    # checkout*, which is a different subject with a different failure and a
    # different reader. Folding them together would mean a channel-scoped command
    # that can fail because a module elsewhere does not import.
    #
    # The flags are declared rather than passed through with `nargs="*"`: with
    # `nargs="*"` argparse reads `--quiet` as an option of *this* parser and
    # exits 2 with "unrecognized arguments" before the forward ever happens —
    # measured, and a diagnostic whose own interface drops the flag it exists to
    # forward is the same class of bug as the one it is looking for.
    p = add("doctor", cmd_doctor, help="can this checkout be run at all? (a forward to bin/aim-doctor)")
    p.add_argument("--quiet", action="store_true", help="print nothing; the exit code is the answer")
    p.add_argument("--root", default=None, help="the checkout to check (default: this one)")

    args = ap.parse_args()
    # Every refusal `die()` records needs to know which channel was being acted
    # on. Set it once here rather than at ~40 call sites; `resolve_actor` fills in
    # the actor when one was given.
    action = args.cmd
    if args.cmd == "task":
        action = f"task {getattr(args, 'task_cmd', '?')}"
        # `task doorbell create` is one verb to a user and two to the ledger, and
        # the ledger is what a reader audits. `task doorbell` alone would make
        # four different actions — create, list, rotate, delete — indistinguishable
        # in the one field `_BARRIER_ERRORS` keys on, and rotate is the verb that
        # moves a secret.
        if getattr(args, "task_cmd", "") == "doorbell":
            action = f"task doorbell {getattr(args, 'doorbell_cmd', '?')}"
    elif args.cmd == "channel":
        action = f"channel {getattr(args, 'channel_cmd', '?')}"
    elif args.cmd == "room":
        # Same reason as `task doorbell`: five verbs a user names separately
        # (`room new/say/publish/list/meta`) would collapse to one `action` in the
        # ledger, and `action` is the field a barrier audit groups by -- so
        # `room publish`, the deliberate breach, would be indistinguishable from
        # `room list`.
        action = f"room {getattr(args, 'room_cmd', '?')}"
    note_context(channel=getattr(args, "channel", None), action=action)
    try:
        code = args.func(args)
    except MalformedLog as exc:
        # A display path met a record it cannot parse. Say which file and which
        # line, and exit non-zero — never a bare traceback, and never silently.
        die(f"REFUSED: {exc.path} line {exc.lineno} is not valid JSON ({exc.detail}).\n"
            f"Run `aim verify --channel {getattr(args, 'channel', '<ch>')}` to see "
            f"whether the chain is intact; a truncated line usually means a writer "
            f"was interrupted mid-append.", cls="form")
    # Every other verb returns None and the exit code is 0, which is what it has
    # always been. `doctor` is the one verb whose whole output *is* the verdict it
    # forwards, so a command that says "this checkout cannot be run" and then
    # exits 0 has reported nothing a script can act on. Only a non-zero int is
    # propagated, so no existing verb's exit code can move.
    if isinstance(code, int) and code:
        sys.exit(code)


if __name__ == "__main__":
    main()
