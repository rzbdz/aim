def cmd_push(args):
    """Drop a message in a peer's outbox. Transport-agnostic delivery.

    This is deliberately *not* the channel. The channel is the record; the
    outbox is the doorbell. A doorbell can be rung by any means available
    (shared file, another agent's hook, a human pasting it) without changing
    what was actually said and when.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel) if args.channel else None
    if args.channel and who not in m["participants"] and kind != "human":
        die(f"'{who}' is not a participant in {args.channel}")
    if args.to not in load_registry()["agents"]:
        die(f"'{args.to}' is not a registered agent")
    body = Path(args.body_file).read_text(encoding="utf-8") if args.body_file else (args.body or "")
    if not body.strip():
        die("need --body or --body-file")
    d = ROOT / "outbox" / args.to
    d.mkdir(parents=True, exist_ok=True)
    ts = now_iso()
    stem = f"{ts.replace(':', '').replace('-', '')}-{who}"
    rec = {
        "ts": ts, "from": who, "to": args.to, "channel": args.channel or "",
        "subject": args.subject or "", "body": body, "delivered_via": args.via or "",
    }
    write_json(d / f"{stem}.json", rec)
    (d / f"{stem}.md").write_text(
        f"# message from {who} -> {args.to}\n"
        f"channel: {args.channel or '(none)'}\nsent: {ts}\nsubject: {args.subject or ''}\n\n"
        f"{body}\n\n---\n"
        f"Reply through the channel, not through this file:\n"
        f"  aim inbox --as {args.to} --channel {args.channel or '<channel>'}\n"
        f"  aim say   --as {args.to} --channel {args.channel or '<channel>'} ...\n",
        encoding="utf-8")
    print(f"outbox: {d}/{stem}.md  ({len(body)} chars)")


def cmd_pull(args):
    """Read everything in your outbox, newest last, and mark it claimed."""
    who, kind = resolve_actor(args)
    d = ROOT / "outbox" / who
    items = sorted(d.glob("*.json")) if d.exists() else []
    if not items:
        print(f"aim: outbox empty for '{who}'")
        return
    unread = []
    for p in items:
        rec = read_json(p)
        if not rec.get("claimed_at"):
            unread.append((p, rec))
    if args.unread_only and not unread:
        print(f"aim: nothing unread for '{who}' ({len(items)} claimed)")
        return
    show = unread if args.unread_only else [(p, read_json(p)) for p in items]
    for p, rec in show:
        print(f"=== from {rec['from']} @ {rec['ts']}  channel={rec['channel'] or '-'}")
        if rec.get("subject"):
            print(f"    subject: {rec['subject']}")
        print("    " + rec["body"].replace("\n", "\n    "))
        print()
        if args.claim and not rec.get("claimed_at"):
            rec["claimed_at"] = now_iso()
            write_json(p, rec)
    if args.claim and unread:
        print(f"claimed {len(unread)} message(s)")


