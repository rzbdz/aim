def _tokens(text):
    stop = {
        "the", "a", "an", "and", "or", "of", "to", "in", "is", "it", "that", "this",
        "for", "on", "as", "at", "be", "by", "with", "from", "are", "was", "were",
        "not", "but", "if", "then", "than", "so", "we", "you", "i", "they", "it's",
        "can", "cannot", "will", "would", "could", "should", "do", "does", "did",
        "have", "has", "had", "what", "which", "who", "when", "where", "how", "why",
        "one", "two", "there", "their", "its", "my", "our", "your", "about", "into",
        "more", "most", "less", "least", "only", "also", "just", "some", "any",
        "all", "no", "yes", "up", "out", "over", "under", "again", "very", "own",
        "same", "other", "such", "nor", "too", "each", "both", "few", "many", "much",
    }
    return [w for w in re.findall(r"[a-z][a-z'\-]+", text.lower()) if w not in stop and len(w) > 2]


def _tfidf_cosine(texts):
    """Cosine similarity of tf-idf vectors. Pure python, no deps."""
    import math
    from collections import Counter
    docs = [Counter(_tokens(t)) for t in texts]
    df = Counter()
    for d in docs:
        for w in d:
            df[w] += 1
    n = len(docs)
    vecs = []
    for d in docs:
        vec = {w: c * math.log((1 + n) / (1 + df[w])) for w, c in d.items()}
        norm = math.sqrt(sum(v * v for v in vec.values())) or 1.0
        vecs.append({w: v / norm for w, v in vec.items()})
    return vecs


def _cos(a, b):
    return sum(v * b.get(w, 0.0) for w, v in a.items())


def _containment(a, b, n=8):
    """What fraction of a's n-grams also appear in b."""
    sa = _shingles(a, n)
    if not sa:
        return 0.0
    return len(sa & _shingles(b, n)) / len(sa)


def _kill_overlap(kill_if, claim_text):
    """Heuristic: how much of a kill_if condition is addressed by a claim.

    This is lexical and it is weak. It cannot tell whether the claim actually
    satisfies the condition — only whether the claim is even *about* the same
    things. Weak signals reported as weak signals.
    """
    kt = set(_tokens(kill_if))
    if not kt:
        return 0.0
    return len(kt & set(_tokens(claim_text))) / len(kt)


def cmd_tension(args):
    """Measure how far apart two sealed positions actually are.

    Computed from the sealed material before anyone reads anyone. Visible to the
    leader and the synthesizer only — a participant seeing this report before
    CROSS_EXAMINE would be reading the other side through a summary, which is
    the thing the barrier exists to prevent.
    """
    who, kind = resolve_actor(args)
    m = load_manifest(args.channel)
    if who not in (m["leader"], m.get("synthesizer")) and kind != "human":
        die(
            f"REFUSED: the tension report is visible to the leader ('{m['leader']}') and "
            f"the synthesizer only.\nIt is a summary of the other side's reasoning. "
            f"Reading it before CROSS_EXAMINE is exposure by another name."
        )
    parts = list(args.participants.split(",")) if args.participants else m["participants"]
    if len(parts) != 2:
        die("tension compares exactly two participants; pass --participants a,b")
    seals = {}
    for p in parts:
        s = read_json(channel_dir(args.channel) / "seals" / f"{p}.json")
        if s is None:
            die(f"REFUSED: '{p}' has not sealed. There is nothing to compare yet.")
        seals[p] = s
    a, b = parts
    la = "\n".join(r["body"] for r in read_jsonl(channel_dir(args.channel) / "private" / f"{a}.jsonl"))
    lb = "\n".join(r["body"] for r in read_jsonl(channel_dir(args.channel) / "private" / f"{b}.jsonl"))
    ta = la + "\n" + seals[a]["summary"]
    tb = lb + "\n" + seals[b]["summary"]

    va, vb = _tfidf_cosine([ta, tb])
    rep = {
        "channel": args.channel,
        "topic": m["topic"],
        "compared": [a, b],
        "lexical_similarity": round(_cos(va, vb), 3),
        "verbatim_containment": {
            f"{a}->{b}": round(_containment(ta, tb), 3),
            f"{b}->{a}": round(_containment(tb, ta), 3),
        },
        "claim_analysis": [],
        "caveat": (
            "Lexical only. It can see shared words and shared sentences. It cannot "
            "see shared framing expressed in different words, which is the failure "
            "mode that matters. A high score is weak evidence of independence; a "
            "low score is strong evidence of contact."
        ),
    }

    ca, cb = seals[a].get("claims", []), seals[b].get("claims", [])

    def score_against(claim, others):
        """Score one claim against another set, symmetrically.

        Both directions get the same two measurements. An asymmetric loop here
        would make whichever agent is listed first the reference frame inside
        the very tool built to stop the first speaker setting the frame.
        (Found by claude-session2 reading this file while unsealed — claim C6.)
        """
        best_dup = max(((_kill_overlap(claim["claim"], o["claim"]), o["id"]) for o in others),
                       default=(0.0, ""))
        best_kill = max(((_kill_overlap(claim.get("kill_if", ""), o["claim"]), o["id"]) for o in others),
                        default=(0.0, ""))
        return best_dup, best_kill

    for side, others in ((a, cb), (b, ca)):
        for c in (ca if side == a else cb):
            best_dup, best_kill = score_against(c, others)
            rep["claim_analysis"].append({
                "agent": side, "id": c["id"], "claim": c["claim"][:80],
                "closest_counterpart": best_dup[1], "counterpart_overlap": round(best_dup[0], 2),
                "kill_if_addressed_by": best_kill[1], "kill_if_addressed": round(best_kill[0], 2),
                "confidence": c.get("confidence"),
            })

    # Headline: how much of each side's sealed position is even about the same
    # things as the other's. Very high coverage + low lexical distance = the two
    # agents answered the same question the same way, which is the outcome the
    # barrier was supposed to make less likely, not more.
    overlaps = [r["counterpart_overlap"] for r in rep["claim_analysis"]]
    rep["mean_claim_overlap"] = round(sum(overlaps) / len(overlaps), 2) if overlaps else 0.0
    sim = rep["lexical_similarity"]
    rep["reading"] = (
        "positions look genuinely different" if sim < 0.25 else
        "positions share substantial vocabulary — check whether they are answering the same question"
        if sim < 0.5 else
        "positions are lexically close; independent convergence or one position elaborated from the other"
    )

    if args.json:
        print(json.dumps(rep, indent=2, ensure_ascii=False))
        return
    print(f"tension report  {args.channel}   ({a} vs {b})")
    print(f"  lexical similarity     {sim}   (0 = no shared vocabulary, 1 = identical)")
    for k, v in rep["verbatim_containment"].items():
        print(f"  8-gram containment     {k}: {v}")
    print(f"  mean claim overlap     {rep['mean_claim_overlap']}")
    print()
    print("  claims:")
    for r in rep["claim_analysis"]:
        kill = f"  kill_if addressed {r['kill_if_addressed']:.0%} by {r['kill_if_addressed_by']}" \
            if r.get("kill_if_addressed_by") else ""
        print(f"    {r['agent'][:12]:<12} {r['id']:<4} overlap {r['counterpart_overlap']:.0%} "
              f"with {r['closest_counterpart'] or '-':<4} {r['claim'][:52]}{kill}")
    print()
    print(f"  reading: {rep['reading']}")
    print(f"  caveat:  {rep['caveat']}")


